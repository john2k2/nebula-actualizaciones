'use strict';
/**
 * UI del clon (ActivityIntro/ActivityMain/ActivityVideo/ActivitySeries/ActivityDescargas/
 * SettingsActivity2 del original). Router por hash + vistas.
 * Eliminado del original: anuncios intersticiales/nativos, puntos y recompensas,
 * diálogos de consentimiento de ads, login/sincronización, bloqueo de app.
 */
const App = (() => {
  const content = () => document.getElementById('content');
  const $ = (sel, el = document) => el.querySelector(sel);
  const $$ = (sel, el = document) => Array.from(el.querySelectorAll(sel));
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const tvInterface=()=>(Platform.isAndroid||Platform.isTizen)&&document.body?.classList.contains('platform-tv');
  // Escritorio (Windows/macOS): ni la interfaz del celular/tableta ni la de TV.
  const desktopShell=()=>!document.body?.classList?.contains?.('platform-android')&&!document.body?.classList?.contains?.('platform-tv');

  let currentView = 'home';
  let currentRoute = null;
  const navigation = NebulaCore.createNavigation();

  /* El catálogo de la fuente no incluye puntaje: se guarda el de TMDB cuando coincide,
     para que "ordenar por puntaje" acabe teniendo datos. */
  const ratingCache = (() => {
    const raw = Store.settings.ratingCache;
    return raw && typeof raw === 'object' ? { ...raw } : {};
  })();
  let ratingTimer = null;
  let ratingLastFlush = 0;
  function flushRatings() {
    clearTimeout(ratingTimer);
    ratingTimer = null;
    ratingLastFlush = Date.now();
    const keys = Object.keys(ratingCache);
    if (keys.length > 12000) for (const stale of keys.slice(0, keys.length - 12000)) delete ratingCache[stale];
    Store.setSetting('ratingCache', ratingCache);
  }
  function rememberRating(type, id, value) {
    const score = NebulaUI.ratingValue(value);
    if (score === null) return;
    const key = type + ':' + id;
    if (ratingCache[key] === score) return;
    ratingCache[key] = score;
    if (!ratingLastFlush) ratingLastFlush = Date.now();
    if (!ratingTimer) ratingTimer = setTimeout(flushRatings, 5000);
    if (Date.now() - ratingLastFlush > 20000) flushRatings();
  }

  function applyRatings(items) {
    for (const item of items || []) {
      if (!item || NebulaUI.ratingValue(item.rating) !== null) continue;
      const cached = ratingCache[item.type + ':' + item.id];
      if (cached) item.rating = cached;
    }
    return items;
  }
  function captureRoute(){const active=document.activeElement;if(currentRoute)currentRoute.rowScrolls=$$('.row-scroll,.resume-row',content()).map(el=>el.scrollLeft);navigation.capture(content().scrollTop,active?.id?'id:'+active.id:active?.dataset?.navKey?'card:'+active.dataset.navKey:'');}
  function back() { captureRoute();const previous = navigation.back(); if (previous) { viewMotion.back = true; activateRoute(previous); } }
  /* Canvas «Animaciones · Navegación» (celular): la vista nueva entra (view-in-section | open | swap) mientras la anterior
     queda encima, en su sitio, y se va (view-leaving). phone.css lo activa con --view-motion:1; en otras pantallas no hace nada. */
  const viewMotion = { kind: '', back: false, from: 0, seen: 0 };
  // Duraciones de phone.css (entrada y salida de cada tipo); con movimiento reducido todo es un fundido de 120 ms.
  // Volver no anima la lista, pero mientras la ficha se va la lista que llega después del esqueleto ocupa su lugar sin fundido.
  const VIEW_ENTER_MS = { section: 160, open: 320, swap: 200, back: 160 };
  const VIEW_LEAVE_MS = { section: 120, open: 120, swap: 200, back: 160 };
  function watchViewMotion() {
    const host = content();
    if (!host || typeof MutationObserver === 'undefined') return;
    host.addEventListener('scroll', () => { viewMotion.seen = host.scrollTop; }, { passive: true });
    const place = (node) => { node.scrollTop = Number(node.dataset.leaveScroll) || 0; };
    // El tiempo de cada animación corre desde el primer cuadro pintado: en un teléfono lento la vista puede tardar en aparecer.
    const stamp = (node, key) => { node.dataset[key] = ''; requestAnimationFrame(() => { if (node.dataset[key] === '') node.dataset[key] = String(performance.now()); }); };
    const elapsed = (node, key, now) => (node.dataset[key] ? now - Number(node.dataset[key]) : 0);
    new MutationObserver((records) => {
      const now = performance.now();
      let removed = null, added = null;
      const strays = [];
      records.forEach((record) => {
        record.removedNodes.forEach((node) => {
          if (node.nodeType !== 1 || !node.classList.contains('view')) return;
          if (node.classList.contains('view-leaving')) { if (!node.isConnected) strays.push(node); return; }
          if (!removed) removed = node;
        });
        record.addedNodes.forEach((node) => { if (node.nodeType === 1 && node.classList.contains('view') && !node.classList.contains('view-leaving') && node.parentNode === host) added = node; });
      });
      // Una vista que seguía yéndose cuando la pantalla se volvió a dibujar vuelve encima, donde iba su fundido.
      strays.forEach((node) => {
        const gone = elapsed(node, 'leaveAt', now);
        if (node.dataset.dropped || Number(node.dataset.leaveMs) - gone < 20) return;
        node.style.setProperty('--motion-delay', -gone + 'ms');
        host.appendChild(node); place(node);
      });
      if (!added) return;
      const routed = Boolean(viewMotion.kind);
      const kind = viewMotion.kind || 'swap';
      // Lo de antes de navegar vale solo si aún no se pintó ningún cuadro: si la pantalla tardó, se ve lo que hay ahora.
      const fresh = routed && viewMotion.box;
      const from = fresh ? viewMotion.from : viewMotion.seen;
      const box = fresh || { rect: host.getBoundingClientRect(), width: host.clientWidth, height: host.clientHeight };
      viewMotion.kind = ''; viewMotion.box = null;
      if (!viewMotionOn()) return;
      const reduced = window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches;
      // La vista anterior aún estaba entrando (p. ej. «Cargando» o el esqueleto de unos milisegundos): la nueva sigue su
      // entrada donde iba y nada se va.
      const previousKind = removed?.dataset?.motionKind;
      const previousTime = previousKind ? elapsed(removed, 'motionAt', now) : 0;
      if (!routed && removed && !removed.isConnected && previousKind && previousTime < (reduced ? 120 : VIEW_ENTER_MS[previousKind] || 0)) {
        added.classList.add('view-in-' + previousKind);
        added.dataset.motionKind = previousKind;
        if (removed.dataset.motionAt) added.dataset.motionAt = removed.dataset.motionAt; else stamp(added, 'motionAt');
        added.style.setProperty('--motion-delay', -previousTime + 'ms');
        return;
      }
      added.classList.add('view-in-' + kind);
      added.dataset.motionKind = kind; stamp(added, 'motionAt');
      if (!removed || removed.isConnected) return;
      // Sin sus clases de entrada: al volver a insertarla, sus hijos no deben repetir la animación.
      removed.classList.remove('view-in-section', 'view-in-open', 'view-in-swap', 'view-in-back');
      removed.classList.add('view-leaving', 'view-out-' + kind);
      removed.setAttribute('aria-hidden', 'true');
      removed.style.removeProperty('--motion-delay');
      removed.style.top = box.rect.top + 'px';
      removed.style.left = box.rect.left + 'px';
      removed.style.width = box.width + 'px';
      removed.style.height = box.height + 'px';
      removed.dataset.leaveMs = String(reduced ? 120 : VIEW_LEAVE_MS[kind]);
      stamp(removed, 'leaveAt');
      removed.dataset.leaveScroll = String(Math.max(0, from - (parseFloat(getComputedStyle(host).paddingTop) || 0)));
      host.appendChild(removed); place(removed);
      const drop = () => { removed.dataset.dropped = '1'; if (removed.parentNode) removed.remove(); };
      removed.addEventListener('animationend', (event) => { if (event.target === removed) drop(); });
      setTimeout(drop, 600);
    }).observe(host, { childList: true });
  }
  /* La marca roja de la barra inferior se desliza a la sección activa; si no había ninguna, aparece en su sitio. */
  function syncPhoneNavIndicator() {
    const nav = $('#phoneBottomNav');
    if (!nav || typeof nav.getBoundingClientRect !== 'function' || !viewMotionOn()) return;
    let mark = nav.querySelector('.nav-indicator');
    if (!mark) { mark = document.createElement('span'); mark.className = 'nav-indicator'; mark.setAttribute('aria-hidden', 'true'); nav.appendChild(mark); nav.classList.add('has-indicator'); }
    const bar = nav.querySelector('button.active .nav-bar');
    if (!bar || !bar.offsetWidth) { mark.classList.remove('shown'); return; }
    const frame = nav.getBoundingClientRect(), spot = bar.getBoundingClientRect();
    const transform = `translate(${Math.round(spot.left - frame.left)}px,${Math.round(spot.top - frame.top)}px)`;
    const shown = mark.classList.contains('shown');
    if (shown && mark.style.transform === transform) return;
    if (!shown) mark.classList.add('no-motion');
    mark.style.transform = transform;
    mark.classList.remove('moved'); void mark.offsetWidth; mark.classList.add('moved');
    if (!shown) mark.classList.remove('no-motion');
    mark.classList.add('shown');
  }
  let toastTimer = null;
  let homeFilter = 'all';
  let genreRequest = 0;
  let homeRequest=0,searchRequest=0,downloadsRequest=0;
  let modalReturnFocus=null;
  function applyTextScale(){const scale=Number(Store.settings.textScale)||1;document.documentElement.style.fontSize=(14*([1,1.25,1.5].includes(scale)?scale:1)*(Platform.isAndroid?Math.max(1,Math.min(2,Platform.systemFontScale||1)):1))+'px';}
  const matchesHome = item => homeFilter === 'all' || item.type === homeFilter;
  const icon = name => `<svg class="icon" aria-hidden="true"><use href="#i-${name}"/></svg>`;
  // Empty and error states from the canvas: 48 px line icon, title, detail and up to two actions.
  const STATE_ICONS={
    cloud:'<path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/><path d="M12 9v4"/><path d="M12 16h.01"/>',
    filter:'<path d="M13 3H2l8 9.46V19l4 2v-8.54l.9-1.06"/><path d="M22 3l-5 5"/><path d="M17 3l5 5"/>',
    heart:'<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7z"/>',
    search:'<circle cx="11" cy="11" r="8"/><path d="M21 21l-4.3-4.3"/><path d="M13.5 8.5l-5 5"/><path d="M8.5 8.5l5 5"/>',
    download:'<path d="M12 3v12"/><path d="M7 10l5 5 5-5"/><path d="M5 21h14"/>',
    // Biblioteca vacía en el celular (Continuar, Vistos, Alertas): el mismo patrón que «Aún no tienes favoritos».
    play:'<path d="M7 4.5v15l12-7.5z"/>',
    check:'<path d="M5 12.5l5 5L19.5 7"/>',
    bell:'<path d="M6 9a6 6 0 0 1 12 0c0 6 2.5 7 2.5 7h-17S6 15 6 9z"/><path d="M10 20a2 2 0 0 0 4 0"/>'
  };
  function stateMessage({art,title,detail='',actions=[],role='status',hint=''}){
    const picture=STATE_ICONS[art]?`<svg class="state-icon" viewBox="0 0 24 24" aria-hidden="true">${STATE_ICONS[art]}</svg>`:'';
    const buttons=actions.length?`<div class="state-actions">${actions.map(action=>`<button type="button" class="btn${action.primary?' primary':''}" id="${action.id}">${action.icon?icon(action.icon):''}${esc(action.label)}</button>`).join('')}</div>`:'';
    return `<div class="empty-state state-message" role="${role}">${picture}<strong class="state-title"${hint?` title="${esc(hint)}"`:''}>${esc(title)}</strong>${detail?`<p class="state-detail">${esc(detail)}</p>`:''}${buttons}</div>`;
  }

  const publicMessage=value=>String(value??'').replace(/\bmovieplus\b/gi,'catálogo').replace(/\bxuper\b/gi,'fuente adicional');
  function toast(msg) {
    msg=publicMessage(msg);
    const t = $('#toast');
    t.classList.remove('toast-rich');
    t.textContent = msg;
    t.classList.remove('hidden');
    clearTimeout(toastTimer);
    loaderOpen = false;
    toastTimer = setTimeout(() => t.classList.add('hidden'), 2600);
  }

  // Con `detail` el aviso va en dos líneas (título y detalle) con la marca, como los avisos de episodios nuevos.
  function toastAction(message,label,action,detail=''){
    const t=$('#toast');
    t.textContent='';
    t.classList.toggle('toast-rich',Boolean(detail));
    if(detail){
      const svgNs='http://www.w3.org/2000/svg',mark=document.createElementNS(svgNs,'svg'),use=document.createElementNS(svgNs,'use');
      mark.setAttribute('class','toast-mark');mark.setAttribute('viewBox','0 0 512 512');mark.setAttribute('aria-hidden','true');
      use.setAttribute('href','#nebula-mark');mark.appendChild(use);
      const text=document.createElement('span'),title=document.createElement('strong'),line=document.createElement('span');
      text.className='toast-text';title.className='toast-title';line.className='toast-detail';
      title.textContent=publicMessage(message);line.textContent=publicMessage(detail);
      text.append(title,line);t.append(mark,text);
    }else t.textContent=publicMessage(message)+' ';
    const button=document.createElement('button');
    button.type='button';button.className='toast-action';button.textContent=label;
    button.addEventListener('click',()=>{action();t.classList.add('hidden');});
    t.appendChild(button);
    t.classList.remove('hidden');
    clearTimeout(toastTimer);
    toastTimer=setTimeout(()=>t.classList.add('hidden'),6000);
  }

  let loaderOpen = false;
  function showLoader(message) {
    const t = $('#toast');
    t.classList.remove('toast-rich');
    t.textContent=publicMessage(message);
    t.classList.remove('hidden');
    clearTimeout(toastTimer);
    loaderOpen = true;
  }
  function hideLoader() {
    if (!loaderOpen) return;
    loaderOpen = false;
    $('#toast').classList.add('hidden');
  }

  /* Capa de lanzamiento: aparece al tocar Reproducir/Continuar mientras se buscan las fuentes y se retira
     cuando el reproductor toma la pantalla (o la actividad nativa vuelve), al fallar o al cancelar. */
  let launchState = null, launchSerial = 0;
  const setHidden = (node, hidden) => node?.classList?.[hidden ? 'add' : 'remove']?.('hidden');
  const launchTitleText = value => String(value || '').replace(/\s*—\s*T\d+·E\d+.*$/, '').trim();
  const cssImage = url => /^(?:https?:|file:)/i.test(String(url || '')) ? `url("${String(url).replace(/["\\\r\n]/g, '')}")` : '';
  function showLaunch({ title = '', art = '', season = 0, episode = 0, text = 'Preparando reproducción…', onCancel = null } = {}) {
    const layer = $('#launchLayer');
    if (!layer) return null;
    const token = ++launchSerial;
    const returnFocus = launchState ? launchState.returnFocus : document.activeElement;
    launchState = { token, onCancel: typeof onCancel === 'function' ? onCancel : null, returnFocus };
    const titleNode = $('#launchTitle');
    if (titleNode) titleNode.textContent = launchTitleText(title) || 'Nébula';
    const meta = $('#launchMeta'), line = Number(season) > 0 && Number(episode) > 0 ? `Temporada ${Number(season)} · Episodio ${Number(episode)}` : '';
    if (meta) { meta.textContent = line; setHidden(meta, !line); }
    const label = $('#launchText');
    if (label) label.textContent = text;
    const artNode = $('#launchArt');
    if (artNode?.style) artNode.style.backgroundImage = cssImage(art);
    const cancel = $('#launchCancel');
    if (cancel) { setHidden(cancel, !launchState.onCancel); cancel.onclick = () => cancelLaunch(); }
    setHidden(layer, false);
    if (launchState.onCancel) cancel?.focus?.({ preventScroll: true });
    return token;
  }
  /** Retira la capa. Con `token`, solo si sigue siendo la misma presentación (otra pudo reemplazarla). */
  function hideLaunch(token) {
    if (!launchState || (token !== undefined && token !== null && token !== launchState.token)) return false;
    const { returnFocus } = launchState;
    launchState = null;
    const layer = $('#launchLayer');
    const hadFocus = Boolean(layer?.contains?.(document.activeElement));
    setHidden(layer, true);
    if (hadFocus && returnFocus?.isConnected) returnFocus.focus?.({ preventScroll: true });
    return true;
  }
  /** Escape o Atrás: cancela el lanzamiento pendiente. Devuelve true si había una capa visible. */
  function cancelLaunch() {
    if (!launchState) return false;
    const cancel = launchState.onCancel;
    hideLaunch();
    try { cancel?.(); } catch {}
    return true;
  }
  /** Marca el botón que inició una tarea (aria-busy) hasta que termina, también si falla. */
  function busyWhile(element, work) {
    element?.setAttribute?.('aria-busy', 'true');
    return Promise.resolve(work).catch(() => {}).finally(() => element?.removeAttribute?.('aria-busy'));
  }
  function launchInfo(type, id, season, episode) {
    let saved = null, meta = null;
    try { saved = Store.getResume(type, id, season, episode); } catch {}
    try { meta = API.findCatalogItem(type, id); } catch {}
    return { title: saved?.title || meta?.title || '', art: meta?.backdrop || meta?.poster || saved?.poster || '', season, episode };
  }

  /* Salud de fuentes: sondeo con reintento y caché de 10 minutos. */
  const healthCache = new Map();
  async function probeSource(key) {
    try {
      const result = await Platform.nativeProbe(key);
      if (result && result.ok) return 'ok';
      const message = String((result && result.error) || '');
      return !/\b429\b|rate_limit/i.test(message) && /HTTP[\s]*[45]\d\d|no(?:\s+est[aá])?\s+disponible|playback_provider_unavailable|rechaz|inv[aá]lid/i.test(message) ? 'dead' : 'unknown';
    } catch {
      return 'unknown';
    }
  }
  async function checkSource(url) {
    const key = String(url);
    const hit = healthCache.get(key);
    if (hit && Date.now() - hit.at < 10 * 60 * 1000) return hit.state;
    let state = 'unknown';
    const direct = typeof window !== 'undefined' && window.Platform;
    if (direct && typeof direct.nativeCheck === 'function') {
      try {
        const fast = await direct.nativeCheck(key);
        if (fast && typeof fast.alive === 'boolean') state = fast.alive ? 'ok' : 'dead';
      } catch {}
    }
    if (state === 'unknown') state = await probeSource(key);
    if (state === 'dead' && !(direct && typeof direct.nativeProbe === 'function')) {
      await new Promise((done) => setTimeout(done, 1200));
      state = await probeSource(key);
    }
    if (state !== 'unknown') healthCache.set(key, { state, at: Date.now() });
    return state;
  }

  async function ensurePlaybackAccess(payload) {
    if (typeof NebulaAccount === 'undefined' || payload?.type === 'local') return true;
    return NebulaAccount.ensureAccess();
  }

  /* Arranca con la primera fuente que responde; las muertas se saltan. */
  async function playVerified(payload) {
    if (typeof NebulaAccount !== 'undefined' && payload?.type !== 'local' && !(await NebulaAccount.ensureAccess())) return;
    if(Platform.isAndroid)return Player.open(payload);
    const list = (payload.urls || []).filter((entry) => entry && entry.url);
    if (!list.length) return Player.open(payload);
    const selected=list.find(entry=>entry.url===payload.url)||list[0];
    const ordered=[selected,...list.filter(entry=>entry!==selected)];
    // The player already handles source failures. A slow probe must not delay Play.
    const candidates=ordered.filter(entry=>{const health=healthCache.get(String(entry.url));return !health||Date.now()-health.at>=600000||health.state!=='dead';});
    const ready=candidates.length?candidates:ordered;
    return Player.open({...payload,url:ready[0].url,urls:ready});
  }

  /* phone.css pone --view-motion:1 en las pantallas que animan como el canvas «Animaciones» (el celular). */
  function viewMotionOn() { try { return getComputedStyle(document.body).getPropertyValue('--view-motion').trim() === '1'; } catch { return false; } }
  /* Canvas «Animaciones · Avisos», fuente descartada: en el celular la fila colapsa en 200 ms (la única animación de altura)
     antes de quitarla; con movimiento reducido solo se funde. En las demás pantallas se quita al momento. */
  function collapseSourceCard(card, done) {
    const finish = () => { if (card.isConnected) { card.remove(); done(); } };
    if (!viewMotionOn() || typeof card.getBoundingClientRect !== 'function') return finish();
    const reduced = window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches;
    if (!reduced) { card.style.height = card.getBoundingClientRect().height + 'px'; void card.offsetHeight; }
    card.classList.add('collapsing');
    if (!reduced) { card.style.height = '0px'; card.style.marginTop = '0px'; card.style.marginBottom = '0px'; card.style.paddingTop = '0px'; card.style.paddingBottom = '0px'; card.style.minHeight = '0px'; card.style.borderWidth = '0px'; }
    setTimeout(finish, reduced ? 140 : 220);
  }
  // Heading of the sources block: «Fuentes disponibles · 6» and, while probing, «Verificando 2…».
  function sourceHeading(count,pending=0){return 'Fuentes disponibles · '+count+(pending?` <span class="q-pending">Verificando ${pending}…</span>`:'');}
  /* Verifica cada fuente y actualiza su tarjeta en vivo; las muertas desaparecen. */
  async function verifyQualityBox(list) {
    const box = $('#qualityBox');
    if (!box || !list.length) return;
    const heading = box.parentElement && box.parentElement.querySelector('.row-head h2');
    const note = document.createElement('p');
    note.className = 'source-notice hidden';
    note.setAttribute('role', 'status');
    box.after(note);
    let hidden = 0;
    let deadHighQuality = 0;
    let pending = list.length;
    const isUhd = (name) => typeof NebulaCore !== 'undefined' && NebulaCore.sourceHeight
      ? NebulaCore.sourceHeight({ name }) >= 2160
      : /\b(?:4k|uhd|2160p?)\b/i.test(String(name || ''));
    const refresh = () => {
      if (heading) heading.innerHTML = sourceHeading(list.length - hidden, pending);
      if (typeof syncSourceSummary === 'function') syncSourceSummary();
      if (hidden) {
        const hasVisible4k = [...box.querySelectorAll('.quality-item:not(.dead)')].some(node => isUhd(node.dataset.name));
        note.textContent = deadHighQuality > 0 && !hasVisible4k
          ? hidden + ' fuente(s) no disponibles quedaron ocultas (las opciones 4K no respondieron en el servidor).'
          : hidden + ' fuente(s) no disponibles quedaron ocultas.';
        note.classList.remove('hidden');
      }
    };
    [...box.querySelectorAll('.quality-item')].forEach((card) => {
      card.dataset.state = 'checking';
      const size = card.querySelector('.q-size');
      if (size && !card.dataset.size) size.textContent = 'Verificando…';
    });
    refresh();
    let index = 0;
    let confirmedOk = 0;
    const maxChecks = Math.min(4, list.length);
    const verifyRoute = typeof currentRoute !== 'undefined' ? currentRoute : null;
    const shouldStopVerify = () =>
      (typeof currentRoute !== 'undefined' && currentRoute !== verifyRoute) ||
      (typeof Player !== 'undefined' && typeof Player.isPlaying === 'function' && Player.isPlaying());
    const worker = async () => {
      while (index < maxChecks && (confirmedOk === 0 || index < 2) && !shouldStopVerify()) {
        const entry = list[index++];
        const state = await Promise.race([checkSource(entry.url), new Promise((done) => setTimeout(() => done('unknown'), 15000))]);
        if (shouldStopVerify()) break;
        const cards = [...box.querySelectorAll('.quality-item')];
        const card = cards.find((node) => node.dataset.url === String(entry.url || '')) || cards.find((node) => node.dataset.name === String(entry.name || ''));
        if (state === 'ok') confirmedOk++;
        if (state === 'ok' || state === 'dead') {
          const salud = { ...(Store.settings.providerHealth || {}) };
          const clave = entry.providerId || 'primary';
          const actual = salud[clave] || { ok: 0, dead: 0 };
          if (state === 'ok') actual.ok = (actual.ok || 0) + 1; else actual.dead = (actual.dead || 0) + 1;
          salud[clave] = actual;
          Store.setSetting('providerHealth', salud);
        }
        if (card && card.isConnected) {
          card.dataset.state = state;
          const size = card.querySelector('.q-size');
          if (state === 'dead') {
            if (isUhd(entry.name)) deadHighQuality++;
            if (size) size.textContent = 'No disponible';
            card.classList.add('dead');
            card.setAttribute('aria-disabled', 'true');
            if (!qualityUserPicked && (card.classList.contains('sel') || selectedQualityRef?.url === entry.url)) {
              const nextCard = box.querySelector('.quality-item:not(.dead)');
              if (nextCard) selectQualityCard(nextCard);
              else selectedQualityRef = null;
            }
            setTimeout(() => { if (card.isConnected) collapseSourceCard(card, () => { hidden++; refresh(); }); }, 1200);
          } else if (size) {
            size.textContent = state === 'ok' ? (entry.size || 'Disponible') : (entry.size ? entry.size + ' · sin confirmar' : 'Sin confirmar');
            card.classList.toggle('unconfirmed', state !== 'ok');
          }
        }
        pending = Math.max(0, pending - 1);
        refresh();
      }
    };
    await Promise.all(Array.from({ length: Math.min(1, list.length) }, worker));
    [...box.querySelectorAll('.quality-item[data-state="checking"]')].forEach((card) => {
      card.dataset.state = 'unknown';
      card.classList.add('unconfirmed');
      const size = card.querySelector('.q-size');
      if (size) size.textContent = card.dataset.size ? card.dataset.size + ' · sin confirmar' : 'Sin confirmar';
    });
    pending = 0;
    refresh();
  }

  function wireEpisodeCard(row) {
    const play = row.querySelector('button[data-play]');
    if (!play) return;
    row.classList.add('episode-playable');
    row.tabIndex = 0;
    row.setAttribute('role', 'group');
    row.setAttribute('aria-label', 'Reproducir ' + (row.querySelector('.ep-name')?.textContent || 'episodio'));
    row.addEventListener('click', event => { if (!event.target.closest('button, a, input, select')) play.click(); });
    row.addEventListener('keydown', event => { if (event.target === row && ['Enter', ' '].includes(event.key)) { event.preventDefault(); play.click(); } });
    // Phone (CelularFicha) and desktop (EscritorioFicha): the card is the still, the title and «T1 · E2»; Descargar,
    // Salto de intro and Visto live behind «⋯». The desktop always tags the still («Episodio 3», «6 % visto»).
    const list = document.body?.classList;
    const desktop = Boolean(list) && !list.contains('platform-android') && !list.contains('platform-tv');
    if (!desktop && (!list?.contains?.('platform-android') || tvInterface())) return;
    const number = row.dataset.e || row.dataset.ep || '';
    const still = row.querySelector('.ep-still');
    if (still && number && !still.querySelector('.ep-still-tag')) {
      const progress = still.querySelector('.ep-progress');
      const pct = progress ? parseInt(progress.style.width, 10) : 0;
      if (still.querySelector('.ph')) still.querySelector('.ph').innerHTML = `<span class="ep-still-num">${esc(number)}</span>`;
      if (desktop || pct || still.querySelector('img')) still.insertAdjacentHTML('beforeend', `<span class="ep-still-tag">${pct ? `${pct} % visto` : `Episodio ${esc(number)}`}</span>`);
    }
    const actions = row.querySelector('.ep-actions');
    if (!actions || !actions.querySelector('button:not([data-play]), select')) return;
    row.classList.add('has-ep-more');
    const more = document.createElement('button');
    more.type = 'button';
    more.className = 'ep-more';
    more.textContent = '⋯';
    more.setAttribute('aria-label', 'Opciones del episodio');
    more.setAttribute('aria-expanded', 'false');
    more.addEventListener('click', event => { event.stopPropagation(); const open = !row.classList.contains('ep-actions-open'); row.classList.toggle('ep-actions-open', open); more.setAttribute('aria-expanded', String(open)); });
    actions.before(more);
  }

  /* ============================ Router & Drawer ============================ */
  function closeDrawer() {
    document.body?.classList?.remove?.('drawer-open');
    $('#drawerBackdrop')?.classList?.add?.('hidden');
  }
  function toggleDrawer() {
    const open = !document.body?.classList?.contains?.('drawer-open');
    document.body?.classList?.toggle?.('drawer-open', open);
    $('#drawerBackdrop')?.classList?.toggle?.('hidden', !open);
  }
  function syncTopbarSearch(q = '') {
    const hasQuery = Boolean(q && String(q).trim().length);
    $('#tbSearchClear')?.classList?.toggle?.('hidden', !hasQuery);
    if (currentView === 'search') {
      $('#tbTitle').textContent = hasQuery ? String(q).trim() : '';
    }
  }
  function go(view, params = {}, remember = true) {
    closeDrawer();
    captureRoute();
    return activateRoute(navigation.open(view,params,remember));
  }
  const resumeGate=NebulaCore.createPlaybackLaunchGate();
  const BACK_SECTION_LABELS={home:'Inicio',browse:'Explorar',search:'Buscar',mylist:'Biblioteca',settings:'Ajustes',downloads:'Descargas'};
  let backSectionLabel='Inicio';
  function activateRoute(route){
    resumeGate.cancel();Player.cancelPending?.();visibleRatings.cancel();hideLaunch();if(document.querySelector?.('.ctx-menu'))closeContextMenu();
    const {view,params}=route;
    closeDrawer();
    if (!$('#playerLayer').classList.contains('hidden')) Player.close();
    currentRoute = route;
    const isDetailView = ['person','source','catalog','movie','tv','nebula','platform'].includes(view);
    $('#tbBack').disabled = !navigation.canBack;
    $('#titlebar').classList.toggle('has-mobile-back',navigation.canBack&&isDetailView);
    // Canvas «iOS · Ficha»: Volver lleva el nombre de la sección de la que se vino («‹ Inicio»); el resto dice «Volver».
    if(BACK_SECTION_LABELS[view])backSectionLabel=BACK_SECTION_LABELS[view];
    const backLabel=$('#tbBack .tb-back-label');if(backLabel)backLabel.textContent=isDetailView&&document.body?.classList?.contains?.('platform-ios')?backSectionLabel:'Volver';
    // Cómo entra la vista (canvas «Animaciones · Navegación»): volver, abrir una ficha, otra sección o la misma pantalla con otros datos.
    viewMotion.kind = viewMotion.back ? 'back' : isDetailView ? 'open' : view === currentView ? 'swap' : 'section';
    viewMotion.back = false;
    viewMotion.from = content().scrollTop;
    // Dónde estaba la vista anterior antes de que la cabecera de la nueva mueva #content (Inicio no deja hueco arriba).
    const leavingBox = viewMotionOn() ? { rect: content().getBoundingClientRect(), width: content().clientWidth, height: content().clientHeight } : null;
    viewMotion.box = leavingBox;
    if (leavingBox) requestAnimationFrame(() => { if (viewMotion.box === leavingBox) viewMotion.box = null; });
    content().scrollTop = 0;
    currentView = view;
    $$('[data-category-nav]').forEach(button=>{const selected=view==='browse'&&button.dataset.categoryNav===(params.category||'movies');button.classList.toggle('active',selected);if(selected)button.setAttribute('aria-current','page');else button.removeAttribute('aria-current');});
    $$('.nav-item').forEach((b) => {b.classList.toggle('active', b.dataset.view === view);if(b.dataset.view===view)b.setAttribute('aria-current','page');else b.removeAttribute('aria-current');});
    // La vista activa queda en <body> para que el diseño del celular adapte la cabecera (Inicio la superpone al destacado).
    if (document.body?.dataset) document.body.dataset.view = view;
    // Escritorio y tablet: con Anime elegido, «Catálogo» no se marca como activo en la barra lateral.
    // Ojo: no usar data-category en <body>; wireCategoryLinks() cablea todo [data-category] del documento.
    if (document.body?.dataset) { if (view === 'browse') document.body.dataset.browseCategory = String(params.category || 'movies'); else delete document.body.dataset.browseCategory; }
    $$('#phoneBottomNav [data-phone-nav]').forEach((b) => {
      const target = b.dataset.phoneNav;
      const active = target === 'browse'
        ? (view === 'browse' || view === 'platform')
        : target === 'mylist'
          ? (view === 'mylist' || view === 'downloads')
          : view === target;
      b.classList.toggle('active', active);
      if (active) b.setAttribute('aria-current', 'page');
      else b.removeAttribute('aria-current');
    });
    syncPhoneNavIndicator();
    const catLabels = { movies: 'Películas', series: 'Series', anime: 'Anime', cartoons: 'Cartoons', doramas: 'Doramas', duanju: 'Duanju', telenovelas: 'Telenovelas' };
    const mylistLabels = { favorites: 'Favoritos', continue: 'Continuar', history: 'Historial', watched: 'Vistos', alerts:'Alertas' };
    const platformName = ((typeof NebulaCore !== 'undefined' && NebulaCore.STREAMING_PLATFORMS) || []).find((p) => p.id === params.platformId)?.name;
    const titles = {
      home: 'Inicio',
      browse: catLabels[params.category || 'movies'] || 'Películas',
      search: params.q ? String(params.q).trim() : 'Buscar',
      person: params.name || 'Filmografía',
      platform: platformName || 'Plataforma',
      mylist: mylistLabels[params.tab || 'favorites'] || 'Favoritos',
      downloads: 'Descargas',
      settings: 'Ajustes',
      source: 'Detalle',
      catalog: 'Ficha',
      movie: 'Película',
      tv: 'Serie',
    };
    const navTitle = titles[view] || 'Nébula';
    const rootHeaderViews = new Set(['home', 'search', 'mylist', 'downloads', 'settings']);
    $('#tbTitle').textContent = rootHeaderViews.has(view) ? '' : navTitle;
    $('#tbSearchClear')?.classList?.toggle?.('hidden', !(view === 'search' && params.q));
    const rendering=(()=>{switch (view) {
      case 'home': return renderHome();
      case 'browse': return renderBrowse(params);
      case 'platform': return renderPlatform(params);
      case 'search': return renderSearch(params);
      case 'person': return renderPerson(params);
      case 'nebula': return renderDetail('movie', params.id);
      case 'mylist': return renderMyList(params);
      case 'downloads': return renderDownloads();
      case 'settings': return renderSettings();
      case 'movie': return renderDetail('movie', params.id);
      case 'tv': return renderDetail('tv', params.id);
      case 'catalog': return renderCatalogDetail(params.id, params.catalogUrl);
      case 'source': return renderSourceDetail(params.kind, params.id);
      default: return renderHome();
    }})();
    Promise.resolve(rendering).then(()=>{
      if(currentRoute!==route)return;
      content().scrollTop=route.scrollTop||0;
      if(Array.isArray(route.rowScrolls))$$('.row-scroll,.resume-row',content()).forEach((el,i)=>{if(route.rowScrolls[i])el.scrollLeft=route.rowScrolls[i];});
      const [kind,...parts]=(route.focusKey||'').split(':');const key=parts.join(':');
      const target=kind==='id'?document.getElementById(key):kind==='card'?$$('[data-nav-key]').find(node=>node.dataset.navKey===key):null;
      target?.focus({preventScroll:true});
    }).catch(error=>{if(currentRoute===route)content().innerHTML=NebulaUI.emptyMessage('No se pudo abrir esta pantalla',publicMessage(error.message));});
    return rendering;
  }

