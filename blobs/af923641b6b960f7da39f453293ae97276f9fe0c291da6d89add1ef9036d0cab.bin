    mubi: '<svg viewBox="0 0 24 23.935" aria-hidden="true"><g transform="translate(0 -0.033)"><path fill="currentColor" d="M3.357.033A3.357 3.357 0 0 0 0 3.39a3.357 3.357 0 0 0 3.357 3.357A3.357 3.357 0 0 0 6.713 3.39 3.357 3.357 0 0 0 3.357.033Zm8.643 0A3.357 3.357 0 0 0 8.645 3.39 3.357 3.357 0 0 0 12 6.746a3.357 3.357 0 0 0 3.357-3.357A3.357 3.357 0 0 0 12 .033Zm-8.643 8.61A3.357 3.357 0 0 0 0 12a3.357 3.357 0 0 0 3.357 3.355A3.357 3.357 0 0 0 6.713 12a3.357 3.357 0 0 0-3.356-3.357Zm8.643 0A3.357 3.357 0 0 0 8.645 12 3.357 3.357 0 0 0 12 15.355 3.357 3.357 0 0 0 15.357 12 3.357 3.357 0 0 0 12 8.643zm8.643 0A3.357 3.357 0 0 0 17.287 12a3.357 3.357 0 0 0 3.356 3.355A3.357 3.357 0 0 0 24 12a3.357 3.357 0 0 0-3.357-3.357Zm-17.286 8.61A3.357 3.357 0 0 0 0 20.612a3.357 3.357 0 0 0 3.357 3.356 3.357 3.357 0 0 0 3.356-3.356 3.357 3.357 0 0 0-3.356-3.357Zm8.643 0a3.357 3.357 0 0 0-3.355 3.358A3.357 3.357 0 0 0 12 23.967a3.357 3.357 0 0 0 3.357-3.356A3.357 3.357 0 0 0 12 17.254z"/></g></svg>',
  };

  function platformStripMarkup() {
    const platforms = (API.WATCH_PLATFORMS || NebulaCore.STREAMING_PLATFORMS || []);
    if (!platforms.length) return '';
    return `<section class="home-platforms"><div class="row-head"><h2>Explora por plataforma</h2></div><div class="platforms-row">${platforms.map((p) => `<button type="button" class="platform-card" data-platform-id="${esc(p.id)}" aria-label="${esc('Explorar ' + p.name)}" style="--brand-color:${esc(p.color)}"><span class="platform-logo">${PLATFORM_LOGOS[p.id] || esc(p.name)}</span></button>`).join('')}</div></section>`;
  }

  function syncProfileBadge() {
    const profiles = (typeof NebulaCore !== 'undefined' && NebulaCore.LOCAL_PROFILES) || [{ id: 'personal', name: 'Personal' }, { id: 'cine', name: 'Cine' }, { id: 'series', name: 'Series' }];
    const activeId = (typeof Store.localProfile === 'string' && Store.localProfile) || 'personal';
    const current = profiles.find((p) => p.id === activeId) || profiles[0];
    const nameEl = $('#phoneProfileName');
    const avatarEl = $('#phoneProfileAvatar');
    if (nameEl) nameEl.textContent = current.name;
    if (avatarEl) avatarEl.textContent = current.name.slice(0, 1).toUpperCase();
  }

  function openProfilePicker() {
    const profiles = (typeof NebulaCore !== 'undefined' && NebulaCore.LOCAL_PROFILES) || [{ id: 'personal', name: 'Personal' }, { id: 'cine', name: 'Cine' }, { id: 'series', name: 'Series' }];
    const activeId = Store.localProfile || 'personal';
    showModal(`
      <h2><svg class="icon" aria-hidden="true"><use href="#i-user"/></svg>Perfil local</h2>
      <p>Cada perfil guarda su propio continuar viendo, favoritos, historial y vistos en este dispositivo.</p>
      <div class="tv-source-options profile-options">
        ${profiles.map((p) => `<button type="button" class="btn tv-source-option" data-switch-profile="${esc(p.id)}" aria-pressed="${p.id === activeId}"><i class="profile-avatar" aria-hidden="true">${esc(String(p.name || '?').charAt(0).toUpperCase())}</i><span>${esc(p.name)}</span>${p.id === activeId ? '<small>Actual</small>' : ''}</button>`).join('')}
      </div>
      <div class="m-actions"><button type="button" class="btn" id="profileClose">Cerrar</button></div>
    `, () => {
      $$('#modalLayer [data-switch-profile]').forEach((btn) => {
        btn.onclick = () => {
          const next = btn.dataset.switchProfile;
          if (typeof Store.switchLocalProfile === 'function') Store.switchLocalProfile(next);
          syncProfileBadge();
          closeModal();
          toast(`Perfil cambiado a ${btn.querySelector('span')?.textContent || next}`);
          if (currentRoute) activateRoute({ ...currentRoute, scrollTop: 0 });
        };
      });
      $('#profileClose').onclick = closeModal;
    });
  }

  const stripSeasonTag = (value) => String(value || '').replace(/\s+(?:T(?:emp\.?|emporada)?|Season)\s*\d+\s*$/i, '');
  function mergeCatalogWithXuper(baseItems = [], extraItems = []) {
    if (!extraItems?.length) return [...(baseItems || []).filter(Boolean)];
    const norm = CatalogSources?.identity?.normalizeTitle || (v => String(v || '').toLowerCase().trim());
    const seenId = new Set(), seenName = new Set(), out = [], descOrders = [];
    let minOrder = Infinity;
    for (const item of baseItems || []) {
      if (!item) continue;
      out.push(item);
      seenId.add(`${item.type}:${item.id}`);
      for (const ident of item.identities || []) if (ident.providerId === 'tmdb') seenId.add(`${item.type}:${ident.id}`);
      const base = norm(stripSeasonTag(item.title));
      const yr = String(item.year || '').slice(0, 4);
      if (base) seenName.add(`${item.type}:${base}:${yr}`);
      const ord = Number(item.catalogOrder);
      if (Number.isFinite(ord)) { descOrders.push(ord); if (ord < minOrder) minOrder = ord; }
    }
    descOrders.sort((a, b) => b - a);
    if (!Number.isFinite(minOrder)) minOrder = 0;
    let page1Idx = 0, prevAssigned = Infinity;
    for (const rawItem of extraItems) {
      if (!rawItem) continue;
      if (seenId.has(`${rawItem.type}:${rawItem.id}`)) continue;
      if ((rawItem.identities || []).some(ident => ident.providerId === 'tmdb' && seenId.has(`${rawItem.type}:${ident.id}`))) continue;
      const base = norm(stripSeasonTag(rawItem.title));
      const yr = String(rawItem.year || '').slice(0, 4);
      if (base && (seenName.has(`${rawItem.type}:${base}:${yr}`) || (!yr && [...seenName].some(k => k.startsWith(`${rawItem.type}:${base}:`))))) continue;
      seenId.add(`${rawItem.type}:${rawItem.id}`);
      if (base) seenName.add(`${rawItem.type}:${base}:${yr}`);
      let catalogOrder;
      if (Number(rawItem.xuperPage) > 1) {
        catalogOrder = minOrder - 1000 - (Number(rawItem.xuperOrder) || page1Idx);
      } else {
        const anchor = page1Idx < descOrders.length ? descOrders[page1Idx] : (minOrder - 1 - (page1Idx - descOrders.length));
        catalogOrder = Math.min(prevAssigned - 0.001, anchor - 0.5);
        prevAssigned = catalogOrder;
        page1Idx++;
      }
      out.push({ ...rawItem, catalogOrder });
    }
    return out;
  }

  /* ============================ Inicio ============================ */
  let sidebarGroupsWired=false;
  /** El lateral es persistente: sus listeners se registran una vez (antes se sumaban en cada pintado de Inicio). */
  function wireSidebarGroups(){
    if(sidebarGroupsWired)return;sidebarGroupsWired=true;
    const groups=$$('#sidebar .nav-group');
    groups.forEach(group=>group.addEventListener('toggle',()=>{if(group.open)groups.forEach(other=>{if(other!==group)other.open=false;});}));
    $$('#sidebar [data-category-nav], #sidebar .nav-panel .nav-item').forEach(entry=>entry.addEventListener('click',()=>groups.forEach(group=>{group.open=false;})));
  }
  async function renderHome() {
    const route=currentRoute,request=++homeRequest;
    homeFilter=['all','movie','tv'].includes(route.params.filter)?route.params.filter:'all';
    const rawSort = route.params.sort === 'source' ? 'recent' : route.params.sort;
    const sort=['recent','year','rating','rating-asc','title'].includes(rawSort)?rawSort:'recent';
    // Phone (canvas «Inicio · Cargando»): the home layout drawn in grey instead of a generic grid.
    content().innerHTML = Platform.isAndroid && !tvInterface() ? `
      <div class="view home-skeleton" role="status" aria-label="Cargando catálogo">
        <span class="sr-only">Cargando catálogo…</span>
        <div class="skel skel-art"></div>
        <div class="skel-copy"><div class="skel skel-line skel-title"></div><div class="skel skel-line skel-meta"></div><div class="skel skel-line skel-text"></div><div class="skel skel-line skel-text short"></div><div class="skel skel-btn"></div><div class="skel-pair"><div class="skel skel-btn"></div><div class="skel skel-btn"></div></div></div>
        <div class="skel skel-line skel-head"></div>
        <div class="skel-row">${'<div class="skel skel-resume"></div>'.repeat(2)}</div>
        <div class="skel skel-line skel-head"></div>
        <div class="skel-row">${'<div class="skel skel-poster"></div>'.repeat(3)}</div>
      </div>` : `
      <div class="view">
        <div class="row-head"><h2>⏳ Cargando catálogo…</h2></div>
        <div class="grid">${'<div class="poster skeleton"></div>'.repeat(8)}</div>
      </div>`;

    const settings = Store.settings;
    let rows=[],catRows={items:[],errors:[],loading:true},sourceRows=[],animeExtra=[],backupRows=[],xuperHome={movies:[],series:[],anime:[]},xuperPremiereItems=[];
    async function paintHome(){
    if (currentRoute!==route||request!==homeRequest) return;
    const movies = mergeCatalogWithXuper(catRows.items.filter(item => item.type === 'movie'), xuperHome.movies);
    const series = mergeCatalogWithXuper(catRows.items.filter(item => item.type === 'tv'), xuperHome.series);
    const animeCatalog = mergeCatalogWithXuper(catRows.items.filter(item => NebulaCore.catalogCategory(item) === 'anime'), xuperHome.anime);
    const allCatalogRecent = mergeCatalogWithXuper(catRows.items, [...xuperHome.movies, ...xuperHome.series, ...xuperHome.anime]);
    const byId = new Map(catRows.items.map(item => [`${item.type}:${item.id}`, item]));
    const catalogFor = (item) => byId.get(`${item.type}:${item.id}`) || API.findCatalogItem(item.type, item.id, item);
    for (const item of rows.flatMap(row => row.items || [])) {
      const catalogItem = catalogFor(item);
      if (catalogItem && !Number(catalogItem.rating) && Number(item.rating)) { catalogItem.rating = item.rating; rememberRating(catalogItem.type, catalogItem.id, item.rating); }
    }
    const isPremiereRow=row=>/cartelera|estrenos/i.test(row.title||'');
    const tmdbPremieres = rows.filter(isPremiereRow).flatMap(row => row.items || []);
    const tmdbMatchedPremieres = [], tmdbUnmatchedPremieres = [];
    for (const item of tmdbPremieres) {
      const match = catalogFor(item);
      if (match) tmdbMatchedPremieres.push({ ...item, ...match, backdrop: item.backdrop || match.backdrop, overview: item.overview || match.overview, rating: item.rating ?? match.rating });
      else tmdbUnmatchedPremieres.push(item);
    }
    const maxReleaseDate = new Date(Date.now() + 14 * 86400000).toISOString().slice(0, 10);
    const minPremiereYear = new Date().getFullYear() - 1;
    const catalogRecentPremieres = NebulaCore.orderItems(
      movies.filter((item) => {
        const yr = Number(String(item.year || '').slice(0, 4));
        if (!Number.isFinite(yr) || yr < minPremiereYear) return false;
        const d = String(item.releaseDate ?? item.raw?.date ?? '').trim();
        return !/^\d{4}-\d{2}-\d{2}/.test(d) || d.slice(0, 10) <= maxReleaseDate;
      }),
      'year'
    ).slice(0, 24);
    const mixedCatalogPremieres = [];
    const mixLimit = Math.max(xuperPremiereItems.length, catalogRecentPremieres.length);
    for (let i = 0; i < mixLimit; i++) {
      if (xuperPremiereItems[i]) mixedCatalogPremieres.push(xuperPremiereItems[i]);
      if (catalogRecentPremieres[i]) mixedCatalogPremieres.push(catalogRecentPremieres[i]);
    }
    const premierePool = mergeCatalogWithXuper(tmdbMatchedPremieres, [...mixedCatalogPremieres, ...tmdbUnmatchedPremieres]);
    // Destacado rotativo: cambia cada 6 h entre los títulos de TMDB que están en el catálogo,
    // porque son los que traen sinopsis, arte y puntaje.
    if (!catRows.rated) { applyRatings(catRows.items); catRows.rated = true; }
    const spotSeed = Math.floor(Date.now() / (6 * 60 * 60 * 1000));
    const spotCandidates = [...rows.flatMap(row => row.items || []), ...premierePool].filter(item => (homeFilter === 'all' || item.type === homeFilter) && catalogFor(item));
    const spotRanked = NebulaCore.orderItems(spotCandidates, 'rating');
    const spotPool = spotRanked.length ? spotRanked : NebulaCore.orderItems(movies.concat(series), 'rating');
    const spotBase = spotPool.length ? spotPool[spotSeed % Math.min(spotPool.length, 20)] : null;
    const featured = spotBase ? { ...spotBase, ...(catalogFor(spotBase) || {}), backdrop: spotBase.backdrop || spotBase.poster, overview: spotBase.overview } : null;
    const latest = items => NebulaCore.orderItems(items,sort).slice(0,Platform.isAndroid?12:24);
    const continueList = Store.resumeList.slice(0, 40);
    const featFav = featured ? Store.isFavorite(featured.type, featured.id) : false;

    // Canvas «Inicio · Sin conexión»: what is shown is what was already loaded; «Reintentar» reloads when the network is back.
    // The phone shows the strip right under the header, above the dimmed spotlight; other screens keep it after the spotlight.
    const offline = globalThis.navigator?.onLine === false;
    const offlineAtTop = offline && Boolean(document.body?.classList?.contains?.('platform-android')) && !tvInterface();
    const offlineBanner = offline ? `<section class="offline-banner" role="status"><svg class="offline-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 8.8a15 15 0 0 1 4.2-2.6"/><path d="M22 8.8a15 15 0 0 0-11.3-3.6"/><path d="M5 12.6a10 10 0 0 1 5.2-2.5"/><path d="M19 12.6a10 10 0 0 0-2.2-1.4"/><path d="M8.5 16.4a5 5 0 0 1 7 0"/><path d="M12 20h.01"/><path d="M3 3l18 18"/></svg><span class="offline-copy"><strong>Sin conexión</strong><span>Mostrando lo que ya estaba cargado</span></span><button type="button" class="btn" id="offlineRetry">Reintentar</button></section>` : '';
    let html = `<div class="view home-view${offline ? ' home-offline' : ''}"><header class="home-heading sr-only"><div><h1>Inicio</h1></div><div class="catalog-health"><span></span>${catRows.items.length ? 'Catálogo conectado' : 'Explora tus fuentes'}</div></header>
      `;
    if (offlineAtTop) html += offlineBanner;
    if (featured) html += `<section class="feature-spotlight">${featured.backdrop || featured.poster ? `<img class="feature-art" alt="" fetchpriority="high" decoding="async" src="${esc(featured.backdrop || featured.poster)}"/>` : ''}<div class="feature-shade"></div><div class="feature-copy"><h2>${esc(featured.title)}</h2><div class="feature-meta"><span>${featured.type === 'tv' ? 'Serie' : 'Película'}</span><span>${esc(String(featured.year || '').slice(0, 4))}</span>${featured.qualities?.[0] ? `<span class="feature-quality">${esc(featured.qualities[0].name)}</span>` : ''}${NebulaUI.ratingValue(featured.rating) !== null ? `<span class="feature-rating">★ ${NebulaUI.ratingValue(featured.rating).toFixed(1)}</span>` : ''}${featured.runtime ? `<span class="feature-runtime">${esc(featured.runtime)} min</span>` : ''}${(featured.genres && featured.genres.length ? featured.genres : NebulaCore.catalogGenres(featured).map(genreLabel)).filter(Boolean).slice(0, 3).map((genre) => `<span class="feature-genre">${esc(genre)}</span>`).join('')}</div><p>${esc(featured.overview || 'Descubre una nueva historia. Elige tu fuente y continúa donde lo dejaste.')}</p><div class="feature-actions${(featured.type === 'movie' && featured.urls?.length) || featured.type === 'tv' ? ' has-play' : ''}">${featured.type === 'movie' && featured.urls?.length ? `<button class="btn primary" id="featurePlay"><svg class="icon" aria-hidden="true"><use href="#i-play"/></svg>Reproducir</button>` : ''}${featured.type === 'tv' ? (() => { const saved = Store.resumeList.find((entry) => entry.type === 'tv' && String(entry.id) === String(featured.id) && entry.season); return `<button class="btn primary" id="featurePlaySeries"><svg class="icon" aria-hidden="true"><use href="#i-play"/></svg>${saved ? `Continuar T${saved.season}·E${saved.episode}` : 'Reproducir T1·E1'}</button>`; })() : ''}<button class="btn feature-details" id="featureDetails"><svg class="icon feature-details-icon" aria-hidden="true"><use href="#i-info"/></svg><span class="feature-details-text">Ver detalles</span><span class="feature-details-desk">Más información</span></button><button class="btn feature-trailer hidden" id="featureTrailer" type="button"><svg class="icon" aria-hidden="true"><use href="#i-play"/></svg>Ver tráiler</button><button class="btn ${featFav ? 'danger-ghost' : ''}" id="featureFav" aria-pressed="${featFav}">${featFav ? icon('check') + 'En Mi lista' : '+ Mi lista'}</button></div></div></section>`;
    if (catRows.errors?.length && !backupRows.length && !movies.length && !series.length) html += stateMessage({art:'cloud',role:'alert',title:'No se pudo cargar el catálogo',detail:'Revisa tu conexión o usa el respaldo automático.',hint:publicMessage(catRows.errors[0]),actions:[{id:'homeRetry',label:'Reintentar',primary:true,icon:'reload'},{id:'homeDownloads',label:'Ver descargas',icon:'download'}]});
    if (offline && !offlineAtTop) html += offlineBanner;
    if(catRows.notices?.length)html+=`<p role="status" class="source-notice">${esc(catRows.notices[0])}</p>`;

    // Orden alineado con Android TV: Seguir viendo -> En cartelera -> Explora por plataforma -> Películas -> Series -> Anime
    if (continueList.length) html += resumeWideRow(continueList);
    const visiblePremieres = premierePool.filter(matchesHome).slice(0, Platform.isAndroid ? 12 : 20);
    if (visiblePremieres.length) html += homeRow('En cartelera / estrenos', visiblePremieres);
    html += platformStripMarkup();

    if(catRows.loading && !movies.length && !series.length)html+='<p class="source-notice" role="status">Cargando catálogo…</p>';
    const isAndroidUi = Platform.isAndroid || document.body?.classList?.contains?.('platform-android');
    if (movies.length || series.length || (catRows && catRows.items && catRows.items.length)) {
      const gridPool = homeFilter === 'tv' ? latest(series) : homeFilter === 'movie' ? latest(movies) : NebulaCore.orderItems(allCatalogRecent, sort).slice(0, isAndroidUi ? 10 : 24);
      if (gridPool.length && !tvInterface() && !isAndroidUi) {
        html += `<div class="row-head"><h2>Agregados recientemente</h2></div><div class="grid">${gridPool.map(it => posterCard(it)).join('')}</div>`;
      }
      if (homeFilter !== 'tv' && movies.length) html += homeRow('Películas recientes', latest(movies));
      if (homeFilter !== 'movie' && series.length) html += homeRow('Series recientes', latest(series));
    } else if (backupRows.length) {
      backupRows.forEach((row) => { html += homeRow(row.title, (row.items || []).filter(matchesHome)); });
    }

    const animeSeen = new Set();
    const animeCombined = [];
    for (const item of [...latest(animeCatalog), ...(animeExtra || [])]) {
      if (!item || !matchesHome(item)) continue;
      const k = `${item.type}:${item.id}`;
      if (animeSeen.has(k)) continue;
      animeSeen.add(k);
      animeCombined.push(catalogFor(item) || item);
    }
    if (animeCombined.length) html += homeRow('Anime', animeCombined.slice(0, Platform.isAndroid ? 12 : 20));

    // 4. Filas de archivos (jellyfin/archive)
    sourceRows.forEach((r) => {
      if (r.status === 'fulfilled') r.value.forEach((row) => { html += homeRow(row.title, row.items.filter(matchesHome)); });
    });

    // 5. Filas secundarias de TMDB
    (rows || []).forEach((r) => {
      if (r.items && r.items.length && !isPremiereRow(r)) {
        html += homeRow(r.title, r.items.filter(matchesHome).slice(0, Platform.isAndroid?12:20));
      }
    });

    // 6. Descubrimiento por género, orden y familias del catálogo
    html += `<section class="home-discovery"><div class="row-head home-discovery-head"><h2>Explorar por género</h2><div class="browse-order"><label for="homeOrder">Ordenar</label><select id="homeOrder"><option value="recent">Últimas incorporaciones</option><option value="year">Estreno más reciente</option><option value="rating">Puntaje (mayor a menor)</option><option value="rating-asc">Puntaje (menor a mayor)</option><option value="title">Título</option></select></div></div>`;
    html += genreSection();
    html += categoryLinks();
    html += '</section></div>';

    const scroll=content().scrollTop||route.scrollTop||0;
    const focused=content().contains(document.activeElement)?document.activeElement:null;
    if(focused&&/^(INPUT|SELECT|TEXTAREA)$/.test(focused.tagName))return;
    const focusedKey=focused?.dataset?.navKey;
    const focusedTop=focusedKey?focused.getBoundingClientRect().top:0;
    content().innerHTML = html;
    content().scrollTop=scroll;
    if(offline)markOfflineDownloads(route);
    if(Array.isArray(route.rowScrolls))$$('.row-scroll,.resume-row,.platforms-row',content()).forEach((el,i)=>{if(route.rowScrolls[i])el.scrollLeft=route.rowScrolls[i];});
    $$('[data-home-filter]').forEach(button => {button.setAttribute('aria-pressed',String(button.dataset.homeFilter===homeFilter));button.onclick = () => { const clicked=button.dataset.homeFilter; currentRoute.params.filter=(clicked===homeFilter&&clicked!=='all')?'all':clicked; renderHome(); }; });
    $('#homeOrder').value=sort;$('#homeOrder').onchange=()=>{currentRoute.params.sort=$('#homeOrder').value;renderHome();};
    if ($('#featureDetails')) $('#featureDetails').onclick = () => go('catalog', { id: featured.id, catalogUrl: featured.catalogUrl });
    // «Reproducir» del destacado: si hay progreso guardado, el reproductor pregunta si continuar.
    if ($('#featurePlay')) $('#featurePlay').onclick = () => resumeItem(featured.type,featured.id,0,0,{trigger:$('#featurePlay'),direct:false});
    if ($('#featurePlaySeries')) $('#featurePlaySeries').onclick = () => {
      // El botón dice «Continuar T·E» cuando hay progreso: se reanuda ese mismo episodio.
      const saved = Store.resumeList.find((entry) => entry.type === 'tv' && String(entry.id) === String(featured.id) && entry.season);
      resumeItem('tv', featured.id, Number(saved?.season) || 0, Number(saved?.episode) || 0, { trigger: $('#featurePlaySeries') });
    };
    if ($('#featureFav') && featured) {
      $('#featureFav').onclick = () => {
        const on = Store.toggleFavorite({ type: featured.type, id: featured.id, title: featured.title, poster: featured.poster, year: featured.year, rating: featured.rating, kind: featured.kind || 'tmdb', catalogUrl: featured.catalogUrl });
        const btn = $('#featureFav');
        btn.innerHTML = on ? icon('check') + 'En Mi lista' : '+ Mi lista';
        btn.setAttribute('aria-pressed', String(on));
        btn.className = `btn ${on ? 'danger-ghost' : ''}`;
        toast(on ? 'Agregado a Mi lista' : 'Quitado de Mi lista');
      };
    }
    // El arte y el título del destacado abren la ficha (en el celular no se muestra «Ver detalles» si hay «Reproducir»).
    $$('.feature-spotlight .feature-art, .feature-spotlight .feature-copy h2', content()).forEach((node) => { node.onclick = () => $('#featureDetails')?.click(); });
    // «Ver tráiler» aparece solo si TMDB tiene uno para el destacado.
    const featuredTmdbId = featured && ((featured.identities || []).find((value) => value.providerId === 'tmdb')?.id || (spotBase?.kind === 'tmdb' ? spotBase.id : null));
    if (featured && featuredTmdbId && API.detailDiscovery && $('#featureTrailer')) {
      API.detailDiscovery(featured.type, featuredTmdbId).then((extra) => {
        const button = $('#featureTrailer');
        if (!extra?.trailer || !button || currentRoute !== route) return;
        button.classList.remove('hidden');
        button.onclick = () => {
          if (/^https:\/\/(?:www\.)?youtube\.com\/watch\?/.test(extra.trailer)) (Platform.openExternal || Platform.openUrl)(extra.trailer);
          else Player.open({ type: featured.type, id: featured.id, title: `${featured.title} — Tráiler`, poster: featured.poster, kind: 'trailer', url: extra.trailer });
        };
      }).catch(() => {});
    }
    $$('[data-platform-id]', content()).forEach((card) => {
      card.onclick = () => go('platform', { platformId: card.dataset.platformId });
    });
    wirePosters();
    $$('.resume-card').forEach((card) => {
      card.onclick = () => resumeItem(card.dataset.resumeType, card.dataset.resumeId, Number(card.dataset.resumeSeason), Number(card.dataset.resumeEpisode), { trigger: card });
    });
    wireSidebarGroups();
    wireCarouselArrows();
    if(focusedKey){const restored=$$('[data-nav-key]',content()).find(card=>card.dataset.navKey===focusedKey);if(restored){restored.focus({preventScroll:true});content().scrollTop+=restored.getBoundingClientRect().top-focusedTop;}}

    if ($('#homeRetry')) $('#homeRetry').onclick = () => renderHome();
    if ($('#homeDownloads')) $('#homeDownloads').onclick = () => go('downloads');
    if ($('#offlineRetry')) $('#offlineRetry').onclick = () => renderHome();
    wireCategoryLinks();
    if(route.params.genre)await loadGenre(Number(route.params.genre));
    }
    await Promise.allSettled([
      API.homeRows().catch(()=>[]).then(value=>{rows=value;return paintHome();}),
      API.animeHomeRow?.().catch(()=>[]).then(value=>{animeExtra=value||[];return paintHome();}),
      typeof API.xuperPremieres === 'function'
        ? API.xuperPremieres().catch(() => []).then((value) => { xuperPremiereItems = value || []; return paintHome(); })
        : Promise.resolve(),
      API.loadCatalogs(settings.catalogUrls).catch(error=>({items:[],errors:[publicMessage(error.message)]})).then(async value=>{
        catRows=value;
        if ((!catRows.items.length || catRows.errors?.length) && typeof API.nebulaFallbackRows === 'function') {
          backupRows = await API.nebulaFallbackRows().catch(() => []);
        }
        return paintHome();
      }),
      typeof API.loadXuperBrowse === 'function'
        ? Promise.all([
            API.loadXuperBrowse('movies', 1).catch(() => ({ items: [] })),
            API.loadXuperBrowse('series', 1).catch(() => ({ items: [] })),
            API.loadXuperBrowse('anime', 1).catch(() => ({ items: [] })),
          ]).then(([mv, tv, an]) => {
            xuperHome = { movies: mv?.items || [], series: tv?.items || [], anime: an?.items || [] };
            return paintHome();
          })
        : Promise.resolve(),
      Promise.allSettled([API.jellyfinRows()]).then(value=>{sourceRows=value;return paintHome();}),
    ]);
    // Recuperar la actualización de fondo sin interrumpir una interacción o cambiar de vista.
    const refreshHomeBackground = async () => {
      if (currentRoute !== route || request !== homeRequest) return false;
      const latest = await API.loadCatalogs(settings.catalogUrls, { force: true }).catch(() => null);
      if (!latest || currentRoute !== route || request !== homeRequest) return false;
      if (latest.items.length !== catRows.items.length || latest.items.some((item, index) => item !== catRows.items[index])) {
        catRows = latest;
        await paintHome();
        return true;
      }
      return false;
    };
    const tFirst = setTimeout(async () => {
      const changed = await refreshHomeBackground();
      if (!changed && currentRoute === route && request === homeRequest) {
        const tSecond = setTimeout(() => { refreshHomeBackground(); }, 20000);
        tSecond?.unref?.();
      }
    }, 8000);
    tFirst?.unref?.();
  }

  async function renderPlatform(params = {}) {
    const route = currentRoute;
    const platforms = API.WATCH_PLATFORMS || NebulaCore.STREAMING_PLATFORMS || [];
    const platform = platforms.find((p) => p.id === params.platformId) || platforms[0];
    if (!platform) return renderHome();
    const typeFilter = ['all', 'movie', 'tv'].includes(params.type) ? params.type : 'all';
    const region = /^[A-Z]{2}$/.test(String(params.region || '').toUpperCase())
      ? String(params.region).toUpperCase()
      : (API.regionFromLang ? API.regionFromLang() : 'AR');
    route.params.platformId = platform.id;
    route.params.type = typeFilter;
    route.params.region = region;
    $('#tbTitle').textContent = platform.name;

    const regions = [['AR', 'Argentina'], ['MX', 'México'], ['CO', 'Colombia'], ['CL', 'Chile'], ['ES', 'España'], ['US', 'EE. UU.']];
    content().innerHTML = `
      <div class="view platform-view">
        <div class="platforms-row platform-switch" role="group" aria-label="Plataformas">${platforms.map((p) => `<button type="button" class="platform-card" data-platform-switch="${esc(p.id)}" aria-label="${esc(p.name)}" aria-pressed="${p.id === platform.id}" style="--brand-color:${esc(p.color)}"><span class="platform-logo">${PLATFORM_LOGOS[p.id] || esc(p.name)}</span></button>`).join('')}</div>
        <header class="platform-hero" style="--brand-color:${esc(platform.color)}">
          <div class="platform-hero-brand">
            <span class="platform-hero-logo">${PLATFORM_LOGOS[platform.id] || esc(platform.name)}</span>
            <div><h1>${esc(platform.name)}</h1><p>Catálogo disponible en ${esc(regions.find(([code]) => code === region)?.[1] || region)}</p></div>
          </div>
          <div class="platform-controls">
            <div class="collection-tabs" role="group" aria-label="Tipo de contenido">
              <button type="button" data-plat-type="all" aria-pressed="${typeFilter === 'all'}">Todos</button>
              <button type="button" data-plat-type="movie" aria-pressed="${typeFilter === 'movie'}">Películas</button>
              <button type="button" data-plat-type="tv" aria-pressed="${typeFilter === 'tv'}">Series</button>
            </div>
            <label for="platformRegion" class="platform-region-label">Región
              <select id="platformRegion">${regions.map(([code, label]) => `<option value="${esc(code)}" ${code === region ? 'selected' : ''}>${esc(label)}</option>`).join('')}</select>
            </label>
          </div>
        </header>
        <div id="platformStatus"></div>
        <div class="grid" id="platformGrid">${'<div class="poster skeleton"></div>'.repeat(12)}</div>
        <div class="browse-more"><button type="button" class="btn hidden" id="platformMore">Mostrar más</button></div>
        <p class="platform-attribution">TMDB / JustWatch · ${esc(region)} · Disponibilidad al abrir la ficha</p>
      </div>`;

    $$('[data-plat-type]', content()).forEach((btn) => {
      btn.onclick = () => go('platform', { platformId: platform.id, type: btn.dataset.platType, region });
    });
    $('#platformRegion').onchange = (ev) => go('platform', { platformId: platform.id, type: typeFilter, region: ev.target.value });
    // Selector de plataformas (escritorio y tablet; oculto en el celular).
    $$('[data-platform-switch]', content()).forEach((card) => {
      card.onclick = () => { if (card.dataset.platformSwitch !== platform.id) go('platform', { platformId: card.dataset.platformSwitch, type: typeFilter, region }); };
    });

    let page = 1;
    const allItems = [];
    const loadPage = async (append = false) => {
      try {
        await API.loadCatalogs(Store.settings.catalogUrls).catch(() => {});
        const res = await API.discoverPlatform(platform.id, region, page, typeFilter);
        if (currentRoute !== route) return;
        if (res.missingToken) {
          $('#platformGrid').innerHTML = '';
          $('#platformStatus').innerHTML = `${emptyState('🔑', 'Configura tu clave de TMDB en Ajustes para explorar por plataforma.')}<div class="m-actions set-actions-start"><button type="button" class="btn primary" id="platOpenSettings">Ir a Ajustes</button></div>`;
          $('#platOpenSettings')?.addEventListener('click', () => go('settings'));
          return;
        }
        if (res.unavailableInRegion) {
          $('#platformGrid').innerHTML = '';
          $('#platformStatus').innerHTML = emptyState('🌐', `${platform.name} no figura en ${region}. Prueba otra región.`);
          return;
        }
        if (!append) allItems.length = 0;
        const seen = new Set(allItems.map((it) => `${it.type}:${it.id}`));
        for (const it of res.items || []) {
          const key = `${it.type}:${it.id}`;
          if (!seen.has(key)) { seen.add(key); allItems.push(it); }
        }
        if (!allItems.length) {
          $('#platformGrid').innerHTML = '';
          $('#platformStatus').innerHTML = emptyState('🎬', 'No encontramos títulos para esta selección.');
        } else {
          $('#platformStatus').innerHTML = '';
          $('#platformGrid').innerHTML = allItems.map((it) => posterCard(it)).join('');
          wirePosters();
        }
        const moreBtn = $('#platformMore');
        if (moreBtn) {
          moreBtn.classList.toggle('hidden', !res.hasMore);
          moreBtn.disabled = false;
          moreBtn.onclick = async () => { moreBtn.disabled = true; page += 1; await loadPage(true); };
        }
      } catch (error) {
        if (currentRoute !== route) return;
        $('#platformGrid').innerHTML = '';
        $('#platformStatus').innerHTML = emptyState('⚠️', `No se pudo consultar ${platform.name}: ${publicMessage(error.message)}`);
      }
    };
    await loadPage(false);
  }

  const GENRE_LABELS={28:'Acción',12:'Aventura',16:'Animación',35:'Comedia',80:'Crimen',99:'Documental',18:'Drama',10751:'Familia',14:'Fantasía',36:'Historia',27:'Terror',10402:'Música',9648:'Misterio',10749:'Romance',878:'Ciencia ficción',10770:'Película de TV',53:'Suspenso',10752:'Bélica',37:'Western',10759:'Acción y aventura',10762:'Niños',10763:'Noticias',10764:'Reality',10765:'Ciencia ficción y fantasía',10766:'Telenovela',10767:'Talk show',10768:'Guerra y política'};
  const genreLabel=value=>GENRE_LABELS[value]||(/^\d+$/.test(value)?'Género '+value:value);

  function categoryLinks(selected='') {
    // Phone (canvas «Celular · Explorar»): one «Anime y cartoons» chip, the Anime category showing both.
    const phone = Boolean(document.body?.classList?.contains?.('platform-android')) && !tvInterface() && Number(globalThis.innerWidth) <= 760;
    const categories = NebulaCore.CATALOG_CATEGORIES.filter(category => !(phone && category.id === 'cartoons'));
    return `<div class="category-links" role="group" aria-label="Categorías">${categories.map(category=>{
      const both = phone && category.id === 'anime';
      return `<button data-category="${category.id}"${both ? ' data-subtype="all"' : ''} aria-pressed="${selected===category.id || (both && selected==='cartoons')}">${esc(both ? 'Anime y cartoons' : category.label)}</button>`;
    }).join('')}</div>`;
  }
  function wireCategoryLinks(){ $$('[data-category]').forEach(button=>button.onclick=()=>go('browse',{category:button.dataset.category,...(button.dataset.subtype?{subtype:button.dataset.subtype}:{})})); }
  async function renderBrowse(params={}) {
    const route=currentRoute;
    const headingClass=tvInterface()?'page-heading':'page-heading sr-only';
    const category=NebulaCore.CATALOG_CATEGORIES.find(category=>category.id===(params.category==='anime'&&params.subtype==='cartoons'?'cartoons':params.category))||NebulaCore.CATALOG_CATEGORIES[0];
    route.params.category=category.id;
    if(document.body?.dataset)document.body.dataset.browseCategory=category.id;
    $('#tbTitle').textContent = category.label;
    $$('[data-category-nav]').forEach(button=>{const active=button.dataset.categoryNav===category.id;button.classList.toggle('active',active);if(active)button.setAttribute('aria-current','page');else button.removeAttribute('aria-current');});
    content().innerHTML=`<div class="view browse-view"><header class="${headingClass}"><h1>${esc(category.label)}</h1><p role="status">Cargando el catálogo…</p></header><div class="grid">${'<div class="poster skeleton"></div>'.repeat(12)}</div></div>`;
    const catalog=await API.loadCatalogs(Store.settings.catalogUrls).catch(error=>({items:[],errors:[publicMessage(error.message)]}));
    applyRatings(catalog.items);
    if(currentRoute!==route)return;
    let xuperExtraItems=[];
    let xuperPage=1,xuperHasMore=false,xuperLoading=false;
    let allBrowseItems=[...catalog.items];
    const family=allBrowseItems.filter(item=>NebulaCore.catalogCategory(item)===category.id);
    const genres=[...new Set(family.flatMap(NebulaCore.catalogGenres))];
    const years=[...new Set(family.map(item=>String(item.year||'').slice(0,4)).filter(year=>/^\d{4}$/.test(year)))].sort().reverse();
    const collections=[['recent','Recientes'],['history','Historial'],['for-you','Para ti'],['recommended','Recomendados'],['popular','Populares']];
    if(family.some(NebulaCore.catalogUpdated))collections.splice(2,0,['updated','Actualizadas']);
    let collection=collections.some(([value])=>value===params.collection)?params.collection:'recent';
    let recommendationRows=[],recommendationsLoading=true,recommendationsFailed=false;
    let page=Math.max(1,Math.min(1000,Number(params.page)||1));
    const select=(id,label,options,value)=>`<label for="${id}">${label}<select id="${id}">${options.map(([key,text])=>`<option value="${esc(key)}" ${String(key)===String(value||'')?'selected':''}>${esc(text)}</option>`).join('')}</select></label>`;
    const animeSubtypeSelect=category.id==='anime'?select('browseSubtype','Mostrar',[['','Anime'],['all','Anime y Cartoons'],['tv','Solo series'],['movie','Solo películas'],['cartoons','Solo Cartoons']],params.subtype):'';
    // El celular muestra «Explorar» con un botón de filtros arriba y un resumen con «Limpiar filtros» (canvas Celular · Explorar).
    content().innerHTML=`<div class="view browse-view${params.filtersOpen?' filters-open':''}"><h1 class="browse-desk-title" aria-hidden="true">${category.id==='anime'?'Anime':'Catálogo'}</h1><div class="browse-phone-head"><h1>Explorar</h1><button type="button" class="btn browse-phone-filters" id="browsePhoneFilters" aria-controls="browseFilters" aria-expanded="${!!params.filtersOpen}">${icon('sliders')}<span>Filtros</span></button></div><header class="${headingClass}"><h1>${esc(category.label)}</h1></header>
      <div class="collection-tabs" role="group" aria-label="Listas de ${esc(category.label)}">${collections.map(([value,label])=>`<button data-collection="${value}" aria-pressed="${value===collection}">${label}</button>`).join('')}</div>
      ${categoryLinks(category.id)}<div class="browse-category-mobile">${select('browseCategory','Categoría',NebulaCore.CATALOG_CATEGORIES.map(item=>[item.id,item.label]),category.id)}</div>
      <button class="btn browse-filter-toggle" id="browseFiltersToggle" aria-expanded="${!!params.filtersOpen}" aria-controls="browseFilters">${icon('sliders')}Filtros y orden<svg class="icon browse-filter-chevron" aria-hidden="true"><use href="#i-chevron"/></svg></button><div class="browse-filters" id="browseFilters" ${!params.filtersOpen?'data-collapsed':''}>${animeSubtypeSelect}${select('browseGenre','Género',[['','Todos los géneros'],...genres.sort((a,b)=>genreLabel(a).localeCompare(genreLabel(b),'es')).map(value=>[value,genreLabel(value)])],params.genre)}${select('browseYear','Año',[['','Todos los años'],...years.map(value=>[value,value])],params.year)}${select('browseQuality','Calidad e idioma',[['','Todas las opciones'],['4K','4K'],['1080','1080p'],['720','720p'],['CAST','Castellano'],['IMAX','IMAX']],params.quality)}${select('browseOrder','Ordenar',[['source','Orden de la lista'],['year','Año de estreno'],['rating','Puntaje (mayor a menor)'],['rating-asc','Puntaje (menor a mayor)'],['title','Título A–Z']],params.order)}<button class="btn" id="browseReset">Limpiar filtros</button></div>
      <div class="browse-summary"><span id="browseSummary"></span><button type="button" class="browse-summary-clear" id="browseSummaryClear" hidden>Limpiar filtros</button></div>
      ${catalog.errors?.length?`<div class="source-notice" role="status">No se pudieron consultar todas las fuentes. <button class="btn" id="browseRetry">Reintentar</button></div>`:''}
      <p class="browse-explanation sr-only" id="browseExplanation"></p><p class="sr-only" id="browseCount" role="status" aria-live="polite"></p><div id="browseEmpty"></div><div class="grid" id="browseGrid"></div><div class="browse-more"><button class="btn" id="browseMore">Mostrar más</button></div></div>`;
    wireCategoryLinks();
    $('#browseCategory').onchange=()=>go('browse',{category:$('#browseCategory').value});
    $('#browseFiltersToggle').onclick=()=>{const open=$('#browseFiltersToggle').getAttribute('aria-expanded')!=='true';$('#browseFiltersToggle').setAttribute('aria-expanded',String(open));$('#browsePhoneFilters')?.setAttribute('aria-expanded',String(open));$('#browseFilters').toggleAttribute('data-collapsed',!open);$('.browse-view',content())?.classList.toggle('filters-open',open);route.params.filtersOpen=open;};
    if($('#browsePhoneFilters'))$('#browsePhoneFilters').onclick=()=>$('#browseFiltersToggle').click();
    // Phone: the «Anime y cartoons» chip opens Anime showing both; that is the default, not an active filter.
    const phoneAnimeBoth=category.id==='anime'&&Boolean(document.body?.classList?.contains?.('platform-android'))&&!tvInterface()&&Number(globalThis.innerWidth)<=760;
    for(const [selId,val] of [['browseSubtype',params.subtype??(phoneAnimeBoth?'all':'')],['browseGenre',params.genre],['browseYear',params.year],['browseQuality',params.quality],['browseOrder',params.order||'source']]){const el=$('#'+selId);if(el)el.value=val||'';}
    const hasQualityMetadata=family.some(item=>item.resolutions||(item.qualities||[]).some(quality=>quality.name));
    if(!hasQualityMetadata){const quality=$('#browseQuality');if(quality){quality.value='';quality.disabled=true;if(quality.options?.[0])quality.options[0].textContent='Consultar en cada episodio';quality.title='La fuente informa la calidad al consultar cada episodio.';}}
    const key=NebulaCore.browseKey;
    const refreshFilterOptions=()=>{
      const curFamily=allBrowseItems.filter(item=>NebulaCore.catalogCategory(item)===category.id||(category.id==='anime'&&$('#browseSubtype')?.value==='all'&&NebulaCore.catalogCategory(item)==='cartoons'));
      const curGenres=[...new Set(curFamily.flatMap(NebulaCore.catalogGenres))];
      const gSel=$('#browseGenre');
      if(gSel){
        const prevG=gSel.value;
        gSel.innerHTML=[['','Todos los géneros'],...curGenres.sort((a,b)=>genreLabel(a).localeCompare(genreLabel(b),'es')).map(value=>[value,genreLabel(value)])].map(([k,t])=>`<option value="${esc(k)}">${esc(t)}</option>`).join('');
        gSel.value=curGenres.includes(prevG)?prevG:'';
      }
      const curYears=[...new Set(curFamily.map(item=>String(item.year||'').slice(0,4)).filter(y=>/^\d{4}$/.test(y)))].sort().reverse();
      const ySel=$('#browseYear');
      if(ySel){
        const prevY=ySel.value;
        ySel.innerHTML=[['','Todos los años'],...curYears.map(v=>[v,v])].map(([k,t])=>`<option value="${esc(k)}">${esc(t)}</option>`).join('');
        ySel.value=curYears.includes(prevY)?prevY:'';
      }
    };
    function draw(){
      if(currentRoute!==route)return;
      const favorites=Store.favorites||[];
      const historyMap=new Map();for(const item of [...(Store.resumeList||[]),...(Store.watchedTitlesList||[])]){const k=key(item),at=Number(item.updatedAt||item.at)||0;const previous=historyMap.get(k);if(!previous||at>previous.at)historyMap.set(k,{item,at});}
      const history=[...historyMap.values()].sort((a,b)=>b.at-a.at).map(entry=>key(entry.item));
      const preferenceItems=favorites.map(item=>API.findCatalogItem(item.type,item.id,item)||item);
      const preferredGenres=[...new Set(preferenceItems.flatMap(NebulaCore.catalogGenres))];
      const rowKeys=predicate=>recommendationRows.filter(predicate).flatMap(row=>row.items||[]).map(key);
      const options={category:category.id,subtype:$('#browseSubtype')?.value||'',genre:$('#browseGenre').value,year:$('#browseYear').value,quality:$('#browseQuality').value,order:$('#browseOrder').value,collection,favoriteKeys:favorites.map(key),historyKeys:history,popularKeys:rowKeys(row=>/populares/i.test(row.title)),recommendedKeys:rowKeys(row=>/tendencias/i.test(row.title)),preferredGenres};
      let result=NebulaCore.browseCatalog(allBrowseItems,options);
      if(['rating','rating-asc','year','title'].includes(options.order))result=NebulaCore.orderItems(result,options.order);
  
      let crossCategoryNotice='';
      if(!result.length&&!['anime','cartoons'].includes(category.id)&&(collection==='history'||collection==='favorites')){
        const targetKeys=collection==='history'?history:favorites.map(key);
        const crossMatches=allBrowseItems.filter(item=>targetKeys.includes(key(item)));
        if(crossMatches.length){
          result=crossMatches.sort((a,b)=>targetKeys.indexOf(key(a))-targetKeys.indexOf(key(b)));
          crossCategoryNotice=' Mostrando tus títulos de todas las categorías.';
        }
      }
      Object.assign(route.params,{...options,favoriteKeys:undefined,historyKeys:undefined,popularKeys:undefined,recommendedKeys:undefined,preferredGenres:undefined,page});
      const descriptions={recent:'Orden de incorporación a la fuente.',updated:'Actualizaciones informadas por la fuente.', 'for-you':'Títulos con géneros de tus favoritos, sin incluir los que ya viste.',recommended:'Tendencias de TMDB que también están en tus fuentes.',popular:'Populares de TMDB que también están en tus fuentes.',history:'Últimas reproducciones y títulos marcados como vistos.',favorites:'Tus favoritos, del más reciente al más antiguo.'};
      $('#browseExplanation').textContent=descriptions[collection]+crossCategoryNotice+(!hasQualityMetadata&&family.length?' La calidad y el idioma se consultan en cada episodio.':options.quality?' Se filtran títulos cuya fuente informa esta calidad o idioma.':'');
      const displayed=result.slice(0,page*60);
      const activeFilters=[options.subtype,options.genre,options.year,options.quality,options.order&&options.order!=='source'?options.order:''].filter(Boolean).length;
      if($('#browseFiltersToggle'))$('#browseFiltersToggle').innerHTML=`${icon('sliders')}Filtros y orden${activeFilters?` (${activeFilters})`:''}<svg class="icon browse-filter-chevron" aria-hidden="true"><use href="#i-chevron"/></svg>`;
      // Canvas «Tablet · Explorar»: el filtro elegido se distingue con borde claro y texto en negrita.
      [['#browseSubtype',options.subtype],['#browseGenre',options.genre],['#browseYear',options.year],['#browseQuality',options.quality],['#browseOrder',options.order&&options.order!=='source'?options.order:'']].forEach(([selector,value])=>$(selector)?.classList.toggle('filter-active',Boolean(value)));
      // Resumen del celular: lista elegida y filtros activos («Recientes · Acción»).
      const phoneFilterCount=activeFilters-(phoneAnimeBoth&&options.subtype==='all'?1:0)+(collection!=='recent'?1:0);
      const qualityLabel=options.quality?($('#browseQuality')?.selectedOptions?.[0]?.textContent||options.quality):'';
      if($('#browseSummary'))$('#browseSummary').textContent=[(collections.find(([value])=>value===collection)||[])[1]||'',options.genre?genreLabel(options.genre):'',options.year||'',qualityLabel].filter(Boolean).join(' · ');
      if($('#browseSummaryClear'))$('#browseSummaryClear').hidden=!phoneFilterCount;
      if($('#browsePhoneFilters'))$('#browsePhoneFilters').innerHTML=`${icon('sliders')}<span>Filtros${phoneFilterCount?` · ${phoneFilterCount}`:''}</span>`;
      $('#browseCount').textContent='Resultados actualizados.';
      let message='No hay títulos con estos filtros. Prueba otra categoría o limpia los filtros.';
      if(!allBrowseItems.some(item=>NebulaCore.catalogCategory(item)===category.id))message='Tus fuentes todavía no incluyen títulos identificados en esta categoría.';
      else if(collection==='for-you'&&!preferredGenres.length)message='Agrega favoritos para descubrir títulos de sus géneros.';
      else if(['popular','recommended'].includes(collection)&&recommendationsLoading)message='Consultando las listas de TMDB…';
      else if(['popular','recommended'].includes(collection)&&recommendationsFailed)message='No se pudo consultar TMDB. Puedes seguir explorando Recientes.';
      else if(collection==='favorites')message='No hay favoritos en esta categoría con estos filtros.';
      else if(collection==='history')message='Todavía no hay reproducciones o títulos vistos en esta categoría con estos filtros.';
      const filteredOut=message.startsWith('No hay títulos con estos filtros');
      $('#browseEmpty').innerHTML=result.length?'':filteredOut?stateMessage({art:'filter',title:'Sin títulos para este filtro',detail:message,actions:phoneFilterCount?[{id:'browseEmptyClear',label:'Limpiar filtros',primary:true}]:[]}):emptyState('🎬',message);
      if($('#browseEmptyClear'))$('#browseEmptyClear').onclick=()=>{collection='recent';$('#browseReset').click();};
      $('#browseGrid').innerHTML=displayed.map(item=>posterCard(item)).join('');
      const hasMoreToShow=displayed.length<result.length||(xuperHasMore&&collection==='recent');
      $('#browseMore').hidden=!hasMoreToShow;
      $('#browseMore').disabled=xuperLoading;
      $('#browseMore').textContent=xuperLoading?'Cargando más…':'Mostrar más';
      $$('[data-collection]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.collection===collection)));
      wirePosters();
    }
    for(const id of ['browseSubtype','browseGenre','browseYear','browseQuality','browseOrder']){const select=$('#'+id);if(select)select.onchange=()=>{page=1;draw();};}
    $$('[data-collection]').forEach(button=>button.onclick=()=>{collection=button.dataset.collection;page=1;draw();});
    $('#browseReset').onclick=()=>{for(const id of ['browseSubtype','browseGenre','browseYear','browseQuality'])if($('#'+id))$('#'+id).value=id==='browseSubtype'&&phoneAnimeBoth?'all':'';$('#browseOrder').value='source';page=1;draw();};
    if($('#browseSummaryClear'))$('#browseSummaryClear').onclick=()=>{collection='recent';$('#browseReset').click();};
    $('#browseMore').onclick=async()=>{
      const curResult=NebulaCore.browseCatalog(allBrowseItems,{category:category.id,subtype:$('#browseSubtype')?.value||'',genre:$('#browseGenre').value,year:$('#browseYear').value,quality:$('#browseQuality').value,order:$('#browseOrder').value,collection,favoriteKeys:(Store.favorites||[]).map(key),historyKeys:[],popularKeys:[],recommendedKeys:[],preferredGenres:[]});
      if(page*60<curResult.length){page++;draw();return;}
      if(xuperHasMore&&!xuperLoading&&typeof API.loadXuperBrowse==='function'){
        xuperLoading=true;draw();
        try{
          xuperPage++;
          const res=await API.loadXuperBrowse(category.id,xuperPage);
          if(currentRoute!==route)return;
          xuperHasMore=Boolean(res?.hasMore);
          if(res?.items?.length){xuperExtraItems=xuperExtraItems.concat(res.items);allBrowseItems=mergeCatalogWithXuper(catalog.items,xuperExtraItems);applyRatings(allBrowseItems);refreshFilterOptions();}
          page++;
        }finally{xuperLoading=false;draw();}
      }
    };
    if($('#browseRetry'))$('#browseRetry').onclick=()=>{API.invalidate();renderBrowse(route.params);};
    draw();
    if(typeof API.loadXuperBrowse==='function'){
      const extraCalls=[API.loadXuperBrowse(category.id,1)];
      if(category.id==='anime')extraCalls.push(API.loadXuperBrowse('cartoons',1));
      Promise.allSettled(extraCalls).then(batches=>{
        if(currentRoute!==route)return;
        const mainRes=batches[0]?.status==='fulfilled'?batches[0].value:null;
        const cartRes=batches[1]?.status==='fulfilled'?batches[1].value:null;
        xuperHasMore=Boolean(mainRes?.hasMore);
        const incoming=[...(mainRes?.items||[]),...(cartRes?.items||[])];
        if(incoming.length){
          xuperExtraItems=incoming;
          allBrowseItems=mergeCatalogWithXuper(catalog.items,xuperExtraItems);
          applyRatings(allBrowseItems);
          refreshFilterOptions();
          draw();
        }
      }).catch(()=>{});
    }
    API.homeRows().then(rows=>{recommendationRows=rows;recommendationsLoading=false;if(['popular','recommended'].includes(collection))draw();}).catch(()=>{recommendationsLoading=false;recommendationsFailed=true;if(['popular','recommended'].includes(collection))draw();});
  }

  /* Fila con pocos títulos: tarjeta ancha con progreso y tiempo restante. */
function resumeWideRow(items) {
  return `<div class="row-head"><h2>Seguir viendo</h2></div><div class="resume-row">${resumeCards(items)}</div>`;
}
function resumeCards(items) {
  return items.map((it) => {
    let meta = {};
    try { meta = API.findCatalogItem(it.type, it.id) || {}; } catch {}
    // Celular: el reproductor guarda el título como «Serie — T1·E1 (Calidad)»; la tarjeta ya dice temporada y episodio abajo.
    const phoneCard = Boolean(document.body?.classList?.contains?.('platform-android')) && !tvInterface();
    const title = (phoneCard && it.type === 'tv' && it.season ? String(it.title || '').replace(/\s+—\s+T\d+·E\d+(?:\s*\([^)]*\))?\s*$/, '') : it.title) || meta.title || 'Sin título';
    const poster = it.poster || meta.urlImage || '';
    const pct = it.duration ? Math.max(2, Math.min(100, Math.round((it.position / it.duration) * 100))) : 0;
    const left = it.duration ? Math.max(1, Math.round((it.duration - it.position) / 60)) : 0;
    const label = it.type === 'tv' && it.season ? 'T' + it.season + '·E' + it.episode : '';
    return `<button class="resume-card" type="button" data-nav-key="resume:${esc(it.type)}:${esc(String(it.id))}:${it.season || 0}:${it.episode || 0}" data-resume-type="${esc(it.type)}" data-resume-id="${esc(String(it.id))}" data-resume-season="${it.season || 0}" data-resume-episode="${it.episode || 0}">
      <span class="resume-card-art">${poster ? `<img alt="" loading="lazy" decoding="async" width="96" height="144" src="${esc(poster)}"/>` : ''}<span class="resume-card-play"><svg class="icon" aria-hidden="true"><use href="#i-play"/></svg></span></span>
      <span class="resume-card-body">
        <span class="resume-card-title">${esc(title)}</span>
        <span class="resume-card-meta">${label ? esc(label) + ' · ' : ''}${left ? 'Quedan ' + left + ' min' : 'Continuar'}</span>
        <span class="resume-card-ctx">${it.type === 'tv' && it.season ? `Temporada ${Number(it.season)} · Episodio ${Number(it.episode) || 1}` : it.type === 'tv' ? 'Serie' : 'Película'}</span>
        <span class="resume-card-bar" aria-hidden="true"><span style="width:${pct}%"></span></span>
        <span class="resume-card-left">${left ? 'Quedan ' + left + ' min' : 'Continuar'}</span>
      </span>
    </button>`;
  }).join('');
}

// Phone home rows (canvas «Inicio»): «En cartelera 24», the short name and the count; «/ estrenos» stays on desktop.
function rowTitleParts(title) {
  const [main, ...rest] = String(title).split(' / ');
  return esc(main) + (rest.length ? `<span class="row-title-alt"> / ${esc(rest.join(' / '))}</span>` : '');
}
function homeRow(title, items, isResume = false) {
    if (!items || !items.length) return '';
    return `
      <div class="row-head"><h2>${rowTitleParts(title.replace(/^[^\p{L}\p{N}]+/u, ''))}<span class="row-count" aria-hidden="true">${items.length}</span></h2></div>
      <div class="row-scroll">
        ${items.map((it) => posterCard(it, isResume)).join('')}
      </div>`;
  }

  function compactResolutionBadges(it) {
    const rawList = [
      ...(it.qualities || []).map((q) => q.name || ''),
      String(it.resolutions || ''),
    ].join(' ').replace(/\b(?:4k|2160p?)\s+none\b/gi, '');
    const found = [];
    const push = (label, cls = '') => {
      if (!found.some((x) => x.label === label)) found.push({ label, cls });
    };
    if (/\b(?:4K|UHD|2160p?)\b/i.test(rawList)) push('4K', 'v');
    if (/\b1080p?\b/i.test(rawList)) push('1080', '');
    if (/\b720p?\b/i.test(rawList)) push('720', '');
    if (/\b480p?\b/i.test(rawList)) push('480', '');
    if (!found.length && /\b(?:CAM|TS|HDTC)\b/i.test(rawList)) push('CAM', '');
    return found.slice(0, 3).map((b) => `<span class="q-badge${b.cls ? ' ' + b.cls : ''}">${b.label}</span>`).join('');
  }

  function posterCategoryBadge(it) {
    const cat = NebulaCore.catalogCategory(it);
    if (cat === 'anime') return '<span class="poster-cat-badge" aria-hidden="true">😊</span>';
    if (cat === 'doramas') return '<span class="poster-cat-badge" aria-hidden="true">🎭</span>';
    if (cat === 'telenovelas') return '<span class="poster-cat-badge" aria-hidden="true">👥</span>';
    if (cat === 'duanju') return '<span class="poster-cat-badge" aria-hidden="true">📱</span>';
    if (cat === 'series' || it.type === 'tv') return '<span class="poster-cat-badge" aria-hidden="true">📺</span>';
    return '';
  }

  /* Fondos de ficha: el póster (ya en caché por la tarjeta) se ve al instante y el fondo grande se funde encima
     al terminar de cargar. Va desenfocado y al 24 % de brillo, así que w780 basta (antes w1280). */
  const loadedArt = new Set();
  const detailArt = url => String(url || '').replace(/\/t\/p\/(?:w1280|original)\//, '/t/p/w780/');
  function backdropMarkup(backdrop, poster) {
    const hi = detailArt(backdrop), low = String(poster || '');
    const layered = Boolean(hi) && hi !== low;
    const style = [low ? `background-image:url('${esc(low)}')` : (!layered && hi ? `background-image:url('${esc(hi)}')` : ''), layered ? `--backdrop:url('${esc(hi)}')` : ''].filter(Boolean).join(';');
    return `<div class="backdrop${layered ? ' has-art' : ''}${layered && loadedArt.has(hi) ? ' is-loaded' : ''}"${layered ? ` data-art="${esc(hi)}"` : ''}${style ? ` style="${style}"` : ''}></div>`;
  }
  function rememberArt(url) { if (loadedArt.size > 300) loadedArt.clear(); loadedArt.add(url); }
  function wireBackdrops(root = content()) {
    if (typeof Image !== 'function') return;
    for (const node of $$('.backdrop.has-art:not(.is-loaded)', root)) {
      const url = node.dataset.art;
      if (!url) continue;
      if (loadedArt.has(url)) { node.classList.add('is-loaded'); continue; }
      const image = new Image();
      image.decoding = 'async';
      image.onload = () => { rememberArt(url); if (node.isConnected) node.classList.add('is-loaded'); };
      image.src = url;
    }
  }
  /* Precarga del fondo al apuntar o enfocar una tarjeta (~150 ms): al abrir la ficha ya está en caché. */
  const artPrefetch = (() => {
    const requested = new Set(), queue = [], timers = new WeakMap();
    let running = 0;
    function pump() {
      while (running < 2 && queue.length) {
        const url = queue.shift();
        running++;
        const image = new Image();
        image.decoding = 'async';
        const finish = () => { running--; pump(); };
        image.onload = () => { rememberArt(url); finish(); };
        image.onerror = finish;
        image.src = url;
      }
    }
    function request(url) {
      if (!url || requested.has(url) || loadedArt.has(url)) return;
      if (requested.size > 300) requested.clear();
      requested.add(url); queue.push(url);
      if (queue.length > 6) requested.delete(queue.shift());
      pump();
    }
    return {
      schedule(card) {
        const url = card?.dataset?.backdrop;
        if (!url || typeof Image !== 'function') return;
        clearTimeout(timers.get(card));
        timers.set(card, setTimeout(() => { timers.delete(card); if (card.isConnected !== false) request(url); }, 150));
      },
      cancel(card) { clearTimeout(timers.get(card)); timers.delete(card); },
    };
  })();

  // «2026 · Película» in parts, so the phone can show «2026» (Explorar) or «Película · 2026» (Biblioteca) like the boards.
  function posterMetaParts(year, kind) {
    return `${year ? `<span class="pm-year">${esc(year)}</span>` : ''}${year && kind ? '<span class="pm-sep"> · </span>' : ''}${kind ? `<span class="pm-kind">${esc(kind)}</span>` : ''}`;
  }
  function posterCard(it, isResume = false) {
    const catalogItem = API.findCatalogItem(it.type, it.id,it);
    if (catalogItem) it = { ...it, ...catalogItem, rating: NebulaUI.ratingValue(catalogItem.rating,it.rating), position: it.position, duration: it.duration, season: it.season, episode: it.episode };
    const key = `${it.type}:${it.id}`;
    const typeLabel=it.type==='tv'?(isResume&&it.season&&it.episode?`Serie · T${it.season}·E${it.episode}`:'Serie'):it.type==='movie'?'Película':'Título';
    const fav = Store.isFavorite(it.type, it.id);
    const seen = Store.isWatched(it.type, it.id) || (it.type === 'tv' && false);
    const badges = compactResolutionBadges(it);
    const score = NebulaUI.ratingValue(it.rating);
    const topFlags = [];
    const rawRes = String(it.resolutions || '');
    if (it.showSpainFlag || /\bCAST\b/i.test(rawRes)) topFlags.push('<span class="flag-circle" aria-label="Castellano">🇪🇸</span>');
    else if (it.showMxFlag || /\b(?:LAT|DUAL)\b/i.test(rawRes)) topFlags.push('<span class="flag-circle" aria-label="Latino">🇲🇽</span>');
    else if (it.showSubFlag || /\bSUB\b/i.test(rawRes)) topFlags.push('<span class="flag-circle" aria-label="Subtitulado">🇺🇸</span>');
    if (fav) topFlags.push('<span class="flag-circle fav" aria-label="En Mi lista">♥</span>');
    if (seen) topFlags.push('<span class="flag-circle seen" aria-label="Visto">✓</span>');
    const resumePct = isResume && it.duration ? Math.min(100, Math.round((it.position / it.duration) * 100)) : 0;
    const yearStr = it.year ? String(it.year).slice(0, 4) : '';
    const resumeEpStr = isResume && it.type === 'tv' && it.season && it.episode ? ` · T${it.season}E${it.episode}` : '';
    const img = it.poster
      ? `<img loading="lazy" decoding="async" width="342" height="513" src="${esc(it.poster)}" alt=""/>`
      : '';
    const art = detailArt(it.backdrop);
    return `
      <div class="poster" role="button" tabindex="0"${art && art !== it.poster ? ` data-backdrop="${esc(art)}"` : ''} data-nav-key="${esc(key)}" aria-label="${esc(it.title+' · '+typeLabel+(yearStr?' · '+yearStr:''))}" data-type="${esc(it.type)}" data-id="${esc(it.id)}" data-kind="${esc(it.kind || '')}" data-catalog="${esc(it.catalogUrl || '')}" data-source="${esc(it.source || '')}" data-resume="${isResume ? '1' : ''}" data-season="${esc(it.season || 0)}" data-episode="${esc(it.episode || 0)}">
        <div class="poster-art">${img}<div class="ph ${it.poster?'hidden':''}" aria-hidden="true"><svg class="icon" aria-hidden="true"><use href="#i-play"/></svg></div>
        ${posterCategoryBadge(it)}
        <span class="poster-play"><svg class="icon" aria-hidden="true"><use href="#i-play"/></svg></span>
        ${topFlags.length ? `<div class="poster-flags">${topFlags.join('')}</div>` : ''}
        ${resumePct ? `<div class="progress-bar"><div style="width:${resumePct}%"></div></div>` : ''}
        ${score ? `<span class="poster-score" aria-hidden="true"><span class="star">★</span>${score.toFixed(1)}</span>` : ''}
        </div><div class="poster-info"><div class="q-badges">${score ? `<span class="q-badge rating">★ ${score.toFixed(1)}</span>` : ''}${badges || ''}</div>
        <div class="p-title"><span class="poster-name">${esc(it.title)}${yearStr ? ` (${esc(yearStr)})` : ''}${esc(resumeEpStr)}</span></div>
        <div class="poster-title-plain" aria-hidden="true">${esc(it.title)}</div><div class="poster-rating-line${score ? '' : ' no-score'}" aria-hidden="true">${score ? `<span class="star">★</span> ${score.toFixed(1)}` : 'Sin puntaje'}</div><div class="poster-meta" aria-hidden="true">${posterMetaParts(yearStr, isResume && resumeEpStr ? resumeEpStr.replace(/^ · /, '') : (it.type === 'tv' ? 'Serie' : it.type === 'movie' ? 'Película' : ''))}</div></div>
      </div>`;
  }

  /* Completa el puntaje de lo que está en pantalla, de a poco y con caché. */
  const visibleRatings=VisibleRatings.create({
    load:item=>API.ratingFor(item.type,item.id),
    remember:(item,score)=>rememberRating(item.type,item.id,score),
    read:item=>ratingCache[item.type+':'+item.id],
    connected:card=>document.contains(card),
    observe:typeof IntersectionObserver==='function'?(callback,root)=>new IntersectionObserver(callback,{root,rootMargin:'160px'}):null,
    paint:(card,score)=>{
      let holder=card.querySelector('.q-badges');
      if(!holder){holder=document.createElement('div');holder.className='q-badges';card.querySelector('.poster-info')?.prepend(holder);}
      if(!holder)return;
      let badge=holder.querySelector('.rating');
      if(!badge){badge=document.createElement('span');badge.className='q-badge rating';holder.prepend(badge);}
      badge.textContent='★ '+Number(score).toFixed(1);
      for(const duplicate of Array.from(holder.querySelectorAll('.rating')).slice(1))duplicate.remove();
    }
  });
  function enrichVisibleRatings(){visibleRatings.start($$('.poster[data-type]',content()),content());}

  function wirePosters() {
    $$('.poster').forEach((p) => {
      if (p.dataset.bound) return;
      p.dataset.bound = '1';
      const img = p.querySelector('.poster-art img');
      const ph = p.querySelector('.poster-art .ph');
      if (img && ph) {
        img.addEventListener('error', () => { img.classList.add('hidden'); ph.classList.remove('hidden'); }, { once: true });
      }
      p.addEventListener('keydown', event => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); p.click(); } });
      if (p.dataset.backdrop) {
        p.addEventListener('pointerenter', () => artPrefetch.schedule(p));
        p.addEventListener('focus', () => artPrefetch.schedule(p));
        p.addEventListener('pointerleave', () => artPrefetch.cancel(p));
        p.addEventListener('blur', () => artPrefetch.cancel(p));
      }
      p.addEventListener('click', () => {
        const { type, id, kind, catalog } = p.dataset;
        if (type === 'local' && p.dataset.source) { Player.open({ type, id, title: p.getAttribute('aria-label'), kind: 'stream', url: p.dataset.source }); return; }
        if (kind === 'nebula' || id.startsWith('nebula:')) { go(type==='tv'?'tv':'movie', {id}); return; }
        if (p.dataset.resume === '1') { resumeItem(type, id, Number(p.dataset.season), Number(p.dataset.episode), { trigger: p }); return; }
        if (kind === 'archive' || kind === 'jellyfin') {
          go('source', { kind, id });
        } else if (kind === 'catalog' || catalog) {
          go('catalog', { id, catalogUrl: catalog });
        } else {
          go(type === 'tv' ? 'tv' : 'movie', { id });
        }
      });
    });
    enrichVisibleRatings();
  }

  /** Continuar/Reproducir desde Inicio o la ficha. `direct:false` deja que el reproductor pregunte si continuar. */
  async function resumeItem(type,id,season,episode,options={}){
    if(typeof NebulaAccount!=='undefined'&&type!=='local'&&!NebulaAccount.hasAccess()){
      const unlocked=await NebulaAccount.ensureAccess();
      if(!unlocked)return;
    }
    const token=resumeGate.begin(`${type}:${id}:${season||0}:${episode||0}`);if(token===null)return;
    const trigger=typeof options?.trigger?.setAttribute==='function'?options.trigger:null;
    trigger?.setAttribute('aria-busy','true');
    const launch=showLaunch({...launchInfo(type,id,season,episode),onCancel:()=>resumeGate.cancel()});
    try{return await resumeItemWork(type,id,season,episode,token,options?.direct!==false);}
    finally{resumeGate.complete(token);hideLaunch(launch);trigger?.removeAttribute?.('aria-busy');}
  }
  async function resumeItemWork(type, id, season, episode, token, direct=true) {
    const route = currentRoute;
    try {
      const saved = Store.getResume(type, id, season, episode);
      if(saved&&['archive','jellyfin'].includes(saved.kind)){
        const detail=saved.kind==='archive'?await API.archiveDetail(id):await API.jellyfinDetail(id);
        const result=await API.sourcesFor(detail);if((currentRoute!==route||!resumeGate.current(token)))return;
        const selected=(saved.source&&(result.allSources?.find(s=>s.url===saved.source)||result.sources.find(s=>s.url===saved.source)))||result.sources[0];if(selected)return playVerified({type,id,title:detail.title,poster:detail.poster,backdrop:detail.backdrop,kind:'stream',mediaKind:saved.kind,url:selected.url,urls:result.allSources,resumeDirect:direct});
      }
      // Si el catálogo ya está en memoria no se espera otra copia: se actualiza en segundo plano.
      await API.loadCatalogs(Store.settings.catalogUrls,{allowStale:true});
      if(!resumeGate.current(token)||currentRoute!==route)return;
      const item = API.findCatalogItem(type, id);
      if (item?.type === 'tv') {
        const listing=await API.episodesFor(item);item.raw={...item.raw,episodes:listing.episodes};
        if ((currentRoute !== route||!resumeGate.current(token))) return;
        if(!Number(season)||!Number(episode)){
          // «Reproducir» sin progreso guardado: primer episodio con fuente.
          const first=(listing.episodes||[]).find(ep=>pickEpisodeUrls([ep],ep.episode).length);
          if(first){season=Number(first.season);episode=Number(first.episode);}
        }
        const episodes = (item.raw.episodes || []).filter(ep => Number(ep.season) === Number(season));
        // Las URLs del listado ya vienen registradas: no hace falta volver a consultar las fuentes.
        const urls=pickEpisodeUrls(episodes,episode);
        const preferred=(saved?.source&&urls.find(u=>u.url===saved.source))||urls[0];
        if (preferred) return openEpisode(item, season, episode, preferred.url, preferred.name, episodes,direct);
      }
      if ((currentRoute !== route||!resumeGate.current(token))) return;
      if(type==='movie'){
        const detail=item||await API.movieDetail(id);
        if(!detail){go('movie',{id});return;}
        const result=await API.sourcesFor(detail);
        if((currentRoute!==route||!resumeGate.current(token)))return;
        const selected=NebulaCore.choosePlaybackSource(result,saved?.source);
        if(selected)return playVerified({type,id,title:detail.title,originalTitle:detail.originalTitle,year:detail.year,poster:detail.poster,backdrop:detail.backdrop,kind:'stream',url:selected.url,urls:result.allSources,resumeDirect:direct});
        toast(CatalogSources.availability.message(result));
        go(item?'catalog':'movie',{id,catalogUrl:item?.catalogUrl});return;
      }
      if (saved?.source) {
        if (!(await ensurePlaybackAccess({ type }))) return;
        return Player.open({ type, id, title: saved.title, poster: saved.poster, kind: saved.kind || 'stream', url: saved.source, season, episode, resumeDirect: direct });
      }
      toast('Abre el título y elige una fuente para continuar');
      if (item) go('catalog', { id, catalogUrl: item.catalogUrl }); else go(type === 'tv' ? 'tv' : 'movie', { id });
    } catch (error) { toast('No se pudo reanudar: ' + publicMessage(error.message)); }
  }

  function wireCarouselArrows() {
    // Navegación con rueda horizontal (optimización de carrusel)
    $$('.row-scroll').forEach((row) => {
      row.addEventListener('wheel', (e) => {
        if (!e.shiftKey) return;
        if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
          row.scrollLeft += e.deltaY;
          e.preventDefault();
        }
      }, { passive: false });
    });
  }

  function genreSection() {
    return `<div class="search-history" id="genreChips" role="group" aria-label="Géneros">${NebulaCore.GENRES.map(genre=>`<button data-genre-id="${genre.id}" aria-pressed="false">${esc(genre.label)}</button>`).join('')}</div>
      <div id="genreResults"></div>`;
  }

  async function loadGenre(genreId) {
    const route=currentRoute;
    route.params.genre=genreId;
    const box = $('#genreResults');
    if (!box) return;
    box.innerHTML = '<div class="row-scroll">' + '<div class="poster skeleton"></div>'.repeat(8) + '</div>';
    const request = ++genreRequest;
    $$('#genreChips button').forEach(button => { const selected = Number(button.dataset.genreId) === genreId; button.classList.toggle('sel', selected); button.setAttribute('aria-pressed', String(selected)); });
    const types=homeFilter==='all'?['movie','tv']:[homeFilter];
    const plans=types.map(type=>({type,...NebulaCore.genreRequest(genreId,type)}));
    const batches=await Promise.allSettled(plans.map(plan=>plan.id===null?Promise.resolve([]):API.byGenre(plan.type,plan.id,1)));
    if (request !== genreRequest || currentRoute!==route || !box.isConnected) return;
    const items=NebulaCore.orderItems(batches.flatMap((batch,index)=>batch.status==='fulfilled'?batch.value.filter(item=>item.type===plans[index].type).slice(0,14):[]),route.params.sort||'year');
    const notices=plans.map(plan=>plan.notice).filter(Boolean);
    const failures=batches.filter(batch=>batch.status==='rejected');
    if(failures.length)notices.push('No se pudieron consultar todas las fuentes. Puedes volver a elegir el género para reintentar.');
    box.innerHTML = `<div class="row-head"><h2>Resultados de ${esc(NebulaCore.GENRES.find(genre=>genre.id===genreId).label)}</h2></div>`+
      (notices.length?`<p class="source-notice" role="status">${esc(notices.join(' '))}</p>`:'')+
      (items.length?`<div class="grid">${items.map(it=>posterCard(it)).join('')}</div>`:NebulaUI.emptyMessage(failures.length?'No se pudo completar la consulta':'Sin títulos para este filtro',notices.length?'':'Prueba otro género o tipo de título.'));
    wirePosters();
  }

  /* ============================ Buscar ============================ */
  async function renderSearch(params = {}) {
    const route=currentRoute;
    content().innerHTML = `
      <div class="view search-view">
        <header class="page-heading sr-only"><h1>Buscar</h1></header>
        <label class="search-phone-title" for="searchInput" aria-hidden="true">Buscar</label>
        <div class="search-bar">
          <svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>
          <input id="searchInput" type="search" enterkeyhint="search" aria-label="Buscar películas, series o personas" placeholder="Buscar películas, series o personas…" autofocus />
          <button type="button" class="btn-ghost search-clear hidden" id="searchClear" aria-label="Limpiar búsqueda" title="Limpiar búsqueda">×</button>
          ${Platform.voiceSearchAvailable?`<button type="button" class="btn-ghost search-voice" id="searchVoice" aria-label="Buscar por voz" title="Buscar por voz">${icon('mic')}</button>`:''}
          <select id="searchMode" aria-label="Tipo de búsqueda">
            <option value="multi">Todo</option>
            <option value="title">Título</option>
            <option value="person">Persona</option>
            <option value="tmdbId">TMDb ID</option>
          </select>
        </div>
        <div class="search-modes" role="radiogroup" aria-label="Tipo de búsqueda">${[['multi','Todo'],['title','Título'],['person','Persona'],['tmdbId','TMDb ID']].map(([value,label])=>`<button type="button" role="radio" data-mode="${value}" aria-checked="false">${label}</button>`).join('')}</div>
        <div class="search-history" id="searchHist"></div>
        <div id="searchResults"></div>
      </div>`;

    const input = $('#searchInput');
    const clearBtn = $('#searchClear');
    const modeSel = $('#searchMode');
    const voiceButton=$('#searchVoice');
    if(voiceButton)voiceButton.onclick=async()=>{
      if(voiceButton.disabled)return;
      voiceButton.disabled=true;voiceButton.setAttribute('aria-busy','true');
      try{
        const result=await Platform.voiceSearch(Store.settings.language);
        if(currentRoute!==route||!document.contains(input))return;
        if(result.cancelled)return;
        if(result.error){toast(result.error);return;}
        if(result.text){input.value=result.text;clearTimeout(debounce);syncClearBtn();runSearch(true);}
      }catch(error){if(currentRoute===route)toast(publicMessage(error.message)||'No se pudo abrir el dictado. Usa el teclado.');}
      finally{voiceButton.disabled=false;voiceButton.removeAttribute('aria-busy');if(document.contains(voiceButton))voiceButton.focus({preventScroll:true});}
    };
    if (params.mode) modeSel.value = params.mode;
    // Escritorio (EscritorioBuscar): el tipo de búsqueda como control segmentado; el select sigue siendo la fuente de verdad.
    const syncModes = () => $$('.search-modes [data-mode]').forEach(button => button.setAttribute('aria-checked', String(button.dataset.mode === modeSel.value)));
    $$('.search-modes [data-mode]').forEach(button => button.addEventListener('click', () => { if (modeSel.value === button.dataset.mode) return; modeSel.value = button.dataset.mode; modeSel.dispatchEvent(new Event('change')); }));
    modeSel.addEventListener('change', syncModes);
    syncModes();
    renderSearchHistory();
    const syncClearBtn = () => {
      const hasText = Boolean(input.value.trim().length);
      if (clearBtn) clearBtn.classList.toggle('hidden', !input.value.length);
      $('#searchHist')?.classList?.toggle?.('hidden', hasText);
      syncTopbarSearch(input.value);
    };

    let debounce = null;
    input.addEventListener('input', () => {
      syncClearBtn();
      clearTimeout(debounce);
      if (!input.value.trim()) {
        currentRoute.params = { q: '', mode: modeSel.value };
        renderSearchSuggestions();
        return;
      }
      debounce = setTimeout(() => runSearch(), API.SEARCH_DEBOUNCE_MS);
    });
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        clearTimeout(debounce);
        input.value = '';
        syncClearBtn();
        currentRoute.params = { q: '', mode: modeSel.value };
        renderSearchSuggestions();
        input.focus();
      });
    }
    modeSel.addEventListener('change',()=>runSearch());
    input.addEventListener('keydown', (e) => { if (e.key === 'Enter') runSearch(true); });

    if (params.q) { input.value = params.q; syncClearBtn(); return runSearch(); }
    syncClearBtn();
    renderSearchSuggestions();
  }

  async function renderSearchSuggestions() {
    const route = currentRoute;
    const box = $('#searchResults');
    if (!box) return;
    try {
      const cats = await API.loadCatalogs(Store.settings.catalogUrls).catch(() => ({ items: [] }));
      if (currentRoute !== route || currentView !== 'search' || $('#searchInput')?.value.trim()) return;
      const items = (cats.items || []).slice(0, 16);
      if (items.length) {
        box.innerHTML = `<div class="row-head"><h2>Recientes en catálogo</h2></div><div class="grid">${items.map(it => posterCard(it)).join('')}</div>`;
        wirePosters();
      } else {
        box.innerHTML = '';
      }
    } catch {
      if (box && !$('#searchInput')?.value.trim()) box.innerHTML = '';
    }
  }

  function renderSearchHistory() {
    const box = $('#searchHist');
    const hist = Store.searchHistory.slice(0, 8); // SEARCH_HISTORY_VISIBLE_LIMIT
    box.innerHTML = (hist.length ? '<span class="search-hist-label">Recientes<span class="search-hist-colon">:</span></span>' : '') +
      // Canvas «Escritorio · Buscar sin resultados»: en el escritorio cada reciente lleva su × para quitarlo solo a él.
      hist.map((h) => {
        const chip = `<button data-q="${esc(h)}"><svg class="icon" aria-hidden="true"><use href="#i-clock"/></svg>${esc(h)}</button>`;
        return desktopShell() ? `<span class="search-hist-item">${chip}<button type="button" class="search-hist-remove" data-remove="${esc(h)}" aria-label="Quitar «${esc(h)}» de recientes" title="Quitar de recientes">×</button></span>` : chip;
      }).join('') +
      (hist.length ? '<button data-clear="1" aria-label="Borrar búsquedas recientes" title="Borrar búsquedas recientes"><span class="search-hist-x" aria-hidden="true">×</span><span class="search-hist-clear" aria-hidden="true">Borrar recientes</span></button>' : '');
    $$('button[data-q]', box).forEach((b) => b.addEventListener('click', () => {
      $('#searchInput').value = b.dataset.q;
      $('#searchClear')?.classList.toggle('hidden', !b.dataset.q);
      syncTopbarSearch(b.dataset.q);
      runSearch();
    }));
    $$('button[data-remove]', box).forEach((b) => b.addEventListener('click', (event) => { event.stopPropagation(); Store.removeSearch?.(b.dataset.remove); renderSearchHistory(); }));
    const clr = $('button[data-clear]', box);
    if (clr) clr.addEventListener('click', () => { Store.clearSearchHistory(); renderSearchHistory(); });
  }

  async function runSearch(commit = false) {
    if(currentView!=='search'||!$('#searchInput')||!$('#searchMode'))return;
    const route=currentRoute,request=++searchRequest;
    const q = $('#searchInput').value.trim();
    $('#searchClear')?.classList.toggle('hidden', !q.length);
    syncTopbarSearch(q);
    const mode = $('#searchMode').value;
    currentRoute.params = { q, mode,shown:route.params.q===q&&route.params.mode===mode?route.params.shown||96:96 };
    const box = $('#searchResults');
    $('#content .search-view')?.classList?.remove?.('search-empty');
    if (!q.length) {
      renderSearchSuggestions();
      return;
    }
    if (q.length < API.SEARCH_MIN_CHARS) {
      box.innerHTML = `<div class="empty-state"><div class="big">🔍</div><div>Escribe al menos ${API.SEARCH_MIN_CHARS} caracteres</div></div>`;
      return;
    }
    // The phone lists results as rows (canvas «Buscar»), so its skeleton is rows too.
    const phoneRows = Boolean(document.body?.classList?.contains?.('platform-android')) && !tvInterface() && Number(globalThis.innerWidth) <= 760;
    box.innerHTML = phoneRows
      ? `<div class="search-skeleton" role="status" aria-label="Buscando">${'<div class="search-skel-row"><span class="skeleton search-skel-art"></span><span class="search-skel-text"><span class="skeleton search-skel-line"></span><span class="skeleton search-skel-line short"></span></span></div>'.repeat(5)}</div>`
      : '<div class="grid">' + '<div class="poster skeleton"></div>'.repeat(8) + '</div>';
    try {
      const { results, people, notice } = await API.search(q, mode);
      if (currentRoute!==route||request!==searchRequest || $('#searchInput')?.value.trim() !== q || $('#searchMode')?.value !== mode) return;
      if (commit) { Store.addSearch(q); renderSearchHistory(); }
      // App Android: el aviso llega como «archive: mensaje · otra: mensaje»; se quita el nombre interno de cada fuente y no se repite el mismo texto.
      const phoneNotice = Boolean(document.body?.classList?.contains?.('platform-android')) && !tvInterface();
      const cleanNotice = !notice ? '' : phoneNotice ? [...new Set(String(notice).split(' · ').map((part) => publicMessage(part).replace(/^[\w-]+:\s*/, '')))].join(' ') : publicMessage(notice).replace(/\bnebula:\s*/gi, '');
      let html = cleanNotice ? `<p class="source-notice">${esc(cleanNotice)}</p>` : '';
      if (people.length) {
        html += `<div class="row-head"><h2>Personas</h2></div><div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(220px,1fr))">
          ${people.slice(0, 10).map((p) => `
            <div class="person-result" role="button" tabindex="0" data-person="${p.id}" data-name="${esc(p.name)}">
              ${p.img ? `<img alt="" src="${esc(p.img)}" loading="lazy"/>` : '<div class="ph" style="width:52px;height:52px;border-radius:50%;background:var(--panel)"></div>'}
              <div><div style="font-weight:600">${esc(p.name)}</div><div style="color:var(--muted);font-size:11.5px">${esc(p.known || '')}</div></div>
            </div>`).join('')}</div>`;
      }
      if (results.length) {
        const limit=Math.max(96,Number(route.params.shown)||96);
        html += `<div class="row-head search-results-head"><h2>Resultados</h2></div><p class="search-count">${results.length === 1 ? '1 resultado' : `${results.length} resultados`}</p>
          <div class="grid" id="searchGrid">${results.slice(0, limit).map((it) => posterCard(it)).join('')}</div>${results.length > limit ? '<button class="btn" id="searchMore">Ver más resultados</button>' : ''}`;
      }
      if (!results.length && !people.length) {
        html += stateMessage({art:'search',title:`Sin resultados para “${q}”`,detail:mode==='tmdbId'?'Usa solo el número completo de TMDB. Una película y una serie pueden compartir número; se muestran por separado.':mode==='person'?'Prueba el nombre completo de la persona.':'Prueba el nombre original o busca por persona.',actions:['multi','title'].includes(mode)?[{id:'searchByPerson',label:'Buscar por persona',icon:'user'}]:[]});
      }
      box.innerHTML = html;
      // Canvas «Buscar · Sin resultados»: the phone brings back the search modes and the recent searches below the message.
      const nothing = !results.length && !people.length;
      $('#content .search-view')?.classList?.toggle?.('search-empty', nothing);
      if (nothing) $('#searchHist')?.classList?.remove?.('hidden');
      if($('#searchByPerson'))$('#searchByPerson').onclick=()=>{const select=$('#searchMode');if(select){select.value='person';select.dispatchEvent(new Event('change'));}};
      let shown = Math.max(96,Number(route.params.shown)||96);
      if ($('#searchMore')) $('#searchMore').onclick = () => {
        $('#searchGrid').insertAdjacentHTML('beforeend', results.slice(shown, shown + 96).map(item => posterCard(item)).join(''));
        shown += 96;
        route.params.shown=shown;
        if (shown >= results.length) $('#searchMore').remove();
        wirePosters();
      };
      wirePosters();
      $$('div[data-person]', box).forEach(d => {
        d.onclick = () => go('person', { id: d.dataset.person, name: d.dataset.name });
        d.onkeydown = event => { if (['Enter', ' '].includes(event.key)) { event.preventDefault(); d.click(); } };
      });
    } catch (e) {
      if(currentRoute!==route||request!==searchRequest)return;
      box.innerHTML = `<div class="empty-state"><div class="big">⚠️</div><div>Error: ${esc(e.message)}</div></div>`;
    }
  }

  async function renderPerson(params) {
    const route = currentRoute;
    content().innerHTML = '<div class="view"><header class="page-heading"><h1>' + esc(params.name || 'Filmografía') + '</h1><p>Películas y series en las que participa.</p></header><div id="personTitles">Cargando títulos…</div></div>';
    try {
      const items = await API.personTitles(params.id);
      if (currentRoute !== route) return;
      $('#personTitles').innerHTML = items.length ? '<div class="grid">' + items.map(item => posterCard(item)).join('') + '</div>' : emptyState('🎬', 'No hay títulos disponibles para esta persona.');
      wirePosters();
    } catch (error) { if (currentRoute === route) $('#personTitles').textContent = 'No se pudo cargar la filmografía: ' + publicMessage(error.message); }
  }

  /* ============================ Detalle ============================ */
  function sourceRank(source) {
    const label = String(source?.name || '').toUpperCase();
    const penalty = /\bTRIAL\b|\bPRUEBA\b/.test(label) ? -1 : 0;
    const matchK = label.match(/\b([248])\s*K\b/);
    if (matchK) return Number(matchK[1]) * 5400 + penalty;
    if (/\bUHD\b/.test(label)) return 21600 + penalty;
    const matchP = label.match(/\b([0-9]{3,4})\s*P?\b/);
    return (matchP ? Number(matchP[1]) : 0) * 10 + penalty;
  }

  function listPlayableSources(sources) {
    const seenUrls = new Set();
    const valid = [];
    for (const src of (sources || [])) {
      if (!src || !src.url) continue;
      const u = String(src.url).trim();
      if (!u || seenUrls.has(u)) continue;
      seenUrls.add(u);
      valid.push({ ...src, url: u, name: String(src.name || 'Original').replace(/\b(?:movieplus|xuper)\b/gi,'').replace(/^[\s·|:—–-]+|[\s·|:—–-]+$/g,'') || 'Original', providerId: src.providerId || ((u.startsWith('nebula://') || (!u.startsWith('nebula-source://') && /nebula/i.test(u)) || src.size === 'Fuente adicional') ? 'nebula' : 'primary') });
    }
    const salud = (source) => {
    const historial = (Store.settings.providerHealth || {})[source.providerId] || null;
    const total = historial ? (historial.ok || 0) + (historial.dead || 0) : 0;
    return total ? (historial.ok || 0) / total : 0.5;
  };
  valid.sort((a, b) => (sourceRank(b) - sourceRank(a)) || (salud(b) - salud(a)));
    const counts = new Map();
    for (const s of valid) {
      const key = s.name.toUpperCase();
      counts.set(key, (counts.get(key) || 0) + 1);
    }
    const indices = new Map();
    return valid.map((s) => {
      const key = s.name.toUpperCase();
      if ((counts.get(key) || 0) <= 1) return s;
      const idx = (indices.get(key) || 0) + 1;
      indices.set(key, idx);
      return { ...s, name: `${s.name} · Opción ${idx}` };
    });
  }

  // iOS (app web): el servidor que entrega los enlaces del catálogo solo responde a su propia app de Android, así que
  // Safari bloquea la consulta. En vez de un error con «Reintentar» que nunca va a funcionar, se explica qué pasa y qué
  // sigue sirviendo (tráiler, Mi lista y las otras apps).
  function iosSourcesNotice(){
    return '<section class="ios-sources-notice" role="status"><svg class="state-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg><div><strong>Reproducción no disponible en iPhone</strong><p>En iOS no se pueden cargar las fuentes de este catálogo. Puedes ver el tráiler y guardarlo en Mi lista para verlo en la app de Android, de TV o de escritorio.</p></div></section>';
  }
  function iosSourcesBlocked(qualities,additional){
    if(!Platform.isIos||qualities.length)return false;
    const providers=[...(additional.providers||[additional])];
    return CatalogSources.availability.aggregate([{providerId:'catalog',state:'unknown',sources:qualities},...providers]).warnings.length>0;
  }
  function sourceStatusMarkup(qualities,additional) {
    if(iosSourcesBlocked(qualities,additional))return iosSourcesNotice();
    const providers=[...(additional.providers||[additional])];
    const state=CatalogSources.availability.aggregate([{providerId:'catalog',state:'unknown',sources:qualities},...providers]);
    const offline=providers.filter(provider=>provider.state==='not_connected');
    if(qualities.length && !state.warnings.length)return '';
    if(qualities.length){
      const who='Una fuente';
      return `<span class="chip chip-muted" role="status" data-source-state="partial">${esc((who||'Una fuente')+' no respondió; las demás están disponibles.')}</span>`;
    }
    if(!state.warnings.length && offline.length){
      return `<span class="chip chip-muted" role="status" data-source-state="not_connected">${esc('La fuente adicional no está conectada. Reconéctala en Ajustes para ver más opciones.')}</span>`;
    }
    const text=CatalogSources.availability.message(state.warnings[0]||state);
    return `<span class="chip" role="status" data-source-state="${state.state}">${esc(publicMessage(text))}</span>${state.warnings.length?'<button class="btn" id="retrySources">Reintentar fuentes</button>':''}`;
  }
  // Canvas «Ficha · Sin fuentes»: why nothing plays yet, the alert as the main action and the retry for providers that failed.
  function noSourcePanel(qualities,additional){
    if(iosSourcesBlocked(qualities,additional))return iosSourcesNotice();
    const status=sourceStatusMarkup(qualities,additional);
    return `<section class="no-source-panel" aria-labelledby="noSourceTitle"><svg class="state-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg><h2 id="noSourceTitle">Todavía no hay una fuente confirmada</h2><p>Puedes ver el tráiler o pedir un aviso.</p>${Platform.availabilityAlerts?'<button class="btn primary" type="button" id="btnAvailabilityAlert">Avisarme cuando haya una fuente</button>':''}${status?`<div class="no-source-status">${status}</div>`:''}</section>`;
  }
  let availabilityNavigation=0;
  async function openAvailabilityTarget(target){
    const match=/^(movie|tv):([1-9]\d*)$/.exec(target||'');if(!match)return;
    const request=++availabilityNavigation;API.invalidate();try{await API.loadCatalogs(Store.settings.catalogUrls);}catch{}
    if(request!==availabilityNavigation)return;
    const item=API.findCatalogItem(match[1],Number(match[2]),{identities:[{providerId:'tmdb',id:match[2]}]});
    if(item?.catalogUrl)go('catalog',{id:item.id,catalogUrl:item.catalogUrl});else go(match[1],{id:Number(match[2])});
  }

  function wireDiscovery(detail,type,route,hasSource){
      const metadataId=(detail.identities||[]).find(value=>value.providerId==='tmdb')?.id||(/^\d+$/.test(String(detail.id))?detail.id:null);
      // Provider titles have no TMDB id: the title and year find it (API.tmdbMatch), as the canvas ficha shows genres and Recomendadas.
      const fromProvider=!metadataId&&detail.kind==='nebula';
      const discoveryId=metadataId?Promise.resolve(metadataId):fromProvider&&API.tmdbMatch?API.tmdbMatch(type,detail).catch(()=>null):Promise.resolve(null);
      if(API.detailDiscovery)discoveryId.then(found=>found&&currentRoute===route?API.detailDiscovery(type,found):null).then(extra=>{
        if(!extra||currentRoute!==route)return;
        const row=(label,items)=>items?.length?`<section class="detail-related"><div class="row-head"><h2>${esc(label)}</h2></div><div class="row-scroll">${items.map(item=>posterCard(item)).join('')}</div></section>`:'';
        const recommended=new Set((extra.recommendations||[]).map(value=>`${value.type}:${value.id}`));
        $('#detailDiscovery').innerHTML=row(extra.collectionName?'Saga · '+extra.collectionName:'Otras entregas',extra.collection)+row('Historias relacionadas',extra.related)+row('Recomendadas',extra.recommendations)+row('Similares',(extra.similar||[]).filter(value=>!recommended.has(`${value.type}:${value.id}`)));
        // These rows arrive after the ficha was wired, so their posters need their own click and keyboard handlers.
        wirePosters();
        if(extra.trailer&&!$('#btnTrailer')){const button=document.createElement('button');button.className='btn';button.id='btnTrailer';button.innerHTML=icon('play')+'Tráiler';button.onclick=()=>(Platform.openExternal||Platform.openUrl)(extra.trailer);$('#content .d-actions')?.prepend(button);}
        // What the catalog lacks (synopsis, duration, seasons) comes from the same TMDB answer.
        const info=$('#content .detail-view .d-info');
        if(info&&extra.overview&&!info.querySelector('.d-overview')){const overview=document.createElement('div');overview.className='d-overview';overview.textContent=extra.overview;info.querySelector('.d-actions')?.before(overview);}
        // The provider's synopsis is often in English; TMDB's Spanish one replaces it, and also «Sin sinopsis.».
        const overviewNode=info?.querySelector('.d-overview');
        if(overviewNode&&extra.overview&&(fromProvider||!overviewNode.textContent.trim()||overviewNode.querySelector('i')))overviewNode.textContent=extra.overview;
        // Genres: their own line under the data (movie board) and inline in the data line (series board, desktop).
        let genreLine=info?.querySelector('.d-genres');
        if(info&&!genreLine&&extra.genres?.length){genreLine=document.createElement('div');genreLine.className='d-genres';info.querySelector('.d-meta')?.after(genreLine);}
        if(genreLine&&!genreLine.children.length&&extra.genres?.length)genreLine.innerHTML=extra.genres.map(genre=>`<span>${esc(genre)}</span>`).join('');
        const meta=info?.querySelector('.d-meta');
        const extent=type==='tv'?(extra.seasons?extra.seasons+(extra.seasons===1?' temporada':' temporadas'):''):(extra.runtime?runtimeLabel(extra.runtime):'');
        if(meta&&extent&&!meta.querySelector('.d-runtime')){const chip=document.createElement('span');chip.className='chip d-runtime';chip.textContent=extent;const after=meta.querySelector('.chip-accent + .chip:not(.d-runtime)')||meta.querySelector('.chip-accent');after?after.after(chip):meta.prepend(chip);}
        if(meta&&extra.genres?.length&&!meta.querySelector('.d-meta-genres')){const inline=document.createElement('span');inline.className='d-meta-genres';inline.textContent=extra.genres.join(' · ');const before=meta.querySelector('.chip-quality, .d-id');before?before.before(inline):meta.append(inline);}
      }).catch(()=>{});
      const alertButton=$('#btnAvailabilityAlert');
      if(alertButton){
        if(!metadataId)alertButton.remove();else{
          const target={id:String(metadataId),type,title:detail.title,poster:detail.poster||'',year:detail.year||''};let watching=false;
          Platform.alertsCall('list').then(items=>{if(currentRoute!==route)return;watching=items.some(item=>item.type===type&&String(item.id)===String(metadataId));alertButton.textContent=watching?'Quitar alerta':'Avisarme cuando haya una fuente';if(hasSource&&!watching)alertButton.remove();}).catch(()=>{});
          alertButton.onclick=async()=>{alertButton.disabled=true;try{if(!watching)await Platform.alertsCall('permission');const result=await Platform.alertsCall('toggle',target);watching=result.watching;alertButton.textContent=watching?'Quitar alerta':'Avisarme cuando haya una fuente';toast(watching?(result.notificationsEnabled?'Alerta guardada. Se comprobará periódicamente.':'Alerta guardada. Activa las notificaciones de Nébula para recibir avisos.'):'Alerta eliminada.');}catch{toast('No se pudo guardar la alerta. Vuelve a intentar.');}finally{alertButton.disabled=false;}};
        }
      }

  }

  async function renderDetail(type, id) {
    const route=currentRoute;
    content().innerHTML = `
      <div class="view">
        <div class="detail-hero"><div class="backdrop"></div><div class="content">
          <div class="detail-poster skeleton" style="height:285px"></div>
          <div class="d-info"><div class="d-title skeleton" style="height:30px;width:60%"></div><p role="status" data-source-state="loading">Consultando la ficha y sus fuentes…</p></div>
        </div></div>
      </div>`;
    try {
      const detail = String(id).startsWith('nebula:') ? await API.nebulaDetail(id) : type === 'tv' ? await API.seriesDetail(id) : await API.movieDetail(id);
      if(currentRoute!==route)return;
      if (!detail) { content().innerHTML = '<div class="view"><div class="empty-state"><div class="big">🚫</div><div>No encontrado</div></div></div>'; return; }
      // Catálogo→episodios/fuentes y ofertas legales no dependen entre sí: se consultan a la vez.
      const catalogsReady = API.loadCatalogs(Store.settings.catalogUrls);
      const catalogEntry = catalogsReady.then(async () => {
        let entry = API.findCatalogItem(type, id);
        if (type === 'tv' && currentRoute === route) {
          const result = await API.episodesFor(detail);
          entry = { ...(entry || detail), raw: { ...entry?.raw, episodes: result.episodes }, episodeError: result.warnings[0]?.error };
        }
        return entry;
      });
      const providersReady = String(id).startsWith('nebula:') ? Promise.resolve(null) : API.watchProviders(type, id).catch(() => null);
      const sourcesReady = type === 'movie' ? catalogsReady.then(() => currentRoute === route ? API.sourcesFor(detail) : { sources: [] }) : Promise.resolve({ sources: [] });
      const [catItem, wp, additional] = await Promise.all([catalogEntry, providersReady, sourcesReady]);
      if(currentRoute!==route)return;

      const watchBox = wp && wp.groups.length ? `
        <details class="watch-box">
          <summary class="watch-head"><span class="watch-label">Dónde verla legalmente (${esc(wp.region)})</span></summary>
          <div class="watch-groups">
            ${wp.groups.map(([label, arr]) => `
              <div class="watch-group">
                <span class="watch-group-label">${esc(label)}</span>
                <div class="watch-chips">
                  ${arr.slice(0, 4).map((p) => `
                    <button class="watch-chip" data-watch="1" title="Ver opciones en TMDB/JustWatch">
                      ${p.logo_path ? `<img alt="" src="${esc('https://image.tmdb.org/t/p/w45' + p.logo_path)}"/>` : ''}
                      <span>${esc(p.provider_name)}</span>
                    </button>`).join('')}
                </div>
              </div>
            `).join('')}
          </div>
          <div class="watch-links">
            <button class="watch-chip watch-link-btn" data-justwatch="1">🔍 Buscar en JustWatch</button>
            ${wp.link ? '<button class="watch-chip watch-link-btn" data-watch="1">🌐 Todas las ofertas</button>' : ''}
          </div>
        </details>` : `
        <details class="watch-box watch-box-empty">
          <summary class="watch-head"><span class="watch-label">Sin ofertas de streaming registradas en tu región</span></summary>
          <div class="watch-links"><button class="watch-chip watch-link-btn" data-justwatch="1"><svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>Buscar en JustWatch</button></div>
        </details>`;

      const allQualities=type==='movie'?listPlayableSources(additional.allSources):[];
      const qualities = allQualities;
      const fav = Store.isFavorite(type, id);
      const seriesResume = type === 'tv' ? Store.resumeList.find(r => r.type === 'tv' && String(r.id) === String(detail.id) && r.season && r.episode) : null;
      const hasMovieResume = type === 'movie' && !!Store.getResume('movie', detail.id);
      const firstPlayableEp = type === 'tv' ? (catItem?.raw?.episodes || []).find(ep => API.parseSources(ep.urls, ep.resolutions).some(s => s.url)) : null;
      $('#tbTitle').textContent = detail.title || (type === 'tv' ? 'Serie' : 'Película');

      content().innerHTML = `
        <div class="view detail-view detail-${type === 'tv' ? 'tv' : 'movie'}">
          <div class="detail-tabs" role="tablist" aria-label="Secciones de la ficha">
            <button type="button" class="detail-tab active" data-dtab="summary">Resumen</button>
            ${type === 'tv' ? '<button type="button" class="detail-tab" data-dtab="seasons">Temporadas</button>' : ''}
          </div>
          <div class="detail-hero">
            ${backdropMarkup(detail.backdrop, detail.poster)}
            <div class="content">
              <div class="detail-poster">
                ${detail.poster ? `<img alt="" decoding="async" src="${esc(detail.poster)}"/>` : `<div class="detail-poster-ph">${icon('film')}</div>`}
              </div>
              <div class="d-info">
                <h1 class="d-title">${esc(detail.title)} <span class="d-year">${detail.year ? `(${esc(String(detail.year).slice(0,4))})` : ''}</span></h1>
                <div class="d-meta">
                  <span class="chip chip-accent">${type === 'tv' ? 'Serie' : 'Película'}</span>
                  ${detail.year ? `<span class="chip">${esc(String(detail.year).slice(0,4))}</span>` : ''}
                  ${detail.runtime ? `<span class="chip d-runtime">${runtimeLabel(detail.runtime)}</span>` : type === 'tv' && detail.seasons?.length ? `<span class="chip d-runtime">${detail.seasons.length} ${detail.seasons.length === 1 ? 'temporada' : 'temporadas'}</span>` : ''}
                  ${detailRatingChip(detail.rating)}
                  ${metaGenres(detail.genres)}
                  ${type === 'movie' && qualityTier(qualities) ? `<span class="chip chip-quality">${qualityTier(qualities)}</span>` : ''}
                </div>
                <div class="d-genres">${(detail.genres || []).map((g) => `<span>${esc(g)}</span>`).join('')}</div>
                <div class="d-overview">${esc(detail.overview) || '<i>Sin sinopsis.</i>'}</div>
                <div class="d-actions">
                  ${qualities.length ? `
                    <button class="btn primary" id="btnPlaySel"><svg class="icon" aria-hidden="true"><use href="#i-play"/></svg>Reproducir</button>
                    <button class="btn" id="btnDownloadSel"><svg class="icon" aria-hidden="true"><use href="#i-download"/></svg>Descargar</button>` : type === 'movie' ? `
                    <button class="btn primary" type="button" disabled aria-describedby="noSourceTitle"><svg class="icon" aria-hidden="true"><use href="#i-play"/></svg>Reproducir</button>
                    <button class="btn btn-download-off" type="button" disabled aria-describedby="noSourceTitle"><svg class="icon" aria-hidden="true"><use href="#i-download"/></svg>Descargar</button>` : seriesResume ? `<button class="btn primary" id="btnResumeSeries"><svg class="icon" aria-hidden="true"><use href="#i-play"/></svg>Continuar T${seriesResume.season} · E${seriesResume.episode}</button>` : firstPlayableEp ? `<button class="btn primary" id="btnPlayFirstEp"><svg class="icon" aria-hidden="true"><use href="#i-play"/></svg>Reproducir T${firstPlayableEp.season} · E${firstPlayableEp.episode}</button>` : ''}
                  ${detail.trailer ? '<button class="btn" id="btnTrailer"><svg class="icon" aria-hidden="true"><use href="#i-play"/></svg>Tráiler</button>' : ''}
                  ${Platform.availabilityAlerts&&!(type==='movie'&&!qualities.length)?'<button class="btn" id="btnAvailabilityAlert">Avisarme cuando haya una fuente</button>':''}
                  ${type==='movie'?(qualities.length?sourceStatusMarkup(qualities,additional):''):!qualities.length&&!seriesResume&&!firstPlayableEp?(Platform.isIos&&catItem?.episodeError?iosSourcesNotice():'<span class="chip">Elige un capítulo para ver sus fuentes y reproducir</span>'):''}
                  <button class="btn ${fav ? 'danger-ghost' : ''}" id="btnFav" aria-pressed="${fav}">${favInner(fav)}</button>
                  ${seriesQualityButton(type)}
                  <details class="d-more"><summary class="btn d-more-btn" aria-label="Más acciones">⋯</summary><div class="d-more-panel">
          ${seriesResume || hasMovieResume ? '<button class="btn" id="btnRemoveResume">Quitar de continuar</button>' : ''}
          <button class="btn" id="btnShare"><svg class="icon" aria-hidden="true"><use href="#i-link"/></svg>Copiar enlace TMDB</button>
        </div></details>
                </div>
                ${qualities.length ? qualityPicker(qualities) : type === 'movie' ? noSourcePanel(qualities, additional) : ''}
                ${watchBox}
              </div>
            </div>
          </div>
          ${type === 'tv' ? `<div class="row-head episodes-head" id="seasonsHead"><h2><span class="seasons-head-full">Temporadas y capítulos</span><span class="seasons-head-short">Episodios</span></h2><span class="seasons-count" aria-hidden="true"></span></div><div id="seasonsBox"></div>` : ''}
          <div id="detailDiscovery"></div>
          ${detail.cast && detail.cast.length ? `
            <div class="row-head"><h2>Reparto</h2></div>
            <div class="cast-row">${detail.cast.map((c) => `
              <div class="cast-card">${c.img ? `<img alt="" src="${esc(c.img)}" loading="lazy"/>` : '<div class="ph" style="width:74px;height:74px;border-radius:50%;background:var(--panel);margin:0 auto 6px"></div>'}
                <div class="c-name">${esc(c.name)}</div><div class="c-role">${esc(c.role || '')}</div></div>`).join('')}</div>` : ''}
        </div>`;

      $$('.detail-tab').forEach(tabBtn => tabBtn.addEventListener('click', () => {
        $$('.detail-tab').forEach(b => b.classList.toggle('active', b === tabBtn));
        if (tabBtn.dataset.dtab === 'seasons') $('#seasonsHead')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        else content().scrollTo({ top: 0, behavior: 'smooth' });
      }));

      wireBackdrops();
      wireDiscovery(detail,type,route,!!(qualities.length||firstPlayableEp||seriesResume));
      wireSeriesQuality();

      /* Acciones */
      if($('#retrySources'))$('#retrySources').onclick=()=>{API.invalidate();renderDetail(type,id);};
      const playUrlFor = () => {
        const sel = selectedQuality();
        return sel ? sel.url : (catItem && catItem.urls[0]) || detail.trailer;
      };
      if ($('#btnResumeSeries') && seriesResume) {
        $('#btnResumeSeries').onclick = () => resumeItem('tv', detail.id, Number(seriesResume.season), Number(seriesResume.episode), { trigger: $('#btnResumeSeries') });
      }
      if ($('#btnPlayFirstEp') && firstPlayableEp) {
        $('#btnPlayFirstEp').onclick = () => {
          const sNum = Number(firstPlayableEp.season);
          const eNum = Number(firstPlayableEp.episode);
          const seasonEps = (catItem?.raw?.episodes || []).filter(ep => Number(ep.season) === sNum);
          const urls = pickEpisodeUrls(seasonEps, eNum);
          if (urls.length) openEpisode(detail, sNum, eNum, urls[0].url, urls[0].name, seasonEps);
        };
      }
      if ($('#btnRemoveResume')) {
        $('#btnRemoveResume').onclick = () => {
          Store.removeResume(type, detail.id);
          $('#btnRemoveResume').remove();
          toast('Quitado de continuar viendo');
        };
      }
      const savedMovieResume = type === 'movie' ? Store.getResume('movie', detail.id) : null;
      if ($('#btnPlaySel') && savedMovieResume && savedMovieResume.position > 20) {
        const restante = savedMovieResume.duration ? Math.max(1, Math.round((savedMovieResume.duration - savedMovieResume.position) / 60)) : 0;
        $('#btnPlaySel').innerHTML = '<svg class="icon" aria-hidden="true"><use href="#i-play"/></svg>Continuar' + (restante ? ' · quedan ' + restante + ' min' : '');
      }
      if ($('#btnPlaySel')) {
        $('#btnPlaySel').onclick = () => {
          const sel = selectedQuality() || qualities[0];
          if (!sel?.url) { toast('No hay fuente de video disponible'); return; }
          busyWhile($('#btnPlaySel'), playVerified({ type, id: detail.id, title: detail.title, originalTitle: detail.originalTitle, year: detail.year, poster: detail.poster, backdrop: detail.backdrop,
            kind: 'stream', url: sel.url, urls: allQualities }));
        };
      }
      if ($('#btnTrailer')) $('#btnTrailer').onclick = () => {
        // Windows no tiene openExternal: openUrl abre la ventana aislada del tráiler.
        if(/^https:\/\/(?:www\.)?youtube\.com\/watch\?/.test(detail.trailer))(Platform.openExternal||Platform.openUrl)(detail.trailer);else Player.open({ type, id: detail.id, title: `${detail.title} — Tráiler`, poster: detail.poster, kind: 'trailer', url: detail.trailer });
      };
      if ($('#btnDownloadSel')) $('#btnDownloadSel').onclick = () => {
        const sel = selectedQuality() || qualities[0];
        if (!sel || !sel.url) { toast('No hay URL a descargar, prueba con otra calidad.'); return; }
        startDownloadFlow({ url: sel.url, filename: `${detail.title} ${sel.name}.mp4`, title: detail.title, quality: sel.name, size: sel.size, meta: { type, id: detail.id, title: detail.title, art: detail.backdrop || detail.poster || '' } });
      };
      $('#btnFav').onclick = () => {
        const on = Store.toggleFavorite({ type, id: detail.id, title: detail.title, poster: detail.poster, year: detail.year,rating:detail.rating });
        $('#btnFav').innerHTML = favInner(on);
        $('#btnFav').setAttribute('aria-pressed',String(on));
        $('#btnFav').className = `btn ${on ? 'danger-ghost' : ''}`;
        toast(on ? 'Agregado a Mi lista' : 'Quitado de Mi lista');
      };
      $('#btnShare').onclick = () => {
        Platform.clipboardWrite(`https://www.themoviedb.org/${type === 'tv' ? 'tv' : 'movie'}/${id}`);
        toast('URL copiada');
      };
      /* Enlaces a proveedores legales */
      $$('button[data-watch]').forEach((b) => b.addEventListener('click', () => {
        if (wp && wp.link) Platform.openUrl(wp.link);
      }));
      $$('button[data-justwatch]').forEach((b) => b.addEventListener('click', () => {
        Platform.openUrl(`https://www.justwatch.com/es/buscar?q=${encodeURIComponent(detail.title)}`);
      }));
      wireQualityPicker(qualities, savedMovieResume?.source);
    verifyQualityBox(qualities);

      if (type === 'tv') renderSeasons(detail, catItem);
    } catch (e) {
      if(currentRoute!==route)return;
      // App Android: la ficha que no carga usa el estado de error del canvas (ícono, título, detalle y «Reintentar»), no el texto crudo «Error: Failed to fetch».
      if (Boolean(document.body?.classList?.contains?.('platform-android')) && !tvInterface()) {
        const offline = typeof navigator !== 'undefined' && navigator.onLine === false;
        content().innerHTML = `<div class="view">${stateMessage({art:'cloud',role:'alert',title:offline?'Sin conexión':'No se pudo abrir esta ficha',detail:offline?'Vuelve a intentarlo cuando tengas conexión.':'Revisa tu conexión y vuelve a intentarlo.',hint:publicMessage(e.message),actions:[{id:'detailRetry',label:'Reintentar',primary:true,icon:'reload'}]})}</div>`;
        $('#detailRetry').onclick = () => activateRoute({ ...route, scrollTop: 0 });
        return;
      }
      content().innerHTML = `<div class="view"><div class="empty-state"><div class="big">⚠️</div><div>Error: ${esc(e.message)}</div></div></div>`;
    }
  }

  // Detail meta line (canvas «Ficha de película»): «2 h 52 min», «★ 8.4» (the «/10» is hidden on the phone) and the best quality.
  function runtimeLabel(minutes){const total=Math.round(Number(minutes)||0);if(total<60)return total+' min';const hours=Math.floor(total/60),rest=total%60;return rest?`${hours} h ${rest} min`:`${hours} h`;}
  // Mi lista: the phone boards use «+ Mi lista» / «✓ En mi lista»; desktop and TV keep the heart.
  function favInner(on){const phone=Boolean(document.body?.classList?.contains?.('platform-android'))&&!tvInterface()&&Number(globalThis.innerWidth)<=760;const desktop=!document.body?.classList?.contains?.('platform-android')&&!tvInterface();return phone?(on?icon('check')+'En mi lista':icon('plus')+'Mi lista'):desktop&&on?icon('check')+'En mi lista':icon('heart')+(on?'En Mi lista':'Mi lista');}
  // Phone series ficha (canvas «Ficha de serie»): «Calidad: Auto» beside Tráiler and Mi lista opens Ajustes › Calidad preferida.
  const QUALITY_MODES=[['auto','Auto'],['fixed4k','4K fijo'],['manual','Elegir fuente']];
  function qualityModeLabel(){const mode=NebulaCore.qualityMode(Store.settings.playbackMode);return 'Calidad: '+(QUALITY_MODES.find(([value])=>value===mode)||QUALITY_MODES[0])[1];}
  function seriesQualityButton(type){return type==='tv'&&!tvInterface()&&!document.body?.classList?.contains?.('platform-tv')?`<button class="btn" id="btnSeriesQuality">${icon('settings')}${esc(qualityModeLabel())}</button>`:'';}
  function wireSeriesQuality(){
    const button=$('#btnSeriesQuality');if(!button)return;
    button.onclick=()=>{
      const mode=NebulaCore.qualityMode(Store.settings.playbackMode);
      showModal(`<h2>Calidad preferida</h2><p>Vale para todos los episodios. Si una fuente falla, se prueba otra.</p><div class="tv-source-options">${QUALITY_MODES.map(([value,label])=>`<button class="btn tv-source-option" data-quality-mode="${value}" aria-pressed="${value===mode}"><span>${label}</span>${value===mode?'<small>Actual</small>':''}</button>`).join('')}</div><div class="m-actions"><button class="btn" id="qualityCancel">Cancelar</button></div>`,()=>{
        $('#modalLayer .modal-card').setAttribute('aria-label','Calidad preferida');
        $$('#modalLayer [data-quality-mode]').forEach(option=>option.onclick=()=>{Store.setSetting('playbackMode',NebulaCore.qualityMode(option.dataset.qualityMode));closeModal();button.innerHTML=icon('settings')+esc(qualityModeLabel());});
        $('#qualityCancel').onclick=closeModal;
      });
    };
  }
  function detailRatingChip(value){const score=NebulaUI.ratingValue(value);return score===null?NebulaUI.ratingChip(value):`<span class="chip gold">★ ${score.toFixed(1)}<span class="rating-scale">/10</span></span>`;}
  // Desktop meta line (EscritorioPelicula): the genres inline, «Aventura · Comedia», before the quality badge.
  function metaGenres(genres){const list=(genres||[]).filter(Boolean);return list.length?`<span class="d-meta-genres">${list.map(esc).join(' · ')}</span>`:'';}
  function qualityTier(qualities){const height=Math.max(0,...(qualities||[]).map(source=>typeof NebulaCore!=='undefined'&&NebulaCore.sourceHeight?Number(NebulaCore.sourceHeight(source))||0:0));return height>=2160?'4K':height>=1080?'Full HD':height>=720?'HD':'';}
  // Phone collapsed source card: «6 fuentes. Si una falla, se prueba otra.» under the chosen source.
  function syncSourceSummary(){
    const box=document.getElementById('qualityBox');if(!box)return;
    const count=box.querySelectorAll('.quality-item:not(.dead)').length;
    const summary=count>1?count+' fuentes. Si una falla, se prueba otra.':count===1?'1 fuente disponible.':'';
    box.querySelectorAll('.q-name, .q-label').forEach(node=>node.setAttribute('data-summary',summary));
    box.classList.toggle('single-source',count<2);
  }
  // Phone source rows (CelularPelicula / CelularFuentes): «1080p · Español latino» and below «Opción 1 · 4,2 GB».
  // Below it «Servidor 1 · MP4 · 4,2 GB» (CelularFuentes): the position, the container when known and a real size.
  function sourceLabel(source,index=0){
    const parts=typeof PlaybackTracks!=='undefined'&&PlaybackTracks.sourceParts?PlaybackTracks.sourceParts(source.name):{resolution:''};
    const size=/\d/.test(String(source.size||''))?String(source.size).replace(/(\d)\.(\d)/,'$1,$2'):'';
    const link=String(source.url||'');
    const format=(/\b(MP4|MKV|WEBM|HLS)\b/i.exec(String(source.name||''))?.[1]||(/\.m3u8(?:[?#]|$)/i.test(link)?'HLS':/\.mkv(?:[?#]|$)/i.test(link)?'MKV':/\.mp4(?:[?#]|$)/i.test(link)?'MP4':'')).toUpperCase();
    const detail=[`Servidor ${index+1}`,format,size].filter(Boolean).join(' · ');
    if(!parts.resolution)return{title:String(source.name||''),detail};
    return{title:[[parts.resolution,...parts.tags].join(' '),...parts.languages].join(' · '),detail};
  }
  // Desktop source card (EscritorioPelicula/EscritorioFuentes): «1080p» with its tags and the languages below.
  // Without a resolution in the name, the name is shown as it comes.
  function sourceParts(name){
    const parts=typeof PlaybackTracks!=='undefined'&&PlaybackTracks.sourceParts?PlaybackTracks.sourceParts(name):{resolution:''};
    if(!parts.resolution)return{title:String(name||''),tags:[],detail:''};
    return{title:parts.resolution,tags:parts.tags,detail:[...parts.languages,parts.rest].filter(Boolean).join(' · ')};
  }

  function qualityPicker(qualities) {
    if(tvInterface())return '';
    return `
      <div class="row-head quality-head" style="margin-top:6px"><h2>${sourceHeading(qualities.length)}</h2><button type="button" class="q-done">Listo</button></div>
      <div class="qualities" id="qualityBox">
        ${qualities.map((q, i) => { const parts=sourceParts(q.name), label=sourceLabel(q, i); return `
          <div class="quality-item ${i === 0 ? 'sel' : ''}" role="radio" tabindex="0" aria-checked="${i === 0}" data-url="${esc(q.url || '')}" data-name="${esc(q.name)}" data-size="${esc(q.size || '')}">
            <div class="q-name">${esc(q.name)}</div>
            <div class="q-label"><span class="q-label-title">${esc(label.title)}</span>${label.detail?`<span class="q-label-detail">${esc(label.detail)}</span>`:''}</div>
            <div class="q-title" aria-hidden="true"><span class="q-res">${esc(parts.title)}</span>${parts.tags.map(tag=>`<span class="q-tag">${esc(tag)}</span>`).join('')}</div>
            ${parts.detail?`<div class="q-detail" aria-hidden="true">${esc(parts.detail)}</div>`:''}
            <div class="q-size">${q.size ? esc(q.size) : (q.url ? 'Disponible' : 'No disponible')}</div>
          </div>`; }).join('')}
        <button type="button" class="btn q-change" aria-expanded="false">Cambiar fuente<svg class="icon" aria-hidden="true"><use href="#i-chevron"/></svg></button>
      </div>`;
  }

  let selectedQualityRef = null;
  let qualityUserPicked = false;
  function selectQualityCard(el) {
    if (!el) return;
    $$('#qualityBox .quality-item').forEach((x) => { x.classList.remove('sel'); x.setAttribute('aria-checked', 'false'); });
    el.classList.add('sel');
    el.setAttribute('aria-checked', 'true');
    selectedQualityRef = { name: el.dataset.name, size: el.dataset.size, url: el.dataset.url };
  }

  function wireQualityPicker(qualities, preferredUrl = '') {
    const matched = preferredUrl ? (qualities || []).find(q => q && q.url === preferredUrl) : null;
    qualityUserPicked = Boolean(matched);
    selectedQualityRef = matched || (qualities && qualities.length ? qualities[0] : null);
    if (matched) {
      const card = $$('#qualityBox .quality-item').find(node => node.dataset.url === String(matched.url || ''));
      if (card) selectQualityCard(card);
    }
    if(tvInterface())return;
    syncSourceSummary();
    setTimeout(() => {
      document.querySelectorAll('#qualityBox .quality-item[data-state="checking"]').forEach((card) => {
        card.dataset.state = 'unknown';
        card.classList.add('unconfirmed');
        const size = card.querySelector('.q-size');
        if (size) size.textContent = card.dataset.size ? card.dataset.size + ' · sin confirmar' : 'Sin confirmar';
      });
      const head = document.querySelector('#qualityBox')?.parentElement?.querySelector('.row-head h2');
      if (head) head.innerHTML = sourceHeading(document.querySelectorAll('#qualityBox .quality-item:not(.dead)').length);
      syncSourceSummary();
    }, 22000);
    $$('#qualityBox .quality-item').forEach((el) => {
      el.addEventListener('keydown', event => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); el.click(); } });
      el.addEventListener('click', () => {
        $$('#qualityBox .quality-item').forEach((x) => { x.classList.remove('sel'); x.setAttribute('aria-checked', 'false'); });
        el.classList.add('sel');
        el.setAttribute('aria-checked', 'true');
        selectedQualityRef = { name: el.dataset.name, size: el.dataset.size, url: el.dataset.url };
        qualityUserPicked = true;
      });
    });
  }
  function selectedQuality() { return selectedQualityRef; }

  function episodeActionsMarkup(qualities, watched, canSkip = true, emptyMessage = '', preferredUrl = '') {
    const top = listPlayableSources(qualities);
    if (!top.length) {
      return `<div class="ep-actions"><span class="ep-unavailable">${esc(emptyMessage)}</span></div>`;
    }
    const preferredIdx = preferredUrl ? top.findIndex(q => q.url === preferredUrl) : -1;
    const first = preferredIdx >= 0 ? top[preferredIdx] : top[0];
    const playLabel = !tvInterface()&&first.name && first.name !== 'Original' ? `Reproducir · ${first.name}` : 'Reproducir';
    const selectHtml = !tvInterface()&&top.length > 1
      ? `<select class="ep-quality-select" aria-label="Seleccionar calidad del episodio">${top.map((q, idx) => `<option value="${idx}" data-url="${esc(q.url)}" data-name="${esc(q.name || '')}" ${idx === (preferredIdx >= 0 ? preferredIdx : 0) ? 'selected' : ''}>${esc(q.name || `Opción ${idx + 1}`)}</option>`).join('')}</select>`
      : '';
    return `<div class="ep-actions">
      <button class="${selectHtml ? '' : 'ep-play-full'}" data-play="1" data-url="${esc(first.url)}" data-name="${esc(first.name || '')}"><svg class="icon" aria-hidden="true"><use href="#i-play"/></svg><span class="ep-play-label">${esc(playLabel)}</span></button>
      ${selectHtml}
      <button data-dl="1" data-url="${esc(first.url)}" data-name="${esc(first.name || '')}"><svg class="icon" aria-hidden="true"><use href="#i-download"/></svg>Descargar</button>
      ${canSkip ? `<button data-skip="1"><svg class="icon" aria-hidden="true"><use href="#i-clock"/></svg>Salto de intro</button>` : ''}
      <button data-mark="1">${watched ? 'Quitar visto' : 'Marcar visto'}</button>
    </div>`;
  }

  function wireEpisodeQualitySelect(row) {
    const sel = row.querySelector('.ep-quality-select');
    if (!sel) return;
    sel.addEventListener('click', ev => ev.stopPropagation());
    sel.addEventListener('change', ev => {
      ev.stopPropagation();
      const opt = sel.selectedOptions[0];
      if (!opt) return;
      const url = opt.dataset.url || '';
      const name = opt.dataset.name || '';
      const playBtn = row.querySelector('button[data-play]');
      const dlBtn = row.querySelector('button[data-dl]');
      if (playBtn) {
        playBtn.dataset.url = url;
        playBtn.dataset.name = name;
        const lbl = playBtn.querySelector('.ep-play-label');
        if (lbl) lbl.textContent = name && name !== 'Original' ? `Reproducir · ${name}` : 'Reproducir';
      }
      if (dlBtn) {
        dlBtn.dataset.url = url;
        dlBtn.dataset.name = name;
      }
    });
  }

  async function renderSeasons(detail, catItem) {
    const route=currentRoute;
    let sequence=0;
    const box = $('#seasonsBox');
    if (!box) return;
    const seasonMap=new Map((detail.seasons||[]).map(season=>[season.season,season]));
    for(const episode of catItem?.raw?.episodes||[])if(!seasonMap.has(Number(episode.season)))seasonMap.set(Number(episode.season),{season:Number(episode.season),name:'Temporada '+episode.season});
    const seasons=[...seasonMap.values()].sort((a,b)=>a.season-b.season);
    if (!seasons.length) { box.innerHTML = '<div class="empty-state"><div>Episodios no disponibles.</div></div>'; return; }
    const savedResume = Store.resumeList.find(r => r.type === 'tv' && String(r.id) === String(detail.id));
    const initialSeason = seasons.find(s => Number(s.season) === Number(savedResume?.season))?.season ?? seasons[0].season;
    box.innerHTML = `
      <div class="seasons-tabs">${seasons.map((s) => `<button class="season-tab ${s.season === initialSeason ? 'active' : ''}" data-s="${s.season}">${esc(s.name || `Temporada ${s.season}`)}</button>`).join('')}</div>
      <div class="episodes" id="epsBox"><div class="empty-state"><div>Cargando capítulos…</div></div></div>`;
    // Escritorio (canvas «Escritorio · Ficha»): «Opciones del episodio» junto a las temporadas abre las acciones del
    // capítulo en curso (o del primero) sin tener que pasar el puntero por la tarjeta.
    if(!document.body?.classList?.contains?.('platform-android')&&!tvInterface()){
      $('.seasons-tabs',box)?.insertAdjacentHTML('beforeend','<button type="button" class="season-ep-options" id="seasonEpOptions">Opciones del episodio</button>');
      $('#seasonEpOptions').onclick=()=>{
        const rows=$$('#epsBox .episode.has-ep-more');
        const season=Number($('.season-tab.active',box)?.dataset.s);
        const current=rows.find(row=>Number(row.dataset.e)===Number(savedResume?.episode)&&season===Number(savedResume?.season))||rows[0];
        if(!current)return;
        if(!current.classList.contains('ep-actions-open'))current.querySelector('.ep-more')?.click();
        current.scrollIntoView({block:'nearest',behavior:'smooth'});
        current.querySelector('.ep-actions button:not([data-play])')?.focus();
      };
    }

    const loadEps = async (season) => {
      const request=++sequence;
      const epsBox = $('#epsBox');
      epsBox.innerHTML = '<div class="empty-state"><div>Cargando capítulos…</div></div>';
      try {
        const metadata = await API.seasonEpisodes(detail.id, season).catch(()=>[]);
        if(currentRoute!==route || request!==sequence)return;
        const catEpisodes = catItem && catItem.raw && Array.isArray(catItem.raw.episodes)
          ? catItem.raw.episodes.filter((e) => Number(e.season) === Number(season)) : [];
        const episodeMap=new Map(metadata.map(ep=>[Number(ep.episode),ep]));
        for(const episode of catEpisodes)if(!episodeMap.has(Number(episode.episode)))episodeMap.set(Number(episode.episode),{...episode,name:episode.name||'Episodio '+episode.episode});
        const eps=[...episodeMap.values()].sort((a,b)=>a.episode-b.episode);
        const countNode=$('#seasonsHead .seasons-count');if(countNode)countNode.textContent=eps.length?String(eps.length):'';
        if (!eps.length && !catEpisodes.length) { epsBox.innerHTML = '<div class="empty-state"><div>No hay capítulos para mostrar.</div></div>'; return; }

        const emptyMsg = CatalogSources.availability.message({state:catItem?.episodeError?'temporary_error':catItem?'unavailable':'unknown'});
        epsBox.innerHTML = eps.map((e) => {
          const watched = Store.isEpisodeWatched('tv', detail.id, season, e.episode);
          const epUrls = pickEpisodeUrls(catEpisodes, e.episode);
          const resume = Store.getResume('tv', detail.id, season, e.episode);
          const pct = resume && resume.duration ? Math.min(100, Math.round((resume.position / resume.duration) * 100)) : 0;
          return `
            <div class="episode" data-e="${e.episode}">
              <div class="ep-still">
                ${e.still ? `<img alt="" src="${esc(e.still)}" loading="lazy"/>` : `<div class="ph">${icon('film')}</div>`}
                ${pct ? `<div class="ep-progress" style="width:${pct}%"></div>` : ''}
              </div>
              <div class="ep-body">
                <div class="ep-meta">
                  <div class="ep-num"><span class="ep-code">S${String(season).padStart(2, '0')}E${String(e.episode).padStart(2, '0')} · </span>T${season} · E${e.episode}${Number(e.runtime) > 0 ? `<span class="ep-runtime"> · ${Math.round(Number(e.runtime))} min</span>` : ''} ${watched ? '<span class="ep-watched-badge">✓ visto</span>' : ''}</div>
                  <div class="ep-name">${esc(e.name)}</div>
                  <div class="ep-over">${esc(e.overview) || '<i>Sin descripción.</i>'}</div>
                </div>
                ${episodeActionsMarkup(epUrls, watched, true, emptyMsg, resume?.source)}
              </div>
            </div>`;
        }).join('');

        $$('.episode', epsBox).forEach((el) => {
          wireEpisodeCard(el);
          wireEpisodeQualitySelect(el);
          const epNum = Number(el.dataset.e);
          const buttons = el.querySelectorAll('button');
          buttons.forEach((b) => {
            b.addEventListener('click', (ev) => {
              ev.stopPropagation();
              if (b.dataset.play) {
                openEpisode(detail, season, epNum, b.dataset.url, b.dataset.name, catEpisodes);
              } else if (b.dataset.dl) {
                startDownloadFlow({ url: b.dataset.url, filename: `${detail.title} T${season}E${epNum} ${b.dataset.name}.mp4`, title: `${detail.title} T${season}E${epNum}`, quality: b.dataset.name, meta: { type: 'tv', id: detail.id, title: detail.title, season: Number(season), episode: epNum, art: el.querySelector('.ep-still img')?.src || detail.backdrop || detail.poster || '' } });
              } else if (b.dataset.mark) {
                const on = Store.toggleWatchedEpisode('tv', detail.id, season, epNum);
                toast(on ? 'Marcado como visto' : 'Quitar visto');
                loadEps(season);
              } else if (b.dataset.skip) {
                editSkipTimes(detail.id, season, epNum);
              }
            });
          });
        });
      } catch (e) {
        if(currentRoute!==route || request!==sequence)return;
        epsBox.innerHTML = `<div class="empty-state"><div>Error cargando capítulos: ${esc(e.message)}</div></div>`;
      }
    };

    $$('.season-tab', box).forEach((t) => t.addEventListener('click', () => {
      $$('.season-tab', box).forEach((x) => x.classList.remove('active'));
      t.classList.add('active');
      loadEps(Number(t.dataset.s));
    }));
    loadEps(initialSeason);
  }

  function pickEpisodeUrls(catEpisodes, epNum) {
    const ep = catEpisodes.find((e) => Number(e.episode) === Number(epNum));
    if (!ep) return [];
    return listPlayableSources(API.parseSources(ep.urls, ep.resolutions));
  }

  async function openEpisode(detail, season, episode, url, qualityName, catEpisodes,resumeDirect=false) {
    if (!(await ensurePlaybackAccess({ type: 'tv' }))) return;
    const next = catEpisodes.find((e) => Number(e.episode) === Number(episode) + 1);
    const baseTitle = String(detail.title || '').replace(/\s*—\s*T\d+·E\d+.*$/, '');
    Player.open({
      type: 'tv', id: detail.id,tmdbId:Number(detail.tmdbId)||Number(String(detail.canonicalId||detail.canonical||'').replace(/^(?:tmdb:)?(?:series|tv):/,''))||(/^\d+$/.test(String(detail.id))?Number(detail.id):0),isAnime:Number(detail.catalogType||detail.raw?.type)===3,imdbId:detail.external_ids?.imdb_id||detail.imdb_id||'',malId:Number(detail.malId||detail.mal_id)||0,
      title: `${baseTitle} — T${season}·E${episode}${qualityName ? ' (' + qualityName + ')' : ''}`,
      poster: detail.poster,
      backdrop: detail.backdrop,
      catalogUrl: detail.catalogUrl,
      kind: 'stream', resumeDirect,
      url,
      urls: pickEpisodeUrls(catEpisodes, episode).map((q) => ({ name: q.name, url: q.url, size: q.size })),
      season, episode,
      nextEpisode: next ? {
        label: `T${season}·E${next.episode}${next.name ? ' · ' + next.name : ''}`,
        open: () => {
          const urls = pickEpisodeUrls(catEpisodes, next.episode);
          openEpisode(detail, season, next.episode, urls[0] && urls[0].url, urls[0] && urls[0].name, catEpisodes);
        },
      } : null,
    });
  }

  function editSkipTimes(id, season, episode) {
    const sk = Store.getSkip('tv', id, season, episode) || { start: 0, end: 0 };
    const field=(key,label,value)=>tvInterface()?`<div class="set-row"><span>${label}</span><div class="tv-number-stepper"><button class="btn" data-skip-step="${key}" data-delta="-5" aria-label="${label}: restar cinco segundos">−5 s</button><output id="${key}Label" aria-live="polite">${value}</output><button class="btn" data-skip-step="${key}" data-delta="5" aria-label="${label}: sumar cinco segundos">+5 s</button><input type="hidden" id="${key}" value="${value}"></div></div>`:`<div class="set-row"><label for="${key}">${label}</label><input type="number" id="${key}" min="0" value="${value}"></div>`;
    showModal(`
      <h2><svg class="icon" aria-hidden="true"><use href="#i-clock"/></svg>Salto de intro</h2>
      <p>Marca el inicio y el final de este episodio. Es una marca manual, no una detección automática.</p>
      ${field('skStart','Inicio (s)',sk.start)}
      ${field('skEnd','Fin (s)',sk.end)}
      <div class="m-actions"><button class="btn" id="skCancel">Cancelar</button><button class="btn primary" id="skSave">Guardar</button></div>
    `, () => {
      $$('#modalLayer [data-skip-step]').forEach(button=>button.onclick=()=>{const input=$('#'+button.dataset.skipStep);input.value=Math.max(0,Math.min(86400,Number(input.value)+Number(button.dataset.delta)));$('#'+input.id+'Label').textContent=input.value;});
      $('#skSave').onclick = () => {
        const start=Number($('#skStart').value)||0,end=Number($('#skEnd').value)||0;
        if(!NebulaCore.introRange({start,end})){toast('Revisa el inicio y el final (máximo 5 minutos).');return;}
        Store.setSkip('tv', id, season, episode, start, end);
        toast('Salto de intro guardado');
        closeModal();
      };
      $('#skCancel').onclick = closeModal;
    });
  }

  /* ============================ Detalle de fuentes legales ============================ */
  async function renderSourceDetail(kind, id) {
    const route=currentRoute;
    content().innerHTML = `
      <div class="view">
        <div class="detail-hero"><div class="content">
          <div class="detail-poster skeleton" style="height:285px"></div>
          <div class="d-info"><div class="d-title skeleton" style="height:30px;width:55%"></div></div>
        </div></div>
      </div>`;
    try {
      const d = kind === 'archive' ? await API.archiveDetail(id) : await API.jellyfinDetail(id);
      if(d.type==='movie'){const result=await API.sourcesFor(d);d.sources=result.allSources;}
      if(currentRoute!==route)return;
      const fav = Store.isFavorite(d.type, d.id);
      const subtitleChip = d.subtitles && d.subtitles.length
        ? `<span class="chip">💬 ${d.subtitles.length} subtítulo(s) incluidos</span>` : '';
      content().innerHTML = `
        <div class="view">
          <div class="detail-hero">
            ${backdropMarkup(d.backdrop, d.poster)}
            <div class="content">
              <div class="detail-poster">${d.poster ? `<img alt="" src="${esc(d.poster)}"/>` : `<div class="detail-poster-ph">${icon('film')}</div>`}</div>
              <div class="d-info">
                <h1 class="d-title">${esc(d.title)} <span class="d-year">(${esc(d.year || '')})</span></h1>
                <div class="d-meta">
                  ${NebulaUI.ratingChip(d.rating)}
                  ${d.runtime ? `<span class="chip">${d.runtime} min</span>` : ''}
                  <span class="chip">${kind === 'archive' ? 'Dominio público · Archive.org' : 'Tu Jellyfin'}</span>
                  ${subtitleChip}
                </div>
                ${(d.genres && d.genres.length) ? `<div class="d-genres">${d.genres.map((g) => `<span>${esc(g)}</span>`).join('')}</div>` : ''}
                ${d.overview ? `<div class="d-overview">${esc(d.overview)}</div>` : ''}
                <div class="d-actions">
                  ${d.sources && d.sources.length ? `
                    <button class="btn primary" id="btnPlaySel"><svg class="icon" aria-hidden="true"><use href="#i-play"/></svg>Reproducir</button>
                    <button class="btn" id="btnDownloadSel"><svg class="icon" aria-hidden="true"><use href="#i-download"/></svg>Descargar</button>` : `
                    <span class="chip">Sin video disponible en este elemento</span>`}
                  <button class="btn ${fav ? 'danger-ghost' : ''}" id="btnFav" aria-pressed="${fav}">${favInner(fav)}</button>
                  ${kind === 'archive' ? '<button class="btn" id="btnArchiveWeb"><svg class="icon" aria-hidden="true"><use href="#i-link"/></svg>Ver en Archive.org</button>' : ''}
                </div>
                ${d.sources && d.sources.length ? qualityPicker(listPlayableSources(d.sources)) : ''}
              </div>
            </div>
          </div>
          ${d.type === 'tv' ? `<div class="row-head"><h2><span class="seasons-head-full">Capítulos</span><span class="seasons-head-short">Episodios</span></h2></div><div id="jfSeasons"></div>` : ''}
        </div>`;

      wireBackdrops();
      const srcQualities = listPlayableSources(d.sources || []);
      if ($('#btnPlaySel')) $('#btnPlaySel').onclick = async () => {
        if (!(await ensurePlaybackAccess({ type: d.type }))) return;
        const sel = selectedQuality() || srcQualities[0] || d.sources[0];
        Player.open({
          type: d.type, id: d.id, title: d.title, poster: d.poster, kind: 'stream', mediaKind:kind,
          url: sel.url,
          urls: srcQualities.map((s) => ({ name: s.name, size: s.size, url: s.url })),
        });
        // Subtítulos incluidos de Archive.org (automático)
        if (d.subtitles && d.subtitles.length) {
          setTimeout(() => Player.loadSubtitleFromUrl(d.subtitles[0].url, 'Archive.org'), 1500);
        }
      };
      if ($('#btnDownloadSel')) $('#btnDownloadSel').onclick = () => {
        const sel = selectedQuality() || srcQualities[0] || d.sources[0];
        if (!sel.url) { toast('No hay URL a descargar'); return; }
        const ext = sel.name.toLowerCase().startsWith('srt') ? 'ts' : (sel.name.toLowerCase().includes('ogv') ? 'ogv' : 'mp4');
        startDownloadFlow({ url: sel.url, filename: `${d.title} ${sel.name}.${ext}`, title: d.title, quality: sel.name, size: sel.size });
      };
      $('#btnFav').onclick = () => {
        const on = Store.toggleFavorite({ type: d.type, id: d.id, title: d.title, poster: d.poster, year: d.year,rating:d.rating, kind });
        $('#btnFav').innerHTML = favInner(on);
        $('#btnFav').setAttribute('aria-pressed',String(on));
        $('#btnFav').className = `btn ${on ? 'danger-ghost' : ''}`;
        toast(on ? 'Agregado a Mi lista' : 'Quitado de Mi lista');
      };
      const webBtn = $('#btnArchiveWeb');
      if (webBtn) webBtn.onclick = () => Platform.openUrl(`https://archive.org/details/${id}`);
      wireQualityPicker(srcQualities);

      if (d.type === 'tv') renderJellyfinSeasons(d);
    } catch (e) {
      content().innerHTML = `<div class="view"><div class="empty-state"><div class="big">⚠️</div><div>Error: ${esc(e.message)}</div></div></div>`;
    }
  }

  async function renderJellyfinSeasons(detail) {
    const box = $('#jfSeasons');
    if (!box) return;
    const seasons = detail.seasons || [];
    if (!seasons.length) { box.innerHTML = '<div class="empty-state"><div>Episodios no disponibles.</div></div>'; return; }
    box.innerHTML = `
      <div class="seasons-tabs">${seasons.map((s, i) => `<button class="season-tab ${i === 0 ? 'active' : ''}" data-sid="${s.seasonId}">${esc(s.name)}</button>`).join('')}</div>
      <div class="episodes" id="jfEps"><div class="empty-state"><div>Cargando capítulos…</div></div></div>`;

    const loadEps = async (seasonId) => {
      const epsBox = $('#jfEps');
      epsBox.innerHTML = '<div class="empty-state"><div>Cargando capítulos…</div></div>';
      try {
        const eps = await API.jellyfinEpisodes(detail.id, seasonId);
        if (!eps.length) { epsBox.innerHTML = '<div class="empty-state"><div>No hay capítulos para mostrar.</div></div>'; return; }
        epsBox.innerHTML = eps.map((e) => {
          const watched = Store.isEpisodeWatched('tv', detail.id, e.episode.season, e.episode.number);
          const resume = Store.getResume('tv', detail.id, e.episode.season, e.episode.number);
          const pct = resume && resume.duration ? Math.min(100, Math.round((resume.position / resume.duration) * 100)) : 0;
          return `
            <div class="episode" data-e="${e.episode.number}">
              <div class="ep-still">
                ${e.poster ? `<img alt="" src="${esc(e.poster)}" loading="lazy"/>` : `<div class="ph">${icon('film')}</div>`}
                ${pct ? `<div class="ep-progress" style="width:${pct}%"></div>` : ''}
              </div>
              <div class="ep-body">
                <div class="ep-meta">
                  <div class="ep-num">T${e.episode.season} · E${e.episode.number} ${watched ? '<span class="ep-watched-badge">✓ visto</span>' : ''}</div>
                  <div class="ep-name">${esc(e.title)}</div>
                  <div class="ep-over">${esc(e.overview || '')}</div>
                </div>
                <div class="ep-actions">
                  <button data-play="1"><svg class="icon" aria-hidden="true"><use href="#i-play"/></svg>Reproducir</button>
                  <button data-dl="1"><svg class="icon" aria-hidden="true"><use href="#i-download"/></svg>Descargar</button>
                  <button data-skip="1"><svg class="icon" aria-hidden="true"><use href="#i-clock"/></svg>Salto de intro</button>
                  <button data-mark="1">${watched ? 'Quitar visto' : 'Marcar visto'}</button>
                </div>
              </div>
            </div>`;
        }).join('');

        $$('.episode', epsBox).forEach((el, idx) => {
          wireEpisodeCard(el);
          const e = eps[idx];
          const playBtn = el.querySelector('button[data-play]');
          const dlBtn = el.querySelector('button[data-dl]');
          const skipBtn = el.querySelector('button[data-skip]');
          const markBtn = el.querySelector('button[data-mark]');
          if (playBtn) playBtn.onclick = async (ev) => {
            ev.stopPropagation();
            if (!(await ensurePlaybackAccess({ type: 'tv' }))) return;
            const nxt = eps[idx + 1] || null;
            Player.open({
              type: 'tv', id: detail.id,tmdbId:Number(detail.tmdbId)||Number(String(detail.canonicalId||detail.canonical||'').replace(/^(?:tmdb:)?(?:series|tv):/,''))||(/^\d+$/.test(String(detail.id))?Number(detail.id):0),isAnime:Number(detail.catalogType||detail.raw?.type)===3,imdbId:detail.external_ids?.imdb_id||detail.imdb_id||'',malId:Number(detail.malId||detail.mal_id)||0,
              title: `${detail.title} — T${e.episode.season}·E${e.episode.number}`,
              poster: detail.poster, kind: 'stream',
              url: API.jellyfinStreamUrl(e.id),
              season: e.episode.season, episode: e.episode.number,
              nextEpisode: nxt ? {
                label: `T${nxt.episode.season}·E${nxt.episode.number}`,
                open: async () => {
                  if (!(await ensurePlaybackAccess({ type: 'tv' }))) return;
                  if (playBtn) Player.open({ type: 'tv', id: detail.id, title: `${detail.title} — T${nxt.episode.season}·E${nxt.episode.number}`, poster: detail.poster, kind: 'stream', url: API.jellyfinStreamUrl(nxt.id), season: nxt.episode.season, episode: nxt.episode.number });
                },
              } : null,
            });
          };
          if (dlBtn) dlBtn.onclick = (ev) => {
            ev.stopPropagation();
            startDownloadFlow({
              url: API.jellyfinStreamUrl(e.id),
              filename: `${detail.title} T${e.episode.season}E${e.episode.number}.mp4`,
              title: detail.title, quality: 'HLS',
            });
          };
          if (skipBtn) skipBtn.onclick = (ev) => {
            ev.stopPropagation();
            editSkipTimes(detail.id, e.episode.season, e.episode.number);
          };
          if (markBtn) markBtn.onclick = (ev) => {
            ev.stopPropagation();
            Store.toggleWatchedEpisode('tv', detail.id, e.episode.season, e.episode.number);
            loadEps(seasonId);
          };
        });
      } catch (e) {
        epsBox.innerHTML = `<div class="empty-state"><div>Error cargando capítulos: ${esc(e.message)}</div></div>`;
      }
    };

    $$('.season-tab', box).forEach((t) => t.addEventListener('click', () => {
      $$('.season-tab', box).forEach((x) => x.classList.remove('active'));
      t.classList.add('active');
      loadEps(t.dataset.sid);
    }));
    loadEps(seasons[0].seasonId);
  }

  /* ============================ Detalle de catálogo externo ============================ */
  /** Pestañas y cabecera de la ficha de catálogo. `actions` es el bloque de botones (o el aviso de carga). */
  function catalogHeroHtml(item, actions, extra = '', quality = '') {
    const itemGenres = (item.genres && item.genres.length ? item.genres : NebulaCore.catalogGenres(item).map(genreLabel)).filter(Boolean);
    const itemOverview = item.overview || item.raw?.description || item.raw?.overview || '';
    return `
        <div class="detail-tabs" role="tablist" aria-label="Secciones de la ficha">
          <button type="button" class="detail-tab active" data-dtab="summary">Resumen</button>
          ${item.type === 'tv' ? '<button type="button" class="detail-tab" data-dtab="seasons">Temporadas</button>' : ''}
        </div>
        <div class="detail-hero">
          ${backdropMarkup(item.backdrop, item.poster)}
          <div class="content">
            <div class="detail-poster">${item.poster ? `<img alt="" decoding="async" src="${esc(item.poster)}"/>` : `<div class="detail-poster-ph">${icon('film')}</div>`}</div>
            <div class="d-info">
              <h1 class="d-title">${esc(item.title)} <span class="d-year">${item.year ? `(${esc(String(item.year).slice(0,4))})` : ''}</span></h1>
              <div class="d-meta"><span class="chip chip-accent">${item.type === 'tv' ? 'Serie' : 'Película'}</span>${item.year ? `<span class="chip">${esc(String(item.year).slice(0,4))}</span>` : ''}${item.runtime ? `<span class="chip d-runtime">${runtimeLabel(item.runtime)}</span>` : ''}<span class="rating-slot" id="catalogRating">${detailRatingChip(item.rating)}</span>${metaGenres(itemGenres)}${quality ? `<span class="chip chip-quality">${esc(quality)}</span>` : ''}<span class="chip d-id">TMDB ${esc(item.id)}</span></div>
              ${itemGenres.length ? `<div class="d-genres">${itemGenres.map(g => `<span>${esc(g)}</span>`).join('')}</div>` : ''}
              ${item.othersNames ? `<div class="d-meta d-meta-alt"><span class="d-alt-names">También: ${esc(item.othersNames)}</span></div>` : ''}
              ${itemOverview ? `<div class="d-overview">${esc(itemOverview)}</div>` : ''}
              <div class="d-actions">${actions}</div>
              ${extra}
            </div>
          </div>
        </div>`;
  }
  const sourcesPendingMarkup = () => `<span class="chip" role="status" data-source-state="loading"><span class="loading-ring loading-ring-sm" aria-hidden="true"></span>Buscando fuentes…</span><span class="btn-skeleton skeleton" aria-hidden="true"></span><span class="btn-skeleton skeleton" aria-hidden="true"></span>`;

  async function renderCatalogDetail(id, catalogUrl) {
    const route=currentRoute;
    if (!catalogUrl) { go('home'); return; }
    // Primer fotograma con lo que ya está en memoria (título, póster, fondo y sinopsis); las fuentes llegan después.
    const known = API.cachedCatalogItem?.(id, catalogUrl);
    if (known) {
      content().innerHTML = `<div class="view detail-view detail-${known.type === 'tv' ? 'tv' : 'movie'}">${catalogHeroHtml(known, sourcesPendingMarkup())}<div id="detailDiscovery"></div></div>`;
      $('#tbTitle').textContent = known.title || (known.type === 'tv' ? 'Serie' : 'Película');
      wireBackdrops();
    } else content().innerHTML='<div class="view"><p role="status" data-source-state="loading">Consultando la ficha y sus fuentes…</p></div>';
    const settings = Store.settings;
    const cats = await API.loadCatalogs(settings.catalogUrls,{allowStale:true}).catch(() => ({ items: [] }));
    if(currentRoute!==route)return;
    const item = cats.items.find((x) => String(x.id) === String(id) && x.catalogUrl === catalogUrl);
    if (!item) { toast('Elemento no encontrado en el catálogo'); go('home'); return; }
    // Episodios, fuentes y nota se piden a la vez; la nota no retiene la ficha si TMDB tarda.
    const episodesReady = item.type==='tv' ? API.episodesFor(item).then(result=>{item.raw={...item.raw,episodes:result.episodes};item.episodeError=result.warnings[0]?.error;}) : Promise.resolve();
    const sourcesReady = item.type==='movie' ? API.sourcesFor(item) : Promise.resolve({sources:[]});
    let ratingReady = Promise.resolve(null), ratingGate = ratingReady, ratingWait = null;
    if(NebulaUI.ratingValue(item.rating)===null){
      const tmdbId=((item.identities||[]).find(identity=>identity.providerId==='tmdb')||{}).id||item.id;
      ratingReady=Promise.resolve().then(()=>API.ratingFor(item.type,tmdbId)).catch(()=>null).then(score=>{if(score!==null&&score!==undefined){item.rating=score;rememberRating(item.type,item.id,score);}return score;});
      ratingGate=Promise.race([ratingReady,new Promise(resolve=>{ratingWait=setTimeout(resolve,1200);})]);
    }
    const [, additional] = await Promise.all([episodesReady, sourcesReady, ratingGate]);
    clearTimeout(ratingWait);
    if(currentRoute!==route)return;

    const fav = Store.isFavorite(item.type, item.id);
    const allQualities=item.type==='movie'?listPlayableSources(additional.allSources):[];
    const qualities = allQualities;
    const catSeriesResume = item.type === 'tv' ? Store.resumeList.find(r => r.type === 'tv' && String(r.id) === String(item.id) && r.season && r.episode) : null;
    const savedCatMovieResume = item.type === 'movie' ? Store.getResume('movie', item.id) : null;
    const hasCatMovieResume = !!savedCatMovieResume;
    const firstCatPlayableEp = item.type === 'tv' ? (item.raw?.episodes || []).find(ep => API.parseSources(ep.urls, ep.resolutions).some(s => s.url)) : null;
    // «⋯» only when it has something to show: the phone hides «Copiar enlace TMDB», so without a resume there it would open empty.
    const phoneShell = Boolean(document.body?.classList?.contains?.('platform-android')) && !tvInterface();
    const catMoreActions = (catSeriesResume || hasCatMovieResume ? '<button class="btn" id="btnRemoveResume">Quitar de continuar</button>' : '')
      + (phoneShell ? '' : '<button class="btn" id="btnShare"><svg class="icon" aria-hidden="true"><use href="#i-link"/></svg>Copiar enlace TMDB</button>');
    $('#tbTitle').textContent = item.title || (item.type === 'tv' ? 'Serie' : 'Película');
    content().innerHTML = `
      <div class="view detail-view detail-${item.type === 'tv' ? 'tv' : 'movie'}">
        ${catalogHeroHtml(item, `
                ${Platform.availabilityAlerts?'<button class="btn" id="btnAvailabilityAlert">Avisarme cuando haya una fuente</button>':''}
                ${qualities.length && qualities[0].url ? '<button class="btn primary" id="btnPlaySel"><svg class="icon" aria-hidden="true"><use href="#i-play"/></svg>Reproducir</button><button class="btn" id="btnDownloadSel"><svg class="icon" aria-hidden="true"><use href="#i-download"/></svg>Descargar</button>' : catSeriesResume ? `<button class="btn primary" id="btnResumeSeries"><svg class="icon" aria-hidden="true"><use href="#i-play"/></svg>Continuar T${catSeriesResume.season}·E${catSeriesResume.episode}</button>` : firstCatPlayableEp ? `<button class="btn primary" id="btnPlayFirstEp"><svg class="icon" aria-hidden="true"><use href="#i-play"/></svg>Reproducir T${firstCatPlayableEp.season}·E${firstCatPlayableEp.episode}</button>` : item.type==='tv'?(Platform.isIos&&item.episodeError?iosSourcesNotice():`<span class="chip">${esc(item.episodeError || 'Elige un episodio para reproducir')}</span>`):''}
                ${item.type==='movie'?sourceStatusMarkup(qualities,additional):''}
                <button class="btn ${fav ? 'danger-ghost' : ''}" id="btnFav" aria-pressed="${fav}">${favInner(fav)}</button>
                ${seriesQualityButton(item.type)}
                ${catMoreActions ? `<details class="d-more"><summary class="btn d-more-btn" aria-label="Más acciones">⋯</summary><div class="d-more-panel">${catMoreActions}</div></details>` : ''}`, qualities.length ? qualityPicker(qualities) : '', item.type === 'movie' ? qualityTier(qualities) : '')}
        ${item.type === 'tv' && item.raw && Array.isArray(item.raw.episodes) && item.raw.episodes.length ? catalogEpisodes(item) : ''}
        <div id="detailDiscovery"></div>
      </div>`;
    wireBackdrops();
    // Si la nota llega después del pintado, se agrega sin volver a dibujar la ficha.
    const ratedAtPaint = NebulaUI.ratingValue(item.rating) !== null;
    if (!ratedAtPaint) ratingReady.then(() => { if (currentRoute !== route || NebulaUI.ratingValue(item.rating) === null) return; const slot = $('#catalogRating'); if (slot) slot.innerHTML = detailRatingChip(item.rating); });

    $$('.detail-tab').forEach(tabBtn => tabBtn.addEventListener('click', () => {
      $$('.detail-tab').forEach(b => b.classList.toggle('active', b === tabBtn));
      if (tabBtn.dataset.dtab === 'seasons') $('#catEps')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      else content().scrollTo({ top: 0, behavior: 'smooth' });
    }));

    wireDiscovery(item,item.type,route,!!(qualities.length||firstCatPlayableEp||catSeriesResume));
    wireSeriesQuality();
    if($('#retrySources'))$('#retrySources').onclick=()=>{API.invalidate();renderCatalogDetail(id,catalogUrl);};
    if ($('#btnResumeSeries') && catSeriesResume) {
      $('#btnResumeSeries').onclick = () => resumeItem('tv', item.id, Number(catSeriesResume.season), Number(catSeriesResume.episode), { trigger: $('#btnResumeSeries') });
    }
    if ($('#btnPlayFirstEp') && firstCatPlayableEp) {
      $('#btnPlayFirstEp').onclick = () => {
        const sNum = Number(firstCatPlayableEp.season);
        const eNum = Number(firstCatPlayableEp.episode);
        const seasonEps = (item.raw?.episodes || []).filter(ep => Number(ep.season) === sNum);
        const urls = pickEpisodeUrls(seasonEps, eNum);
        if (urls.length) openEpisode(item, sNum, eNum, urls[0].url, urls[0].name, seasonEps);
      };
    }
    if ($('#btnRemoveResume')) {
      $('#btnRemoveResume').onclick = () => {
        Store.removeResume(item.type, item.id);
        const more = $('#btnRemoveResume').closest('.d-more');
        $('#btnRemoveResume').remove();
        if (more && !more.querySelector('.d-more-panel .btn')) more.remove();
        toast('Quitado de continuar viendo');
      };
    }
    if ($('#btnPlaySel')) $('#btnPlaySel').onclick = () => {
      const sel = selectedQuality() || qualities[0];
      if (!sel || !sel.url) { toast('No hay URL a reproducir, prueba con otra calidad.'); return; }
      busyWhile($('#btnPlaySel'), playVerified({
        type: item.type, id: item.id, title: item.title, originalTitle: item.originalTitle, year: item.year, poster: item.poster, backdrop: item.backdrop, kind: 'stream',
        url: sel.url, urls: allQualities.filter((q) => q.url).map((q) => ({ name: q.name, size: q.size, url: q.url })),
      }));
    };
    if ($('#btnDownloadSel')) $('#btnDownloadSel').onclick = () => {
      const sel = selectedQuality() || qualities[0];
      if (!sel.url) { toast('No hay URL a descargar, prueba con otra calidad.'); return; }
      startDownloadFlow({ url: sel.url, filename: `${item.title} ${sel.name}.mp4`, title: item.title, quality: sel.name, size: sel.size, meta: { type: item.type, id: item.id, title: item.title, art: item.backdrop || item.poster || '' } });
    };
    $('#btnFav').onclick = () => {
      const on = Store.toggleFavorite({ type: item.type, id: item.id, title: item.title, poster: item.poster, year: item.year,rating:item.rating, kind: 'catalog', catalogUrl });
      $('#btnFav').innerHTML = favInner(on);
      $('#btnFav').setAttribute('aria-pressed',String(on));
      $('#btnFav').className = `btn ${on ? 'danger-ghost' : ''}`;
      toast(on ? 'Agregado a Mi lista' : 'Quitado de Mi lista');
    };
    if ($('#btnShare')) $('#btnShare').onclick = () => {
      Platform.clipboardWrite(`https://www.themoviedb.org/${item.type === 'tv' ? 'tv' : 'movie'}/${item.id}`);
      toast('URL copiada');
    };
    wireQualityPicker(qualities, savedCatMovieResume?.source);
    verifyQualityBox(qualities);
    if (item.type === 'tv' && item.raw && Array.isArray(item.raw.episodes)) {
      wireCatalogEpisodes(item);
    }
  }

  function catalogEpisodes(item) {
    const seasons = [...new Set(item.raw.episodes.map((e) => Number(e.season)))].sort((a, b) => a - b);
    const savedResume = Store.resumeList.find(r => r.type === 'tv' && String(r.id) === String(item.id));
    const initialSeason = seasons.includes(Number(savedResume?.season)) ? Number(savedResume.season) : seasons[0];
    return `
      <div class="row-head episodes-head"><h2><span class="seasons-head-full">Capítulos</span><span class="seasons-head-short">Episodios</span></h2><span class="seasons-count" aria-hidden="true"></span></div>
      <div class="seasons-tabs">${seasons.map((s) => `<button class="season-tab ${s === initialSeason ? 'active' : ''}" data-s="${s}">Temporada ${s}</button>`).join('')}</div>
      <div class="episodes" id="catEps"></div>`;
  }

  function wireCatalogEpisodes(item) {
    const tabs = $$('#content .season-tab');
    const load = (s) => {
      const eps = item.raw.episodes.filter((e) => Number(e.season) === Number(s));
      const box = $('#catEps');
      const countNode = $('#content .detail-view .seasons-count'); if (countNode) countNode.textContent = eps.length ? String(eps.length) : '';
      box.innerHTML = eps.map((e) => {
        const watched = Store.isEpisodeWatched(item.type, item.id, e.season, e.episode);
        const urls = listPlayableSources(API.parseSources(e.urls, e.resolutions));
        const resume = Store.getResume(item.type, item.id, e.season, e.episode);
        const pct = resume && resume.duration ? Math.min(100, Math.round((resume.position / resume.duration) * 100)) : 0;
        return `
          <div class="episode" data-season="${e.season}" data-ep="${e.episode}" data-e="${e.episode}">
            <div class="ep-still">${e.stillPath ? `<img alt="" src="${esc(e.stillPath)}" loading="lazy"/>` : `<div class="ph">${icon('film')}</div>`}${pct ? `<div class="ep-progress" style="width:${pct}%"></div>` : ''}</div>
            <div class="ep-body">
              <div class="ep-meta">
                <div class="ep-num"><span class="ep-code">S${String(e.season).padStart(2, '0')}E${String(e.episode).padStart(2, '0')} · </span>T${e.season} · E${e.episode}${Number(e.runtime) > 0 ? `<span class="ep-runtime"> · ${Math.round(Number(e.runtime))} min</span>` : ''} ${watched ? '<span class="ep-watched-badge">✓ visto</span>' : ''}</div>
                <div class="ep-name">${esc(e.name || `Episodio ${e.episode}`)}</div>
                <div class="ep-over">${esc(e.overview || '')}</div>
              </div>
              ${episodeActionsMarkup(urls, watched, true, 'Sin fuentes disponibles en este capítulo', resume?.source)}
            </div>
          </div>`;
      }).join('');
      $$('#catEps .episode').forEach((epDiv) => {
        wireEpisodeCard(epDiv);
        wireEpisodeQualitySelect(epDiv);
      });
      $$('#catEps button').forEach((b) => b.addEventListener('click', async (ev) => {
        ev.stopPropagation();
        const epDiv = b.closest('.episode');
        const sNum = Number(epDiv.dataset.season);
        const eNum = Number(epDiv.dataset.ep);
        const ep = eps.find((x) => Number(x.season) === sNum && Number(x.episode) === eNum);
        if (b.dataset.play) {
          if (!(await ensurePlaybackAccess({ type: item.type }))) return;
          const nxt = item.raw.episodes.find((x) => Number(x.season) === sNum && Number(x.episode) === eNum + 1)
            || item.raw.episodes.find((x) => Number(x.season) === sNum + 1 && Number(x.episode) === 1);
          const baseTitle = String(item.title || '').replace(/\s*—\s*T\d+·E\d+.*$/, '');
          Player.open({
            type: item.type, id: item.id, title: `${baseTitle} — T${sNum}·E${eNum}`, poster: item.poster, backdrop: item.backdrop,
            catalogUrl: item.catalogUrl,
            kind: 'stream', url: b.dataset.url,
            urls: listPlayableSources(API.parseSources(ep.urls, ep.resolutions)),
            season: sNum, episode: eNum,
            nextEpisode: nxt ? {
              label: `T${nxt.season}·E${nxt.episode}`,
              open: () => {
                const u = API.parseSources(nxt.urls, nxt.resolutions).find(source => source.url)?.url;
                if (u) openEpisode(item, Number(nxt.season), Number(nxt.episode), u, '', item.raw.episodes.filter(ep => Number(ep.season) === Number(nxt.season)));
              },
            } : null,
          });
        } else if (b.dataset.dl) {
          startDownloadFlow({ url: b.dataset.url, filename: `${item.title} T${sNum}E${eNum} ${b.dataset.name}.mp4`, title: item.title, quality: b.dataset.name, meta: { type: 'tv', id: item.id, title: item.title, season: sNum, episode: eNum, art: b.closest('.episode')?.querySelector('.ep-still img')?.src || item.backdrop || item.poster || '' } });
        } else if (b.dataset.skip) {
          editSkipTimes(item.id, sNum, eNum);
        } else if (b.dataset.mark) {
          Store.toggleWatchedEpisode(item.type, item.id, sNum, eNum);
          load(sNum);
        }
      }));
    };
    tabs.forEach((t) => t.addEventListener('click', () => {
      tabs.forEach((x) => x.classList.remove('active'));
      t.classList.add('active');
      load(Number(t.dataset.s));
    }));
    const activeTab = $('#content .season-tab.active') || tabs[0];
    if (activeTab) load(Number(activeTab.dataset.s));
  }

  /* ============================ Mi Lista ============================ */
  /* Escritorio (EscritorioBiblioteca): menú contextual de una tarjeta de «Continuar» junto al puntero,
     con Reanudar (Enter), Abrir ficha y Quitar de continuar (Supr). Escape, un clic fuera o desplazarse lo cierran. */
  let contextMenuState = null;
  function closeContextMenu(returnFocus = false) {
    if (!contextMenuState) return;
    const { menu, card, cleanup } = contextMenuState;
    contextMenuState = null;
    cleanup();
    menu.remove();
    if (returnFocus && card?.isConnected) card.focus({ preventScroll: true });
  }
  function openResumeDetail(type, id) {
    const saved = Store.resumeList.find(item => item.type === type && String(item.id) === String(id));
    if (saved && ['archive', 'jellyfin'].includes(saved.kind)) { go('source', { kind: saved.kind, id }); return; }
    let item = null;
    try { item = API.findCatalogItem(type, id); } catch {}
    if (item && !String(id).startsWith('nebula:')) go('catalog', { id: item.id, catalogUrl: item.catalogUrl });
    else go(type === 'tv' ? 'tv' : 'movie', { id });
  }
  function openResumeMenu(card, x, y, remove) {
    closeContextMenu();
    const type = card.dataset.resumeType, id = card.dataset.resumeId;
    const title = card.querySelector('.resume-card-title')?.textContent || '';
    const detail = [card.querySelector('.resume-card-ctx')?.textContent, card.querySelector('.resume-card-left')?.textContent].filter(Boolean).join(' · ');
    const menu = document.createElement('div');
    menu.className = 'ctx-menu';
    menu.setAttribute('role', 'menu');
    menu.setAttribute('aria-label', title);
    menu.innerHTML = `<div class="ctx-head" aria-hidden="true"><b>${esc(title)}</b><span>${esc(detail)}</span></div>
      <button type="button" role="menuitem" data-ctx="resume">${icon('play')}<span>Reanudar</span><kbd>Enter</kbd></button>
      <button type="button" role="menuitem" data-ctx="open">${icon('info')}<span>Abrir ficha</span></button>
      <hr aria-hidden="true">
      <button type="button" role="menuitem" class="ctx-danger" data-ctx="remove">${icon('close')}<span>Quitar de continuar</span><kbd>Supr</kbd></button>`;
    document.body.appendChild(menu);
    const width = menu.offsetWidth, height = menu.offsetHeight;
    menu.style.left = Math.max(8, Math.min(x, innerWidth - width - 8)) + 'px';
    menu.style.top = Math.max(8, Math.min(y, innerHeight - height - 8)) + 'px';
    const items = [...menu.querySelectorAll('[role="menuitem"]')];
    const actions = { resume: () => card.click(), open: () => openResumeDetail(type, id), remove: () => remove(card) };
    items.forEach(button => button.addEventListener('click', () => { const action = actions[button.dataset.ctx]; closeContextMenu(button.dataset.ctx !== 'open' && button.dataset.ctx !== 'remove'); action(); }));
    menu.addEventListener('keydown', (event) => {
      const index = items.indexOf(document.activeElement);
      if (event.key === 'Escape' || event.key === 'Tab') { event.preventDefault(); event.stopPropagation(); closeContextMenu(true); }
      else if (event.key === 'ArrowDown' || event.key === 'ArrowUp') { event.preventDefault(); items[(index + (event.key === 'ArrowDown' ? 1 : items.length - 1)) % items.length].focus(); }
      else if (event.key === 'Home' || event.key === 'End') { event.preventDefault(); items[event.key === 'Home' ? 0 : items.length - 1].focus(); }
      else if (event.key === 'Delete') { event.preventDefault(); closeContextMenu(); remove(card); }
    });
    const outside = (event) => { if (!menu.contains(event.target)) closeContextMenu(); };
    const dismiss = () => closeContextMenu();
    setTimeout(() => document.addEventListener('pointerdown', outside, true), 0);
    content()?.addEventListener?.('scroll', dismiss, { passive: true });
    window.addEventListener('resize', dismiss);
    window.addEventListener('blur', dismiss);
    contextMenuState = { menu, card, cleanup: () => { document.removeEventListener('pointerdown', outside, true); content()?.removeEventListener?.('scroll', dismiss); window.removeEventListener('resize', dismiss); window.removeEventListener('blur', dismiss); } };
    items[0].focus({ preventScroll: true });
  }

  function renderMyList(params = {}) {
    const tab = params.tab || 'favorites';
    const libraryType=['movie','tv'].includes(params.type)?params.type:'';
    const inLibrary=item=>!libraryType||item.type===libraryType;
    Object.assign(currentRoute.params,{tab,type:libraryType});
    content().innerHTML = `
      <div class="view">
        <header class="page-heading page-heading-split sr-only"><div><h1>Tu biblioteca</h1></div><button class="btn" id="libraryDownloads">${icon('download')}Descargas</button></header>
        <h1 class="library-phone-title" aria-hidden="true">Biblioteca</h1>
        <div class="tabs">
          <button data-tab="continue" class="${tab === 'continue' ? 'active' : ''}">Continuar</button>
          <button data-tab="favorites" class="${tab === 'favorites' ? 'active' : ''}">Favoritos</button>
          <button data-tab="history" class="${tab === 'history' ? 'active' : ''}">Historial</button>
          <button data-tab="watched" class="${tab === 'watched' ? 'active' : ''}">Vistos</button>
          ${Platform.availabilityAlerts?`<button data-tab="alerts" class="${tab==='alerts'?'active':''}">Alertas</button>`:''}
          <button type="button" class="library-downloads-tab" id="libraryDownloadsTab">Descargas</button>
        </div>
        <div class="browse-filters library-filters"><label for="libraryType">Tipo de contenido<select id="libraryType"><option value="">Películas y series</option><option value="movie">Películas</option><option value="tv">Series</option></select></label>${Platform.isAndroid?`<button type="button" class="btn" id="libraryDownloadsQuick">${icon('download')}Descargas</button>`:''}</div><div id="listBox"></div>
      </div>`;
    $('#libraryDownloads').onclick=()=>go('downloads');
    if($('#libraryDownloadsQuick'))$('#libraryDownloadsQuick').onclick=()=>go('downloads');
    if($('#libraryDownloadsTab'))$('#libraryDownloadsTab').onclick=()=>go('downloads');
    $$('.tabs button[data-tab]').forEach((b) => b.addEventListener('click', () => {const tab=b.dataset.tab;renderMyList({tab,type:''});if(tvInterface())$(`#content .tabs button[data-tab="${tab}"]`)?.focus({preventScroll:true});}));
    $('#libraryType').value=libraryType;$('#libraryType').onchange=()=>{renderMyList({tab,type:$('#libraryType').value});$('#libraryType').focus();};
    const box = $('#listBox');
    // Celular: las pestañas vacías usan el mismo estado que Favoritos y Descargas (canvas «Biblioteca vacía»).
    const phoneLibrary = Boolean(document.body?.classList?.contains?.('platform-android')) && !tvInterface();
    if(tab==='alerts'&&Platform.availabilityAlerts){
      const route=currentRoute;box.innerHTML='<p>Consultando tus alertas…</p>';
      Platform.alertsCall('list').then(items=>{if(currentRoute!==route||currentRoute.params.tab!=='alerts')return;const values=items.filter(inLibrary);box.innerHTML=phoneLibrary&&!values.length?stateMessage({art:'bell',title:'No tienes alertas guardadas',detail:'Recibirás avisos cuando aparezca una fuente. La revisión se realiza periódicamente en este dispositivo.'}):'<p>Recibirás avisos cuando aparezca una fuente. La revisión se realiza periódicamente en este dispositivo.</p>'+(values.length?'<div class="grid">'+values.map(item=>'<div>'+posterCard({...item,kind:'tmdb',id:Number(item.id)})+'<p>'+(item.state==='ready'?'Ya tiene una fuente':'Esperando una fuente')+'</p><button class="btn" data-remove-alert="'+esc(item.type+':'+item.id)+'">Quitar alerta</button></div>').join('')+'</div>':'<p>No tienes alertas guardadas.</p>');$$('[data-remove-alert]',box).forEach(button=>button.onclick=async()=>{const item=items.find(item=>item.type+':'+item.id===button.dataset.removeAlert);if(item){await Platform.alertsCall('toggle',item);renderMyList({tab:'alerts',type:libraryType});}});}).catch(()=>{box.textContent='No se pudieron consultar las alertas. Vuelve a intentar.';});
    }else if (tab === 'favorites') {
      const favs = Store.favorites.filter(inLibrary);
      box.innerHTML = favs.length ? `<div class="grid">${favs.map((f) => posterCard({
        type: f.type, id: f.id, title: f.title, poster: f.poster, year: f.year,rating:f.rating, kind: f.kind || 'tmdb', catalogUrl: f.catalogUrl,
      })).join('')}</div>` : stateMessage({art:'heart',title:'Aún no tienes favoritos',detail:tvInterface()?'Pulsa «Mi lista» en cualquier título.':'Toca el corazón en cualquier título.',actions:[{id:'libraryExplore',label:'Explorar catálogo',primary:true}]});
      if($('#libraryExplore'))$('#libraryExplore').onclick=()=>go('browse');
      $$('.poster',box).forEach(card=>{
        if(card.querySelector('.poster-remove'))return;
        card.classList.add('poster-removable');
        const remove=event=>{
          if(event){event.preventDefault();event.stopPropagation();}
          const type=card.dataset.type,id=card.dataset.id;
          Store.toggleFavorite({type,id});
          renderMyList({tab:'favorites',type:libraryType});
          toastAction('Quitado de favoritos','Deshacer',()=>{
            Store.toggleFavorite({type,id});
            renderMyList({tab:'favorites',type:libraryType});
            toast('Restaurado en favoritos');
          });
        };
        const button=document.createElement('button');
        button.type='button';
        button.className='poster-remove flag-circle';
        button.title='Quitar de favoritos';
        button.setAttribute('aria-label','Quitar de favoritos');
        // Phone (canvas «Biblioteca · Quitado de favoritos»): a filled heart that removes the title; elsewhere a trash badge.
        button.innerHTML=icon(Platform.isAndroid&&!tvInterface()?'heart':'trash');
        button.addEventListener('click',remove);
        const heart=card.querySelector('.poster-flags .flag-circle.fav');
        const flags=card.querySelector('.poster-flags');
        if(heart)heart.after(button);
        else if(flags)flags.appendChild(button);
        else (card.querySelector('.poster-art')||card).appendChild(button);
        card.addEventListener('contextmenu',event=>{event.preventDefault();remove(event);});
        card.addEventListener('keydown',event=>{
          if(event.key!=='Delete'&&event.key!=='Backspace')return;
          remove(event);
        });
      });
    } else if (tab === 'history') {
      const entries=[...Store.resumeList,...Store.watchedTitlesList].filter(inLibrary).sort((a,b)=>(b.updatedAt||b.at||0)-(a.updatedAt||a.at||0));
      const newest=new Map();for(const item of entries){const key=`${item.type}:${item.id}`;if(!newest.has(key))newest.set(key,item);}const unique=[...newest.values()];
      box.innerHTML=unique.length?`<div class="row-head"><h2>Recientes (${unique.length})</h2><button class="btn" id="btnClearHistory">Limpiar historial</button></div><div class="grid">${unique.map(item=>posterCard(item)).join('')}</div>`:emptyState('▶','Tu historial aparecerá después de reproducir o marcar un título como visto.');
      if ($('#btnClearHistory')) $('#btnClearHistory').onclick = () => { Store.clearWatchHistory(); renderMyList({ tab: 'history', type: libraryType }); toast('Historial de reproducción borrado'); };
    } else if (tab === 'continue') {
      const list = Store.resumeList.filter(inLibrary);
      // En el celular «Continuar» es una lista de tarjetas con progreso (canvas Celular · Biblioteca);
      // en el escritorio, una grilla de esas tarjetas (canvas Escritorio · Biblioteca).
      const androidShell = Boolean(document.body?.classList?.contains?.('platform-android'));
      // Celular, tableta (tres columnas) y escritorio muestran «En curso» como tarjetas de continuar; la TV, en pósters.
      const resumeLayout = !tvInterface() && !document.body?.classList?.contains?.('platform-tv');
      box.innerHTML = list.length ? `<div class="row-head"><h2>En curso (${list.length})</h2><span class="library-hint" aria-hidden="true"><kbd>Supr</kbd>para quitar</span><button class="btn" id="btnClearContinue">Limpiar en curso</button></div>${resumeLayout ? `<div class="resume-list">${resumeCards(list)}</div>` : `<div class="grid">${list.map(it => posterCard(it, true)).join('')}</div>`}` : phoneLibrary ? stateMessage({art:'play',title:'Nada en curso',detail:'Lo que dejes a medias aparecerá aquí.',actions:[{id:'libraryExplore',label:'Explorar catálogo',primary:true}]}) : emptyState('▶', 'Nada en curso. Lo que dejes a medias aparecerá aquí.');
      if($('#libraryExplore'))$('#libraryExplore').onclick=()=>go('browse');
      const desktopLibrary = !androidShell && !tvInterface();
      const removeResumeCard = (card) => {
        const type = card.dataset.resumeType, id = card.dataset.resumeId, season = Number(card.dataset.resumeSeason), episode = Number(card.dataset.resumeEpisode);
        const saved = Store.getResume(type, id, season, episode);
        Store.removeResume(type, id, season, episode);
        renderMyList({ tab: 'continue', type: libraryType });
        toastAction('Quitado de continuar', 'Deshacer', () => {
          if (saved) Store.saveResume(type, id, saved);
          renderMyList({ tab: 'continue', type: libraryType });
        });
      };
      $$('.resume-list .resume-card', box).forEach((card) => {
        card.onclick = () => resumeItem(card.dataset.resumeType, card.dataset.resumeId, Number(card.dataset.resumeSeason), Number(card.dataset.resumeEpisode), { trigger: card });
        // Phone: the ficha has no «⋯» (canvas «Ficha de película»), so a long press removes the card, with «Deshacer».
        if (androidShell && !tvInterface()) card.addEventListener('contextmenu', (event) => { event.preventDefault(); removeResumeCard(card); });
        if (!desktopLibrary) return;
        card.setAttribute('aria-haspopup', 'menu');
        card.addEventListener('contextmenu', (event) => { event.preventDefault(); openResumeMenu(card, event.clientX, event.clientY, removeResumeCard); });
        card.addEventListener('keydown', (event) => {
          if (event.key === 'Delete' || event.key === 'Backspace') { event.preventDefault(); removeResumeCard(card); }
          else if (event.key === 'ContextMenu' || (event.shiftKey && event.key === 'F10')) { event.preventDefault(); const rect = card.getBoundingClientRect(); openResumeMenu(card, rect.left + 24, rect.top + rect.height / 2, removeResumeCard); }
        });
      });
      if ($('#btnClearContinue')) $('#btnClearContinue').onclick = () => { Store.clearResume(); renderMyList({ tab: 'continue', type: libraryType }); toast('Lista de continuar viendo vaciada'); };
    } else {
      const seen = Store.watchedTitlesList.filter(inLibrary).map(it => { const item = API.findCatalogItem(it.type, it.id); return item ? { ...it, ...item } : it; });
      const watchedEps = (libraryType==='movie'?[]:Store.watchedEpisodesList).map(it => ({ ...it, seriesTitle: it.seriesTitle || API.findCatalogItem('tv', it.seriesId)?.title }));
      let html = '';
      if (seen.length) html += `<div class="row-head"><h2>Películas vistas</h2></div><div class="grid">${seen.map((it) => posterCard(it)).join('')}</div>`;
      if (watchedEps.length) {
        html += `<div class="row-head"><h2>Capítulos vistos</h2></div><div class="episodes">${watchedEps.map((w) => `
          <div class="episode" role="button" tabindex="0" data-open-series="${esc(w.seriesId)}">
            <div class="ep-still"><div class="ph">${icon('film')}</div></div>
            <div class="ep-body"><div class="ep-meta"><div class="ep-num">T${esc(w.season)} · E${esc(w.episode)} <span class="ep-watched-badge">✓ visto</span></div>
            <div class="ep-name">${esc(w.seriesTitle || `TMDB ${w.seriesId}`)}</div></div>
            <div class="ep-actions"><button type="button" data-unwatch-ep="1" data-sid="${esc(w.seriesId)}" data-s="${esc(w.season)}" data-e="${esc(w.episode)}">Quitar visto</button></div></div>
          </div>`).join('')}</div>`;
      }
      box.innerHTML = html || (phoneLibrary ? stateMessage({art:'check',title:'Aún no hay nada visto',detail:'Marca capítulos o películas como vistos para verlos aquí.'}) : emptyState('✓', 'Marca capítulos o películas como vistos para verlos aquí.'));
      $$('#listBox .episode[data-open-series]').forEach((epRow) => {
        const openSeries = () => {
          const sid = epRow.dataset.openSeries;
          const catItem = API.findCatalogItem('tv', sid);
          if (catItem && catItem.catalogUrl) go('catalog', { id: sid, catalogUrl: catItem.catalogUrl });
          else go('tv', { id: sid });
        };
        epRow.addEventListener('click', openSeries);
        epRow.addEventListener('keydown', (ev) => { if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); openSeries(); } });
      });
      $$('#listBox button[data-unwatch-ep]').forEach((btn) => {
        btn.addEventListener('click', (ev) => {
          ev.stopPropagation();
          Store.toggleWatchedEpisode('tv', btn.dataset.sid, Number(btn.dataset.s), Number(btn.dataset.e));
          toast('Quitado de vistos');
          renderMyList({ tab: 'watched', type: libraryType });
        });
      });
    }
    wirePosters();
  }

  function emptyState(kind, text) {
    const illustration=icon(({"🤍":"heart","▶":"play","✓":"check","🎬":"film","⬇️":"download","📜":"folder"})[kind]||"info");
    return `<div class="empty-state"><div class="big">${illustration}</div><div>${esc(text)}</div></div>`;
  }

  /* ============================ Descargas ============================ */
  async function renderDownloads() {
    if((Platform.isIos||Platform.isTizen)&&!Platform.offlineDownloads){content().innerHTML='<div class="view"><header class="page-heading"><h1>Descargas</h1><p>Las descargas sin conexión no están disponibles en esta plataforma.</p></header></div>';return;}
    if(Platform.isAndroid&&!Platform.offlineDownloads){content().innerHTML='<div class="view"><header class="page-heading"><h1>Descargas</h1><p>Para guardar videos sin conexión, instala la versión 1.12.3 para celular. Después recibirás las mejoras habituales desde la aplicación.</p></header><a class="btn primary" href="https://github.com/john2k2/nebula-actualizaciones/releases/download/native-v1.12.3/Nebula-Android-Celular-1.12.3-arm64-v8a-debug.apk" target="_blank" rel="noopener">Actualizar para usar descargas</a></div>';return;}
    const route=currentRoute,request=++downloadsRequest;
    const active = await Platform.downloadActive();
    const activeIds=new Set(active.map(entry=>entry.id));
    const history = (await Platform.historyList()).filter(entry=>!activeIds.has(entry.id));
    const ready=history.filter(entry=>entry.status==='completado');
    const pending=history.filter(entry=>entry.status!=='completado');
    if (currentRoute!==route||request!==downloadsRequest) return;
    // Phone (canvas «Biblioteca · Descargas»): Descargas is the last Biblioteca tab, under the same title and tab row.
    const libraryTabs = Boolean(document.body?.classList?.contains?.('platform-android')) && !tvInterface() && Number(globalThis.innerWidth) <= 760
      ?`<h1 class="library-phone-title" aria-hidden="true">Biblioteca</h1><div class="tabs">${[['continue','Continuar'],['favorites','Favoritos'],['watched','Vistos'],...(Platform.availabilityAlerts?[['alerts','Alertas']]:[])].map(([tab,label])=>`<button type="button" data-library-tab="${tab}">${label}</button>`).join('')}<button type="button" class="library-downloads-tab active" aria-current="page">Descargas</button><span class="tabs-end" aria-hidden="true"></span></div>`
      : '';
    content().innerHTML = `
      <div class="view downloads-view">
        ${libraryTabs}
        <header class="page-heading"><h1>Descargas</h1><p>${Platform.isAndroid?'Guarda videos para verlos sin conexión. Se eliminan al desinstalar la aplicación.':'Sigue tus descargas o reproduce un archivo de este equipo.'}</p></header>
        ${active.length+history.length?`<p class="dl-summary">${active.length+history.length===1?'1 descarga':(active.length+history.length)+' descargas'} · ${shortBytes([...active,...history].reduce((sum,entry)=>sum+(Number(entry.totalBytes)>0?Number(entry.totalBytes):Number(entry.bytes)||0),0))||'0 B'}</p>`:''}
        <div class="row-head"><h2>Descargas activas${active.length?` <span class="dl-count">${active.length}</span>`:''}</h2>${Platform.isAndroid?'':`<button class="btn" id="btnDownloadLocal">${icon('plus')}Archivo local</button>`}</div>
        <div id="activeBox">${active.length ? '' : '<div class="empty-state"><div class="big">'+icon('download')+'</div><div>Sin descargas activas</div></div>'}</div>
        <div id="historyBox"><h2 class="section-title dl-ready-title">Listas para ver sin conexión${ready.length?` <span class="dl-count">${ready.length}</span>`:''}</h2><div id="readyDownloads">${ready.length ? '' : '<p class="dl-empty">Tus videos aparecerán aquí cuando termine la descarga.</p>'}</div><h2 class="section-title dl-pending-title">Pausadas e interrumpidas${pending.length?` <span class="dl-count">${pending.length}</span>`:''}</h2><div id="pendingDownloads">${pending.length ? '' : '<p class="dl-empty">No hay descargas pendientes de continuar.</p>'}</div></div>
      </div>`;
    // «En cola · empieza después de La Odisea»: the title being downloaded now.
    const downloading=active.find(entry=>entry.status==='descargando');
    downloadQueueAhead=downloading?downloadPhoneParts({...downloading,status:''}).title:'';
    if(libraryTabs){
      const tabs=$('#content .downloads-view .tabs');if(tabs)tabs.scrollLeft=tabs.scrollWidth;
      if(!active.length&&!history.length)$('#content .downloads-view').insertAdjacentHTML('beforeend',stateMessage({art:'download',title:'Todavía no hay descargas',detail:'Descarga una película o un episodio para verlo sin conexión.',actions:[{id:'downloadsExplore',label:'Explorar catálogo',primary:true}]}));
      if($('#downloadsExplore'))$('#downloadsExplore').onclick=()=>go('browse');
      $('#content .downloads-view').classList.toggle('downloads-empty',!active.length&&!history.length);
    }
    const box = $('#activeBox');
    active.forEach((d) => box.insertAdjacentHTML('beforeend', downloadCard(d)));
    ready.slice().reverse().forEach(h=>$('#readyDownloads').insertAdjacentHTML('beforeend',historyCard(h)));
    pending.slice().reverse().forEach(h=>$('#pendingDownloads').insertAdjacentHTML('beforeend',historyCard(h)));
    $$('#content .downloads-view [data-library-tab]').forEach(button => button.onclick = () => go('mylist', { tab: button.dataset.libraryTab }));
    if($('#btnDownloadLocal')) $('#btnDownloadLocal').onclick = async () => {
      const f = await Platform.pickFile({ filters: [{ name: 'Video', extensions: ['mp4', 'mkv', 'webm', 'ts'] }] });
      if (f) playDownloaded(f);
    };
    wireDownloadCards();
  }

  function downloadPercent(d){return d.totalBytes>0?Math.max(0,Math.min(100,Math.floor(d.bytes/d.totalBytes*100))):0;}
  function downloadEstimate(d){
    if(d.status!=='descargando'||!(d.speed>0&&d.totalBytes>d.bytes))return '';
    const seconds=Math.ceil((d.totalBytes-d.bytes)/d.speed);
    return seconds<60?'Menos de un minuto':seconds<3600?'Aprox. '+Math.ceil(seconds/60)+' min':'Aprox. '+Math.floor(seconds/3600)+' h '+Math.ceil(seconds%3600/60)+' min';
  }
  // Canvas «Biblioteca · Descargas»: the state in words («42 % · 3,1 MB/s · quedan 6 min», «Pausada · 67 %»).
  function downloadStatusLabel(d){
    const pct=downloadPercent(d);
    if(d.status==='descargando'){const parts=[pct+' %'];if(d.speed>0)parts.push(fmtBytes(d.speed)+'/s');const eta=downloadEstimate(d).replace(/^Aprox\.\s*/,'');if(eta)parts.push(eta==='Menos de un minuto'?'menos de un minuto':'quedan '+eta);return parts.join(' · ');}
    return ({'en cola':'En cola','preparando':'Preparando…','verificando':'Verificando…','pausado':'Pausada · '+pct+' %','completado':'Lista para ver sin conexión','error':'No se pudo completar'})[d.status]||String(d.status||'');
  }
  function downloadButton(act,iconName,label,primary=false){return `<button type="button"${primary?' class="primary"':''} data-act="${act}" aria-label="${esc(label)}">${icon(iconName)}<span>${esc(label)}</span></button>`;}
  // Phone card (canvas «Biblioteca · Descargas»): art, title, «720p · 0,8 de 1,9 GB» and the state with its icon.
  const commaDecimal=text=>String(text).replace(/(\d)\.(\d)/g,'$1,$2');
  const BYTE_UNITS=['B','KB','MB','GB','TB'];
  const byteUnit=n=>{let i=0;while(n>=1024&&i<BYTE_UNITS.length-1){n/=1024;i++;}return i;};
  const inUnit=(n,i)=>{const value=n/Math.pow(1024,i);return commaDecimal(value.toFixed(i===0||value>=100?0:1));};
  function shortBytes(n){if(!(n>0))return '';const i=byteUnit(n);return `${inUnit(n,i)} ${BYTE_UNITS[i]}`;}
  // «0,8 de 1,9 GB»: both numbers in the total's unit.
  function downloadSizeText(d,partial){
    const bytes=Number(d.bytes)||0,total=Number(d.totalBytes)||0;
    if(!(total>0))return shortBytes(bytes);
    if(!partial||!(bytes>0)||bytes>=total)return shortBytes(total);
    const i=byteUnit(total);
    return `${inUnit(bytes,i)} de ${inUnit(total,i)} ${BYTE_UNITS[i]}`;
  }
  let downloadQueueAhead='';
  function downloadPhoneParts(d){
    const meta=DownloadMeta.of(d)||{};
    const base=String(d.filename||'Video').replace(/\.(mp4|mkv|webm|ts|m4v)$/i,'');
    const ep=/\bT(\d{1,2})E(\d{1,3})\b/i.exec(base),res=/\b(\d{3,4}p|4K)\b/i.exec(base);
    const cut=[ep?.index,res?.index].filter(index=>index>0);
    const season=Number(meta.season)||(ep?Number(ep[1]):0),episode=Number(meta.episode)||(ep?Number(ep[2]):0);
    const quality=(typeof PlaybackTracks!=='undefined'&&PlaybackTracks.sourceParts?PlaybackTracks.sourceParts(meta.quality||'').resolution:'')||(res?res[0].toLowerCase().replace('4k','4K'):'');
    const partial=['descargando','preparando','verificando','pausado'].includes(d.status);
    const detail=[season&&episode?`T${season} · E${episode}`:quality,downloadSizeText(d,partial)].filter(Boolean).join(' · ');
    const status=d.status==='en cola'&&downloadQueueAhead?`En cola · empieza después de ${downloadQueueAhead}`:d.status==='error'?(publicMessage(d.note)||'No se pudo completar'):commaDecimal(downloadStatusLabel(d));
    const kind=d.status==='en cola'?'queued':d.status==='error'?'error':d.status==='completado'?'ready':d.status==='pausado'?'paused':'active';
    return {title:meta.title||(cut.length?base.slice(0,Math.min(...cut)).trim():base)||'Video',art:meta.art||'',detail,status,kind};
  }
  const DOWNLOAD_STATE_ICONS={queued:'<svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>',error:'<svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4l9 16H3z M12 10v4 M12 17v.01"/></svg>',ready:'<svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg>'};
  function downloadCard(d) {
    const active=['en cola','preparando','descargando','verificando'].includes(d.status),pct=downloadPercent(d);
    const note=d.note?publicMessage(d.note)||'Vuelve a intentar cuando tengas conexión.':'';
    const phone=downloadPhoneParts(d);
    return `<article class="dl-card" data-id="${esc(d.id)}" data-status="${esc(d.status||'')}" data-file="${esc(d.file||'')}" data-bytes="${Number(d.bytes)>0?Number(d.bytes):0}">
      <span class="dl-art"${phone.art?` style="background-image:url('${esc(phone.art)}')"`:''} aria-hidden="true"></span>
      <div class="dl-head"><h3 class="dl-title">${esc(phone.title)}</h3><span class="dl-detail">${esc(phone.detail)}</span></div>
      <div class="dl-state dl-state-${phone.kind}">${DOWNLOAD_STATE_ICONS[phone.kind]||''}<span>${esc(phone.status)}</span></div>
      <div class="dl-top"><div class="dl-name">${esc(d.filename||'Video')}</div><div class="dl-status ${d.status==='completado'?'ok':d.status==='error'?'err':active?'act':''}">${esc(downloadStatusLabel(d))}</div></div>
      <p class="dl-note">${esc(note)}</p>
      ${active||d.status==='pausado'?`<div class="dl-bar${active?'':' dl-bar-paused'}" role="progressbar" aria-label="Avance de descarga" aria-valuemin="0" aria-valuemax="100" ${d.totalBytes>0?`aria-valuenow="${pct}"`:''}><div style="transform:scaleX(${Math.max(0,Math.min(100,Number(pct)||0))/100})"></div></div>`:''}
      <div class="dl-info"><span data-dl-bytes>${fmtBytes(d.bytes)}${d.totalBytes>0?' / '+fmtBytes(d.totalBytes):''}</span><span data-dl-speed>${d.status==='descargando'&&d.speed>0?fmtBytes(d.speed)+'/s':''}</span><span data-dl-eta>${downloadEstimate(d)}</span></div>
      <div class="dl-actions">
        ${active?`${typeof Platform.downloadPause==='function'&&d.status!=='verificando'?downloadButton('pause','pause','Pausar'):''}${downloadButton('cancel','close','Cancelar')}`:d.status==='completado'?downloadButton('play','play','Reproducir',true):d.canRetry?downloadButton('retry','reload',d.status==='pausado'?(d.resumable?'Reanudar':'Continuar'):d.resumable?'Reanudar':'Reintentar',true):''}
        ${!active&&d.status==='completado'&&!Platform.isAndroid?'<button data-act="reveal" title="Abrir ubicación">Abrir ubicación</button>':''}
        ${!active?downloadButton('delete','trash',d.status==='completado'?'Borrar archivo':'Descartar descarga'):''}
        ${!active&&!Platform.isAndroid?'<button data-act="removeHistory" title="Quitar del historial">Quitar del historial</button>':''}
      </div></article>`;
  }
  function historyCard(h){return downloadCard(h);}

  async function playDownloaded(file, title) {
    const stat = await Platform.fileStat(file);
    if (!stat.exists) { toast('El archivo descargado ya no está en esa ubicación'); return; }
    const url = Platform.isAndroid ? file : 'file:///' + encodeURI(file.replace(/\\/g, '/')).replace(/#/g, '%23').replace(/\?/g, '%3F');
    return Player.open({ type: 'local', id: 'local:' + file, title: title || file.split(/[\\/]/).pop(), kind: 'local', playbackMode: 'manual', url });
  }

  // Canvas «Descargas · Borrar»: an in-app confirmation instead of the browser's confirm().
  function confirmDownloadDelete(name,bytes){
    return new Promise(resolve=>{
      let answered=false;const finish=value=>{if(answered)return;answered=true;resolve(value);};
      const freed=bytes>0?` y liberarás ${esc(fmtBytes(bytes))}`:'';
      showModal(`<div class="confirm-dialog"><h2>¿Borrar esta descarga?</h2><p>Se borrará <strong>${esc(name||'este video')}</strong> de este dispositivo${freed}. Para volver a verla sin conexión tendrás que descargarla de nuevo.</p><div class="confirm-item" aria-hidden="true"><span class="confirm-item-art"></span><span class="confirm-item-text"><b>${esc(name||'Video')}</b>${bytes>0?`<span>${esc(fmtBytes(bytes))}</span>`:''}</span></div><div class="m-actions confirm-actions"><button type="button" class="btn primary" id="deleteConfirm">${icon('trash')}Borrar</button><button type="button" class="btn" id="deleteCancel">Cancelar</button></div></div>`,()=>{
        $('#deleteConfirm').onclick=()=>{finish(true);closeModal();};
        $('#deleteCancel').onclick=()=>{finish(false);closeModal();};
      },()=>finish(false));
    });
  }

  function wireDownloadCards() {
    $$('.downloads-view .dl-card').forEach(card=>card.querySelectorAll('button').forEach(button=>button.addEventListener('click',async()=>{
      if(button.disabled)return;
      const {id,file}=card.dataset,act=button.dataset.act;
      if(act==='delete'&&!await confirmDownloadDelete(card.querySelector('.dl-name')?.textContent,Number(card.dataset.bytes)||0))return;
      button.disabled=true;
      try{
        if(act==='pause'){if(!await Platform.downloadPause(id))throw Error('La descarga terminó o está verificándose.');toast('Descarga pausada');}
        else if(act==='cancel'){if(!await Platform.downloadCancel(id))throw Error('La descarga ya terminó.');toast('Descarga cancelada');}
        else if(act==='retry')await Platform.downloadRetry(id);
        else if(act==='play'){await playDownloaded(file,card.querySelector('.dl-name').textContent);return;}
        else if(act==='reveal'){await Platform.fileReveal(file);return;}
        else if(act==='delete'){
          if(Platform.isAndroid)await Platform.downloadRemove(id);
          else{const st=await Platform.fileStat(file);if(st.exists)await Platform.fileDelete(file);await Platform.downloadRemove(id);await Platform.historyMutate({kind:'remove',id});}
          toast('Descarga eliminada');
        }else if(act==='removeHistory'){await Platform.downloadRemove(id);await Platform.historyMutate({kind:'remove',id});toast('Archivo conservado; historial quitado');}
        if(currentView==='downloads')await renderDownloads();
      }catch(error){toast(publicMessage(error.message)||'No se pudo completar la acción. Vuelve a intentar.');}
      finally{button.disabled=false;}
    })));
  }

  // Inicio offline (canvas «Inicio · Sin conexión»): what was downloaded carries «Descargada» (poster) or «Descargado»
  // (Seguir viendo); everything else is dimmed and says «Requiere conexión» to screen readers.
  async function markOfflineDownloads(route){
    let history=[];try{history=await Platform.historyList();}catch{}
    if(currentRoute!==route)return;
    const titles=new Set(),episodes=new Set();
    for(const entry of history||[]){
      if(entry.status!=='completado')continue;
      const meta=DownloadMeta.of(entry);if(!meta?.type||meta.id==null)continue;
      titles.add(`${meta.type}:${meta.id}`);
      if(meta.season&&meta.episode)episodes.add(`${meta.type}:${meta.id}:${meta.season}:${meta.episode}`);
    }
    const view=$('#content .home-view');if(!view)return;
    const offlineLabel=(node,label)=>{if(!/Requiere conexión$/.test(node.getAttribute('aria-label')||''))node.setAttribute('aria-label',label+' · Requiere conexión');};
    $$('.poster[data-type][data-id]',view).forEach(card=>{
      const has=titles.has(`${card.dataset.type}:${card.dataset.id}`);
      card.classList.toggle('poster-downloaded',has);card.classList.toggle('poster-offline',!has);
      const art=card.querySelector('.poster-art');
      if(has&&art&&!art.querySelector('.poster-dl-badge'))art.insertAdjacentHTML('beforeend',`<span class="poster-dl-badge">${icon('download')}Descargada</span>`);
      if(!has)offlineLabel(card,card.getAttribute('aria-label')||'');
    });
    $$('.resume-card',view).forEach(card=>{
      const key=`${card.dataset.resumeType}:${card.dataset.resumeId}`,season=Number(card.dataset.resumeSeason);
      const has=season?episodes.has(`${key}:${season}:${card.dataset.resumeEpisode}`):titles.has(key);
      card.classList.toggle('resume-offline',!has);
      const left=card.querySelector('.resume-card-left');
      if(has&&left&&!card.querySelector('.resume-dl-chip')){const foot=document.createElement('span');foot.className='resume-card-foot';left.before(foot);foot.insertAdjacentHTML('beforeend',`<span class="resume-dl-chip">${icon('download')}${season?'Descargado':'Descargada'}</span>`);foot.appendChild(left);}
      if(!has)offlineLabel(card,card.querySelector('.resume-card-title')?.textContent||'');
    });
  }
  // What a download is (title, art, episode), kept by the interface because the native list only stores the file name.
  // Descargas draws its cards from it (canvas «Biblioteca · Descargas») and offline rows mark what is downloaded.
  const DownloadMeta = {
    all() { const value = Store.settings.downloadMeta; return value && typeof value === 'object' ? value : {}; },
    set(keys, meta) {
      const map = { ...this.all() };
      for (const key of keys) if (key) map[key] = { ...meta, at: Date.now() };
      const recent = Object.entries(map).sort((a, b) => (b[1].at || 0) - (a[1].at || 0)).slice(0, 300);
      Store.setSetting('downloadMeta', Object.fromEntries(recent));
    },
    of(entry) { const map = this.all(); return map[entry?.id] || map[entry?.filename] || null; },
  };
  async function startDownloadFlow({ url, filename, title, quality, size, meta = null }) {
    if((Platform.isAndroid||Platform.isIos||Platform.isTizen)&&!Platform.offlineDownloads){go('downloads');return;}
    const settings = Store.settings;
    const resumen = [title, quality, size].filter(Boolean).join(' · ');
    const dir = settings.downloadDir || '';
    try{
      const entry = await Platform.downloadStart({ url, filename, dir });
      if(!entry||entry.ok===false)throw Error(entry?.error||'No se pudo iniciar la descarga');
      if(meta)DownloadMeta.set([entry.id, entry.filename, filename], { quality, ...meta });
      toastAction('Descarga iniciada: '+resumen,'Ver descargas',()=>go('downloads'));
      if (currentView === 'downloads') renderDownloads();
    }catch(error){toast(publicMessage(error.message)||'No se pudo iniciar la descarga. Vuelve a intentar.');}
  }

  function fmtBytes(n) {
    if (!Number.isFinite(n) || n <= 0) return '0 B';
    const u = ['B', 'KB', 'MB', 'GB', 'TB'];
    let i = 0;
    while (n >= 1024 && i < u.length - 1) { n /= 1024; i++; }
    return `${n.toFixed(i === 0 ? 0 : 1)} ${u[i]}`;
  }

  /* ============================ Ajustes ============================ */
  async function renderSettings() {
    const route=currentRoute;
    const s = Store.settings;
    const paths = await Platform.appPaths();
    const nebulaRuntime=await Platform.nebulaCall('runtime.status',{}).catch(()=>({configured:false,root:''}));
    if (currentRoute!==route) return;
    const localProfiles = (typeof NebulaCore !== 'undefined' && NebulaCore.LOCAL_PROFILES) || [{ id: 'personal', name: 'Personal' }, { id: 'cine', name: 'Cine' }, { id: 'series', name: 'Series' }];
    const activeProfileId = (typeof Store.localProfile === 'string' && Store.localProfile) || 'personal';
    // Tablet (canvas «Tablet · Ajustes», Android wider than 760 px): the desktop copy in two columns of cards.
    const tablet = Boolean(document.body?.classList?.contains?.('platform-android')) && !tvInterface() && Number(globalThis.innerWidth) > 760;
    // Phone (canvas «Ajustes»): shorter copy, the alerts as a value pill, Catálogo instead of Catálogo y fuentes.
    const phoneShell = Boolean(document.body?.classList?.contains?.('platform-android')) && !tvInterface() && !tablet;
    // Canvas «iOS · Ajustes»: textos propios (sin reproducción automática ni avisos en segundo plano) y pie con la marca.
    const ios = phoneShell && Boolean(document.body?.classList?.contains?.('platform-ios'));
    // Desktop (canvas «Escritorio · Ajustes»): profile pills in one row, then two columns of cards with an icon per heading.
    const desk = !document.body?.classList?.contains?.('platform-android') && !document.body?.classList?.contains?.('platform-tv');
    // No API keys, server URLs or catalog links here: TMDB, the extra source and the catalogs ship with the app.
    const activeProfile = localProfiles.find((p) => p.id === activeProfileId) || localProfiles[0];
    const glyph = (cls, d) => `<svg class="${cls}" viewBox="0 0 24 24" aria-hidden="true"><path d="${d}"/></svg>`;
    const head = (title, d) => `<h2>${glyph('set-head-icon', d)}${title}</h2>`;
    const btnGlyph = (d) => glyph('set-btn-icon', d);
    const PATH = {
      play: 'M21 12a9 9 0 1 1-18 0a9 9 0 1 1 18 0z M10 8.5l5.5 3.5-5.5 3.5z',
      type: 'M4 19l5-14 5 14 M5.8 14h6.4 M15 19l3-8 3 8 M15.9 16.5h4.2',
      box: 'M3 5h18v4H3z M5 9v10h14V9 M10 13h4',
      layers: 'M12 3l9 4.5-9 4.5-9-4.5z M3 12l9 4.5 9-4.5 M3 16.5l9 4.5 9-4.5',
      bell: 'M6 16V11a6 6 0 0 1 12 0v5l2 2H4z M10 20a2 2 0 0 0 4 0',
      folder: 'M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z',
      warn: 'M12 4l9 16H3z M12 10v4 M12 17v.01',
      upload: 'M12 15V3 M7 8l5-5 5 5 M5 21h14',
      download: 'M12 3v12 M7 10l5 5 5-5 M5 21h14',
      refresh: 'M20 12a8 8 0 1 1-2.34-5.66 M20 4v4h-4',
    };
    const today = new Date().toISOString().slice(0, 10);
    const rows = {
      quality: `<div class="set-row"><label for="setPlaybackMode">Calidad preferida<span class="hint">${phoneShell ? 'Se adapta si una fuente falla.' : 'Auto puede cambiar de fuente si falla. 4K fijo nunca baja a 1080p.'}</span></label><select id="setPlaybackMode">${[['auto','Auto'],['fixed4k','4K fijo'],['manual','Elegir fuente']].map(([v,label])=>`<option value="${v}" ${NebulaCore.qualityMode(s.playbackMode)===v?'selected':''}>${label}</option>`).join('')}</select></div>`,
      autoNext: `<div class="set-row"><label>${ios ? 'Ofrecer el siguiente episodio<span class="hint">Te lo propone al terminar uno.</span>' : phoneShell ? 'Reproducir el siguiente episodio<span class="hint">Empieza solo al terminar uno.</span>' : 'Ofrecer siguiente capítulo al terminar'}</label>
              <label class="switch"><input type="checkbox" id="setAutoNext" ${s.autoPlayNext ? 'checked' : ''}/><span></span></label></div>`,
      speed: `<div class="set-row"><label>Velocidad por defecto</label>
              <select id="setSpeed">${[0.75, 1, 1.25, 1.5, 2].map((v) => `<option value="${v}" ${v === s.defaultSpeed ? 'selected' : ''}>${v}x</option>`).join('')}</select></div>`,
      vlc: `<div class="set-row set-row-stack" data-desktop-only="1"><label for="setVlc">Reproductor externo (VLC)<span class="hint">Ruta a vlc.exe — opcional, para abrir enlaces externamente</span></label>
              <div class="set-inline-group"><input type="text" id="setVlc" class="set-input" value="${esc(s.externalPlayer)}" placeholder="C:\\Program Files\\VideoLAN\\VLC\\vlc.exe"/><button type="button" class="btn" id="btnPickVlc" aria-label="Elegir el reproductor externo">${btnGlyph(PATH.folder)}Elegir…</button></div></div>`,
      textScale: `<div class="set-row"><label for="setTextScale">Tamaño del texto</label><select id="setTextScale"><option value="1">100 %</option><option value="1.25">125 %</option><option value="1.5">150 %</option></select></div>`,
      // The same four steps as «Tamaño del texto» in the players' Subtítulos panel.
      subSize: (() => { const steps = [[14, 'Pequeño'], [16, 'Normal'], [22, 'Grande'], [28, 'Muy grande']]; const size = Number(s.subFontSize) || 16; const near = steps.reduce((best, step) => Math.abs(step[0] - size) < Math.abs(best[0] - size) ? step : best, steps[1])[0]; return `<div class="set-row"><label for="setSubSize">Tamaño de subtítulos</label><select id="setSubSize">${steps.map(([value, label]) => `<option value="${value}" ${value === near ? 'selected' : ''}>${label}</option>`).join('')}</select></div>`; })(),
      lang: `<div class="set-row"><label>Idioma del catálogo</label>
              <select id="setLang">
                ${(() => { /* App Android (celular y tableta): nombres en vez de los códigos «es-MX», «en-US»… El valor guardado no cambia. */ const named = Boolean(document.body?.classList?.contains?.('platform-android')) && !tvInterface(); const names = { 'es-MX': 'Español latino', 'es-ES': 'Español (España)', es: 'Español', 'en-US': 'Inglés (EE. UU.)', en: 'Inglés' }; return ['es-MX', 'es-ES', 'es', 'en-US', 'en'].map((l) => `<option value="${l}" ${l === s.language ? 'selected' : ''}>${named ? names[l] : l}</option>`).join(''); })()}
              </select></div>`,
      refresh: `<div class="set-row"><label>Actualizar catálogos<span class="hint">Vuelve a consultar los estrenos y las últimas incorporaciones al catálogo.</span></label><button class="btn" type="button" id="btnRefreshCatalog">${btnGlyph(PATH.refresh)}<span>Actualizar ahora</span></button></div>`,
      fallback: `<div class="set-row"><label>Fuente adicional (respaldo automático)<span class="hint">Entra en acción automáticamente cuando una película o serie no tiene enlaces en el catálogo principal.</span></label><button class="btn" type="button" id="btnNebulaReconnect">${nebulaRuntime.requiresReconnect?'Conectar respaldo':'Reconectar respaldo'}</button></div>`,
      credits: '<p class="hint">Los tiempos para saltar la intro, el resumen y el cierre vienen de TheIntroDB, SkipDB, IntroDB y AniSkip. Los datos de SkipDB se publican con la licencia ODbL.</p>',
      downDir: `<div class="set-row set-row-stack" data-desktop-only="1"><label for="setDownDir">Carpeta de descargas<span class="hint">Donde se guardan las películas y los episodios que descargas.</span></label>
              <div class="set-inline-group"><input type="text" id="setDownDir" class="set-input" value="${esc(s.downloadDir || paths.downloads)}"/><button type="button" class="btn" id="btnPickDir" aria-label="Elegir carpeta de descargas">${btnGlyph(PATH.folder)}Elegir…</button></div></div>`,
      exportData: `<div class="set-row"><label>Exportar respaldo${desk ? `<span class="hint">Se guarda como nebula-respaldo-${today}.json.</span>` : ios ? '<span class="hint">Se abre el menú Compartir.</span>' : ''}</label><button class="btn" type="button" id="btnExport">${btnGlyph(PATH.upload)}Exportar</button></div>`,
      importData: `<div class="set-row"><label>Importar respaldo${desk ? '<span class="hint">Elige un archivo .json exportado desde Nébula.</span>' : ''}</label><button class="btn" type="button" id="btnImport">${btnGlyph(PATH.download)}Importar</button></div>`,
      clearHistory: '<div class="set-row"><label>Limpiar historial de reproducción</label><button class="btn" type="button" id="btnClearWatchHistory">Limpiar historial</button></div>',
      clearCache: '<div class="set-row"><label>Limpiar caché de imágenes</label><button class="btn" type="button" id="btnClearCache">Limpiar</button></div>',
      reset: '<div class="set-row"><label>Restablecer todo</label><button class="btn danger-ghost" type="button" id="btnReset">Restablecer</button></div>',
    };
    const profilesCard = `<div class="set-card set-card-profiles">
            <h2>${desk ? 'Perfil local' : 'Perfiles locales'}</h2>
            <p class="hint">Cada perfil guarda sus favoritos, progreso y vistos en este dispositivo, igual que en Android TV.</p>
            <div class="collection-tabs" id="settingsProfileTabs" role="group" aria-label="Perfil local activo">
              ${localProfiles.map((p) => `<button type="button" data-settings-profile="${esc(p.id)}" aria-pressed="${p.id === activeProfileId}">${desk ? `<span class="set-profile-avatar" aria-hidden="true">${esc(p.name.slice(0, 1).toUpperCase())}</span>` : ''}${esc(p.name)}</button>`).join('')}
            </div>
          </div>`;
    const accountCard = typeof NebulaAccount !== 'undefined' ? NebulaAccount.html() : '';
    const updatesCard = typeof AppUpdates !== 'undefined' ? AppUpdates.html() : '';
    const notifyCard = EpisodeWatch.supported() ? `<div class="set-card set-card-notify">
            ${head('Notificaciones', PATH.bell)}
            <div class="set-row"><label>Episodios nuevos<span class="hint">${ios?'Solo con la app abierta: avisa al abrir Nébula y cada 6 horas.':phoneShell?'Revisa cada 6 horas las series de Mi lista y Seguir viendo.':Platform.availabilityAlerts?'Avisa cuando una serie de tus favoritos o de «Seguir viendo» publica un episodio. Se comprueba cada 6 horas, también con la app cerrada.':'Avisa al abrir Nébula, y cada 6 horas mientras está abierta, cuando una serie de tus favoritos o de «Seguir viendo» publica un episodio.'}</span></label>
              <label class="switch"><input type="checkbox" id="setEpisodeAlerts" ${s.episodeAlerts !== false ? 'checked' : ''}/><span></span></label></div>
            ${phoneShell && Platform.availabilityAlerts ? '<div class="set-row"><label>Avisos de disponibilidad<span class="hint">Títulos que pediste y todavía no tienen fuente.</span></label><button type="button" class="set-value" id="setAlertsOpen">Ver</button></div>' : ''}
          </div>` : '';
    const profileRow = `<button type="button" class="settings-profile-row" id="settingsProfileRow"><span class="settings-profile-avatar" aria-hidden="true">${esc(activeProfile.name.slice(0, 1).toUpperCase())}</span><span class="settings-profile-text"><strong>${esc(activeProfile.name)}</strong><span>Cambiar perfil</span></span><svg class="icon" aria-hidden="true"><use href="#i-chevron"/></svg></button>`;
    const grid = desk ? `
        <div class="settings-grid settings-desk">
          ${profilesCard}
          <div class="settings-col">
            ${accountCard}
            <section class="set-card set-card-playback">${head('Reproducción', PATH.play)}${rows.quality}${rows.autoNext}${rows.speed}${rows.vlc}</section>
            <section class="set-card set-card-interface">${head('Interfaz', PATH.type)}${rows.textScale}${rows.lang}</section>
            <section class="set-card set-card-data">${head('Respaldo', PATH.box)}${rows.exportData}${rows.importData}${rows.clearHistory}${rows.clearCache}</section>
          </div>
          <div class="settings-col">
            <section class="set-card set-card-content">${head('Catálogo y fuentes', PATH.layers)}${rows.refresh}${rows.fallback}${rows.credits}</section>
            ${notifyCard}
            <section class="set-card set-card-downloads">${head('Descargas', PATH.folder)}${rows.downDir}</section>
            ${updatesCard}
            <section class="set-card set-card-reset">
              <div class="set-reset-copy">${head('Restablecer todo', PATH.warn)}<p class="hint">Se borrarán favoritos, progreso, ajustes y catálogos.</p></div>
              <button class="btn danger-ghost" type="button" id="btnReset">Restablecer</button>
            </section>
          </div>
        </div>` : tablet ? `
        <div class="settings-grid settings-tablet">
          <div class="settings-col">
            ${profileRow}
            <section class="set-card set-card-playback">${head('Reproducción', PATH.play)}${rows.quality}${rows.autoNext}${rows.speed}${rows.textScale}${rows.subSize}</section>
            ${notifyCard}
          </div>
          <div class="settings-col">
            ${accountCard}
            ${updatesCard}
            <section class="set-card set-card-content">${head('Contenido', PATH.layers)}${rows.lang}${rows.refresh}${rows.fallback}</section>
            <section class="set-card set-card-data">${head('Datos y mantenimiento', PATH.box)}${rows.exportData}${rows.importData}${rows.clearHistory}${rows.reset}</section>
          </div>
        </div>` : `
        <div class="settings-grid">
          ${profilesCard}
          ${accountCard}
          ${updatesCard}
          <div class="set-card set-card-content">${head('Catálogo', PATH.layers)}${rows.refresh}${rows.lang}</div>
          <div class="set-card set-card-playback">${head('Reproducción', PATH.play)}${rows.quality}${rows.autoNext}${phoneShell ? '' : rows.speed + rows.textScale + rows.subSize}</div>
          ${notifyCard}
          ${phoneShell ? `<div class="set-card set-card-reading">${head('Texto y velocidad', PATH.type)}${rows.textScale}${rows.subSize}${rows.speed}</div>` : ''}
          <div class="set-card set-card-sources">
            ${head('Fuentes', PATH.layers)}
            <div class="set-row"><label>Archive.org (dominio público)<span class="hint">Clásicos con MP4 directo y subtítulos — siempre activa</span></label>
              <span class="chip">Activada</span></div>
            ${rows.credits}
          </div>
          <div class="set-card set-card-data">
            ${head('Datos y mantenimiento', PATH.box)}
            ${rows.fallback}${rows.exportData}${rows.importData}${rows.clearHistory}${rows.clearCache}${rows.reset}
          </div>
        </div>`;
    content().innerHTML = `
      <div class="view">
        <header class="page-heading sr-only"><h1>Ajustes</h1><p>Tu contenido y tu forma de reproducirlo.</p></header>
        <h1 class="settings-phone-title" aria-hidden="true">Ajustes</h1>
        ${tablet ? '' : profileRow}
        ${grid}
        ${ios ? '<p class="settings-ios-foot"><svg class="tb-logo" viewBox="0 0 512 512" aria-hidden="true"><use href="#nebula-mark"/></svg>Nébula para iOS</p>' : ''}
      </div>`;

    /* wire */
    $('#setTextScale').value=String(s.textScale||1);$('#setTextScale').onchange=()=>{Store.setSetting('textScale',Number($('#setTextScale').value));applyTextScale();};
    $$('.set-row').forEach(row=>{const label=row.querySelector('label');const input=row.querySelector('input[id],select[id],textarea[id]');if(label&&input&&!label.contains(input))label.htmlFor=input.id;});
    // Phone (canvas «Ajustes»): each value is a pill sized to its text («Auto»); it opens the same option dialog.
    if(phoneShell)$$('#content .set-row select').forEach(select=>{
      const pill=document.createElement('button');pill.type='button';pill.className='set-value set-select-pill';
      const sync=()=>{pill.textContent=select.selectedOptions?.[0]?.text||'';};sync();
      pill.setAttribute('aria-label',(select.labels?.[0]?.firstChild?.textContent||'').trim()+': '+pill.textContent);
      select.classList.add('set-select-hidden');select.after(pill);
      pill.onclick=()=>pickSelect(select);select.addEventListener('change',()=>{sync();pill.setAttribute('aria-label',(select.labels?.[0]?.firstChild?.textContent||'').trim()+': '+pill.textContent);});
    });
    if ($('#btnClearWatchHistory')) {
      $('#btnClearWatchHistory').onclick = () => {
        Store.clearWatchHistory();
        toast('Historial de reproducción borrado');
      };
    }
    if ($('#settingsProfileRow')) $('#settingsProfileRow').onclick = openProfilePicker;
    $$('#settingsProfileTabs [data-settings-profile]').forEach((btn) => btn.onclick = () => {
      const id = btn.dataset.settingsProfile;
      if (typeof Store.switchLocalProfile === 'function') Store.switchLocalProfile(id);
      syncProfileBadge();
      toast(`Perfil activo: ${btn.textContent.trim()}`);
      renderSettings();
    });
    if($('#btnNebulaReconnect'))$('#btnNebulaReconnect').onclick=async()=>{const button=$('#btnNebulaReconnect');button.disabled=true;try{await (typeof SourceConnection!=='undefined'?SourceConnection.reconnect(true):Platform.nebulaCall('session.reconnect',{}));API.invalidate();button.textContent='Reconectar respaldo';toast('Fuente adicional conectada');}catch(error){toast(publicMessage(error.message));}finally{button.disabled=false;}};
    if(typeof AppUpdates!=='undefined')AppUpdates.bind();
    if(typeof NebulaAccount!=='undefined')NebulaAccount.bind();
    $('#btnRefreshCatalog').onclick = async () => {
      const btn = $('#btnRefreshCatalog');
      const label = btn.querySelector('span') || btn;
      if (btn.disabled) return;
      btn.disabled = true; label.textContent = 'Actualizando…';
      try {
        API.invalidate();
        const r = await API.loadCatalogs(Store.settings.catalogUrls, { force: true });
        toast(r.errors?.length ? `Catálogo parcial: ${r.errors[0]}` : `Catálogos actualizados (${r.items.length} títulos)`);
      } catch (e) {
        toast(publicMessage(e.message) || 'No se pudieron actualizar los catálogos');
      } finally {
        if (document.contains(btn)) { btn.disabled = false; label.textContent = 'Actualizar ahora'; }
      }
    };
    if ($('#setAlertsOpen')) {
      $('#setAlertsOpen').onclick = () => go('mylist', { tab: 'alerts' });
      Platform.alertsCall('list').then(items => { if (currentRoute !== route || !$('#setAlertsOpen')) return; $('#setAlertsOpen').textContent = items.length === 1 ? '1 título' : items.length ? items.length + ' títulos' : 'Ninguno'; }).catch(() => {});
    }
    $('#setLang').addEventListener('change', (e) => { Store.setSetting('language', e.target.value); API.invalidate(); toast('Idioma actualizado'); });
    $('#setAutoNext').addEventListener('change', (e) => Store.setSetting('autoPlayNext', e.target.checked));
    $('#setEpisodeAlerts')?.addEventListener('change', async (e) => {
      const on=e.target.checked;Store.setSetting('episodeAlerts',on);
      toast(on?'Te avisaremos de los episodios nuevos de tus series.':'Avisos de episodios nuevos desactivados.');
      await EpisodeWatch.configure(on).catch(()=>{});
    });
    $('#setPlaybackMode').addEventListener('change',e=>Store.setSetting('playbackMode',NebulaCore.qualityMode(e.target.value)));
    $('#setSpeed').addEventListener('change', (e) => Store.setSetting('defaultSpeed', Number(e.target.value)));
    $('#setSubSize')?.addEventListener('change', (e) => Store.setSetting('subFontSize', Number(e.target.value)));
    $('#setVlc')?.addEventListener('change', (e) => Store.setSetting('externalPlayer', e.target.value.trim()));
    if ($('#btnPickVlc')) $('#btnPickVlc').onclick = async () => {
      const file = await Platform.pickFile({ filters: Platform.isMac ? [{ name: 'Todos los archivos', extensions: ['*'] }] : [{ name: 'VLC', extensions: ['exe'] }] });
      if (file) { $('#setVlc').value = file; Store.setSetting('externalPlayer', file); toast('Reproductor externo actualizado'); }
    };
    $('#setDownDir')?.addEventListener('change', (e) => Store.setSetting('downloadDir', e.target.value.trim()));
    if ($('#btnPickDir')) $('#btnPickDir').onclick = async () => {
      const d = await Platform.pickDirectory();
      if (d) { $('#setDownDir').value = d; Store.setSetting('downloadDir', d); }
    };
    $('#btnExport').onclick = async () => {
      if (Platform.isAndroid && typeof Platform.profileShare === 'function') {
        await Platform.profileShare();
        toast('Compartiendo respaldo…');
        return;
      }
      const blob = new Blob([await Platform.profileExport()], { type: 'application/json' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `nebula-respaldo-${new Date().toISOString().slice(0, 10)}.json`;
      a.click();
      toast('Respaldo exportado');
    };
    $('#btnImport').onclick = async () => {
      if (Platform.isAndroid || Platform.isIos || Platform.isTizen) {
        const input = document.createElement('input');
        input.type = 'file';
        input.accept = '.json,application/json,text/plain';
        input.onchange = async () => {
          const file = input.files?.[0];
          if (!file) return;
          try {
            const txt = await file.text();
            await Platform.profileImport(txt);
            Store.reload(); API.invalidate();
            toast('Respaldo importado ✔');
            renderSettings();
          } catch (e) { toast('Error importando: ' + e.message); }
        };
        input.click();
        return;
      }
      const f = await Platform.pickFile({ filters: [{ name: 'JSON', extensions: ['json'] }] });
      if (!f) return;
      try {
        const res = await fetch(`file:///${f.replace(/\\/g, '/')}`);
        const txt = await res.text();
        await Platform.profileImport(txt);
        Store.reload();API.invalidate();
        toast('Respaldo importado ✔');
        renderSettings();
      } catch (e) { toast('Error importando: ' + e.message); }
    };
    if ($('#btnClearCache')) $('#btnClearCache').onclick = async () => { await Platform.clearCache(); toast('Caché limpiada'); };
    if(Platform.isAndroid || Platform.isIos || Platform.isTizen){
      for(const id of ['btnClearCache','setVlc']){
        const node=$('#'+id);if(node)node.closest('.set-row').classList.add('hidden');
      }
      $('#btnPickDir')?.closest('.set-card')?.classList.add('hidden');
    } else if (Platform.isMac) {
      $('#setVlc')?.setAttribute('placeholder', '/Applications/VLC.app/Contents/MacOS/VLC');
    }
    $('#btnReset').onclick = () => showModal(`
      <h2>¿Restablecer todo?</h2><p style="color:var(--muted)">Se borrarán favoritos, progreso, ajustes y catálogos.</p>
      <div class="m-actions"><button class="btn" id="rsNo">Cancelar</button><button class="btn danger-ghost" id="rsYes">Restablecer</button></div>`,
      () => {
        $('#rsYes').onclick = () => { Store.reset(); closeModal(); toast('Restablecido'); renderSettings(); };
        $('#rsNo').onclick = closeModal;
      });
  }

  /* ============================ Modal genérico ============================ */
  let modalOnClose=null;
  function showModal(html, wire, onClose=null) {
    if(modalOnClose)closeModal();
    modalOnClose=onClose;
    const layer = $('#modalLayer');
    modalReturnFocus=document.activeElement;
    layer.innerHTML = `<div class="modal-card" role="dialog" aria-modal="true" aria-label="Confirmación">${html}</div>`;
    layer.classList.remove('hidden');
    wire && wire();
    layer.querySelector('button,input,select,textarea')?.focus();
  }
  function closeModal() { $('#modalLayer').classList.add('hidden');if(modalReturnFocus?.isConnected)modalReturnFocus.focus();const done=modalOnClose;modalOnClose=null;done?.(); }
  function pickPlaybackSource(sources){
    if(sources.length<=1)return Promise.resolve(sources[0]||null);
    return new Promise(resolve=>{
      let selected=null;
      showModal(`<h2>Calidad y audio</h2><p>Elige una opción para comenzar.</p><div class="tv-source-options">${sources.map((source,index)=>`<button class="btn tv-source-option" data-source-index="${index}"><span>${esc(source.name||'Original')}</span>${source.size?`<small>${esc(source.size)}</small>`:''}</button>`).join('')}</div><div class="m-actions"><button class="btn" id="sourceCancel">Cancelar</button></div>`,()=>{
        $('#modalLayer .modal-card').setAttribute('aria-label','Calidad y audio');
        $$('#modalLayer [data-source-index]').forEach(button=>button.onclick=()=>{selected=sources[Number(button.dataset.sourceIndex)];closeModal();});
        $('#sourceCancel').onclick=closeModal;
      },()=>resolve(selected));
    });
  }
  function pickSelect(select){
    const options=Array.from(select.options).filter(option=>!option.disabled);
    if(!options.length)return;
    const title=select.getAttribute('aria-label')||select.labels?.[0]?.firstChild?.textContent.trim()||'Elegir opción';
    showModal(`<h2>${esc(title)}</h2><div class="tv-source-options">${options.map((option,index)=>`<button class="btn tv-source-option" data-option-index="${index}" aria-pressed="${option.selected}"><span>${esc(option.text)}</span>${option.selected?'<small>Actual</small>':''}</button>`).join('')}</div><div class="m-actions"><button class="btn" id="selectCancel">Cancelar</button></div>`,()=>{
      $('#modalLayer .modal-card').setAttribute('aria-label',title);
      $$('#modalLayer [data-option-index]').forEach(button=>button.onclick=()=>{select.value=options[Number(button.dataset.optionIndex)].value;closeModal();select.dispatchEvent(new Event('change',{bubbles:true}));});
      $('#selectCancel').onclick=closeModal;
    });
    $('#modalLayer [aria-pressed="true"]')?.focus();
  }
  $('#modalLayer').addEventListener('click', (e) => { if (e.target.id === 'modalLayer') closeModal(); });

  /* ===================== Episodios nuevos de la biblioteca ===================== */
  // Android lo resuelve con un trabajo nativo (EpisodeAlerts) que también avisa con la app cerrada.
  // En el resto de plataformas se comprueba al abrir y cada 6 h mientras la app está abierta.
  const EpisodeWatch=(()=>{
    const PERIOD=6*60*60*1000;let timer=0,running=false;
    const native=()=>Boolean(Platform.availabilityAlerts);
    const supported=()=>native()||typeof Platform.seriesEpisodes==='function';
    // Referencia por serie en el perfil (una sola escritura por pasada, como mucho 30 series).
    const read=()=>{const value=Store.settings.episodeWatch;return value&&typeof value==='object'?value:{};};
    const write=value=>{try{Store.setSetting('episodeWatch',value);}catch{}};
    // Orden temporada·episodio; los especiales (temporada 0) no cuentan como estreno.
    const ordinal=(season,episode)=>season>=1&&season<=999&&episode>=1&&episode<=9999?season*10000+episode:0;
    const label=value=>`T${Math.floor(value/10000)} · E${value%10000}`;
    function followed(){
      const found=new Map();
      for(const item of [...Store.favorites,...Store.resumeList]){
        if(item.type!=='tv'||['nebula','local','jellyfin','archive'].includes(item.kind))continue;
        const id=String(item.id??'');if(!/^[1-9]\d{0,9}$/.test(id))continue;
        const at=Math.max(item.addedAt||0,item.updatedAt||0),previous=found.get(id);
        if(!previous||at>previous.at)found.set(id,{id,title:item.title||previous?.title||'Serie',poster:item.poster||previous?.poster||'',at});
      }
      return [...found.values()].sort((a,b)=>b.at-a.at).slice(0,30);
    }
    async function check(){
      if(running||native()||!supported()||Store.settings.episodeAlerts===false)return;
      running=true;
      try{
        const series=read().series||{},list=followed(),keep=new Set(list.map(entry=>'tv:'+entry.id)),fresh=[];
        // La primera vez solo se guarda el último episodio; se avisa de los posteriores, no de huecos antiguos.
        for(const entry of list.slice().sort((a,b)=>(series['tv:'+a.id]?.checkedAt||0)-(series['tv:'+b.id]?.checkedAt||0)).slice(0,20)){
          let result;try{result=await Platform.seriesEpisodes(entry.id);}catch{continue;}
          if(!result?.ok||!Array.isArray(result.episodes))continue;
          const ordinals=result.episodes.filter(episode=>Array.isArray(episode.urls)&&episode.urls.length).map(episode=>ordinal(Number(episode.season),Number(episode.episode))).filter(Boolean);
          if(!ordinals.length)continue;
          const key='tv:'+entry.id,known=series[key]||{},previous=Number(known.latest)||0,latest=Math.max(...ordinals);
          const count=previous?new Set(ordinals.filter(value=>value>previous)).size:0;
          series[key]={id:entry.id,title:entry.title,checkedAt:Date.now(),latest:Math.max(latest,previous)};
          if(count)fresh.push({...entry,count,label:label(latest)});
        }
        for(const key of Object.keys(series))if(!keep.has(key))delete series[key];
        write({series});
        if(fresh.length)announce(fresh);
      }finally{running=false;}
    }
    function announce(list){
      const first=list[0];
      // Título y detalle en líneas separadas: muchos títulos ya llevan dos puntos («Serie: Subtítulo»).
      const title=list.length>1?`Episodios nuevos en ${list.length} series`:first.title;
      const detail=list.length>1?`${first.title} y ${list.length-1===1?'otra serie':(list.length-1)+' series más'}`:first.count>1?`${first.count} episodios nuevos · hasta ${first.label}`:`Nuevo episodio · ${first.label}`;
      toastAction(title,'Ver',()=>openAvailabilityTarget('tv:'+first.id),detail);
      if(typeof Notification!=='undefined'&&Notification.permission==='granted'&&document.hidden){
        for(const item of list.slice(0,3)){
          // EscritorioAviso: la serie como título, «Nuevo episodio: T3 · E2» y su póster como imagen.
          const notice=new Notification(item.title,{body:item.count>1?`${item.count} episodios nuevos · hasta ${item.label}`:`Nuevo episodio: ${item.label}`,tag:'nebula-episode-'+item.id,...(/^https:\/\//.test(item.poster||'')?{icon:item.poster}:{})});
          notice.onclick=()=>{window.focus();openAvailabilityTarget('tv:'+item.id);};
        }
      }
    }
    function start(){
      clearTimeout(timer);
      if(native()||!supported()||Store.settings.episodeAlerts===false)return;
      timer=setTimeout(function tick(){check().catch(()=>{});timer=setTimeout(tick,PERIOD);},90*1000);
    }
    async function configure(enabled){
      if(!native()){start();return;}
      // Android: el ajuste vive en el perfil; se guarda antes de (des)programar el trabajo nativo.
      if(window.AndroidNative?.flush)await window.AndroidNative.flush().catch(()=>{});
      if(enabled)await Platform.alertsCall('permission').catch(()=>{});
      await Platform.alertsCall('episodes');
    }
    return {supported,start,check,configure};
  })();

  /* ============================ Inicialización ============================ */
  /** Retira la pantalla de arranque cuando Inicio termina de pintar, o a los 2,5 s como máximo. */
  function finishBootSplash(firstPaint){
    const splash=document.getElementById('bootSplash');if(!splash)return;
    let done=false;
    const hide=()=>{if(done)return;done=true;splash.classList.add('boot-done');setTimeout(()=>splash.remove(),600);};
    Promise.race([Promise.resolve(firstPaint).catch(()=>{}),new Promise(resolve=>setTimeout(resolve,2500))]).then(hide,hide);
  }
  function init() {
    applyTextScale();content().tabIndex=-1;
    // Escape cancela la búsqueda de fuentes previa al reproductor (antes que cualquier otro atajo).
    document.addEventListener('keydown',event=>{if(event.key==='Escape'&&launchState){event.preventDefault();event.stopImmediatePropagation();cancelLaunch();}},true);
    $$('.nav-item').forEach(button=>button.setAttribute('aria-label',button.textContent.trim()));
    document.addEventListener('keydown',event=>{
      const layer=$('#modalLayer');if(layer.classList.contains('hidden'))return;
      if(event.key==='Escape'){event.preventDefault();event.stopImmediatePropagation();closeModal();}
      else if(event.key==='Tab'){const buttons=$$('button,input,select,textarea,[tabindex="0"]',layer).filter(node=>!node.disabled);const first=buttons[0],last=buttons[buttons.length-1];if(event.shiftKey&&document.activeElement===first){event.preventDefault();last?.focus();}else if(!event.shiftKey&&document.activeElement===last){event.preventDefault();first?.focus();}}
    },true);
    document.addEventListener('error', event => {
      const image = event.target;
      if (image.tagName !== 'IMG') return;
      image.style.display = 'none';
      image.parentElement?.querySelector('.ph')?.classList.remove('hidden');
    }, true);
    $('#tbBack').onclick = back;
    /* Pastilla que sigue al ratón en la barra superior */
  (() => {
    const scroller = document.querySelector('#sidebar .sidebar-scroll');
    if (!scroller) return;
    const pill = document.createElement('span');
    pill.className = 'nav-hover-pill';
    scroller.prepend(pill);
    const move = (element) => {
      const box = scroller.getBoundingClientRect();
      const rect = element.getBoundingClientRect();
      pill.style.width = rect.width + 'px';
      pill.style.transform = 'translate(' + (rect.left - box.left) + 'px, -50%)';
      pill.style.opacity = '1';
    };
    scroller.querySelectorAll('.nav-item, .nav-categories button').forEach((element) => {
      element.addEventListener('mouseenter', () => move(element));
      element.addEventListener('focus', () => move(element));
    });
    scroller.addEventListener('mouseleave', () => { pill.style.opacity = '0'; });
    scroller.addEventListener('mouseover', (event) => { if (event.target.closest('.nav-panel')) pill.style.opacity = '0'; });
  })();

  if ($('#tbMenu')) $('#tbMenu').onclick = toggleDrawer;
    if ($('#drawerBackdrop')) $('#drawerBackdrop').onclick = closeDrawer;
    if ($('#tbSearchClear')) $('#tbSearchClear').onclick = () => {
      if (currentView === 'search' && $('#searchClear')) {
        $('#searchClear').click();
      } else {
        go('search', { q: '' });
      }
    };
    if ($('#tbSearchBtn')) $('#tbSearchBtn').onclick = async () => {
      if(currentView!=='search')await go('search');
      const input=$('#searchInput');
      if(input){input.focus();if(tvInterface())input.click();}
    };
    if ($('#tbFilterBtn')) $('#tbFilterBtn').onclick = () => {
      if (currentView === 'browse' && $('#browseFiltersToggle')) {
        $('#browseFiltersToggle').click();
        content().scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        const cat = currentRoute?.params?.category || (homeFilter === 'tv' ? 'series' : 'movies');
        go('browse', { category: cat, filtersOpen: true });
      }
    };
    if ($('#tbReloadBtn')) $('#tbReloadBtn').onclick = () => {
      API.invalidate();
      toast('Actualizando catálogo…');
      if (currentRoute) activateRoute(currentRoute);
    };
    document.addEventListener('keydown', event => { if (event.altKey && event.key === 'ArrowLeft' && $('#modalLayer').classList.contains('hidden')) { event.preventDefault(); back(); } });
    document.addEventListener('keydown', event => { if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); if (!$('#modalLayer').classList.contains('hidden')) return; go('search'); $('#searchInput')?.focus(); } });
    Platform.onWindowState(() => {});
    // Redraw Inicio when the connection drops or comes back so the «Sin conexión» banner stays truthful.
    globalThis.addEventListener?.('online', () => { if (currentView === 'home') renderHome(); });
    globalThis.addEventListener?.('offline', () => { if (currentView === 'home') renderHome(); });
    Platform.onDownloadProgress(async (d) => {
      if (currentView === 'downloads') {
        // refresco ligero de la tarjeta activa
        const card = $(`.dl-card[data-id="${d.id}"]`);
        if (card && ['descargando','preparando','verificando'].includes(d.status)) {
          const bar=card.querySelector('.dl-bar'),pct=downloadPercent(d);
          if(bar){bar.firstElementChild.style.transform='scaleX('+Math.max(0,Math.min(100,Number(pct)||0))/100+')';if(d.totalBytes>0)bar.setAttribute('aria-valuenow',String(pct));else bar.removeAttribute('aria-valuenow');}
          card.querySelector('.dl-status').textContent=downloadStatusLabel(d);card.dataset.status=d.status;
          card.querySelector('.dl-note').textContent=d.note?publicMessage(d.note)||'Descarga en curso.':'';
          card.querySelector('[data-dl-bytes]').textContent=fmtBytes(d.bytes)+(d.totalBytes>0?' / '+fmtBytes(d.totalBytes):'');
          card.querySelector('[data-dl-speed]').textContent=d.status==='descargando'&&d.speed>0?fmtBytes(d.speed)+'/s':'';
          card.querySelector('[data-dl-eta]').textContent=downloadEstimate(d);
          const phone=downloadPhoneParts(d),detail=card.querySelector('.dl-detail'),state=card.querySelector('.dl-state span');
          if(detail)detail.textContent=phone.detail;if(state)state.textContent=phone.status;
          const pause=card.querySelector('[data-act="pause"]');if(pause)pause.classList.toggle('hidden',d.status==='verificando');
        } else if (currentView === 'downloads') {
          renderDownloads();
        }
      }
    });

    $$('.nav-item').forEach((b) => b.addEventListener('click', () => go(b.dataset.view,b.dataset.view==='browse'?{category:'movies'}:{})));
    $$('[data-category-nav]').forEach(button=>button.onclick=()=>go('browse',{category:button.dataset.categoryNav}));
    $$('#phoneBottomNav [data-phone-nav]').forEach((b) => b.addEventListener('click', () => {
      const target = b.dataset.phoneNav;
      if (target === 'browse') go('browse', { category: 'movies' });
      else go(target, {});
    }));
    // Celular: la cabecera es transparente sobre el destacado de Inicio y toma fondo al desplazarse.
    // In the detail views the bar becomes solid with the title once the hero has scrolled away (canvas «Ficha · Elegir fuente»).
    const syncScrolled = () => { const top = content().scrollTop; document.body?.classList?.toggle?.('content-scrolled', top > 24); document.body?.classList?.toggle?.('detail-scrolled', top > 144); }; // 144: the ficha title (200 px) reaches the 56 px bar
    content()?.addEventListener?.('scroll', syncScrolled, { passive: true });
    watchViewMotion();
    window.addEventListener?.('resize', () => { const mark = $('#phoneBottomNav .nav-indicator'); mark?.classList?.remove('shown'); syncPhoneNavIndicator(); });
    // Celular: las fuentes de la ficha se muestran plegadas en la elegida; tocarla («Cambiar») despliega la lista y elegir otra la vuelve a plegar.
    content()?.addEventListener?.('click', (event) => {
      const done = event.target?.closest?.('.quality-head .q-done');
      if (done) { const head = done.closest('.quality-head'); head?.classList.remove('sources-open'); head?.nextElementSibling?.classList?.remove('sources-open'); return; }
      const item = event.target?.closest?.('#qualityBox .quality-item');
      const box = item?.parentElement;
      if (!box || !document.body?.classList?.contains?.('platform-android') || tvInterface() || Number(globalThis.innerWidth) > 760) return;
      const head = box.previousElementSibling?.classList?.contains?.('quality-head') ? box.previousElementSibling : null;
      if (item.classList.contains('sel') && !box.classList.contains('sources-open')) { box.classList.add('sources-open'); head?.classList.add('sources-open'); event.stopPropagation(); return; }
      box.classList.remove('sources-open');
      head?.classList.remove('sources-open');
    }, true);
    // Escritorio (EscritorioPelicula / EscritorioFuentes): igual, pero «Cambiar fuente» abre la cuadrícula y elegir una la pliega.
    content()?.addEventListener?.('click', (event) => {
      if (document.body?.classList?.contains?.('platform-android') || tvInterface()) return;
      const box = event.target?.closest?.('#qualityBox');
      if (!box) return;
      const change = box.querySelector('.q-change');
      if (event.target.closest('.q-change')) {
        const open = !box.classList.contains('sources-open');
        box.classList.toggle('sources-open', open);
        change?.setAttribute('aria-expanded', String(open));
        if (open) box.querySelector('.quality-item.sel')?.focus?.({ preventScroll: true });
      } else if (event.target.closest('.quality-item') && box.classList.contains('sources-open')) {
        box.classList.remove('sources-open');
        change?.setAttribute('aria-expanded', 'false');
      }
    });
    content()?.addEventListener?.('keydown', (event) => {
      const box = event.key === 'Escape' && event.target?.closest?.('#qualityBox.sources-open');
      if (!box || document.body?.classList?.contains?.('platform-android')) return;
      event.stopPropagation();
      box.classList.remove('sources-open');
      const change = box.querySelector('.q-change');
      change?.setAttribute('aria-expanded', 'false');
      change?.focus?.({ preventScroll: true });
    });
    const titlebar = $('#titlebar');
    if (titlebar && typeof ResizeObserver === 'function') new ResizeObserver(() => document.body.style.setProperty('--phone-header-h', titlebar.offsetHeight + 'px')).observe(titlebar);
    if ($('#phoneProfileBtn')) $('#phoneProfileBtn').onclick = openProfilePicker;
    if ($('#phoneSettingsBtn')) $('#phoneSettingsBtn').onclick = () => go('settings');
    syncProfileBadge();
    Platform.runtimeInfo?.().then((info) => {
      const lbl = $('#appVersionLabel');
      if (lbl && info?.version) lbl.textContent = 'v ' + info.version;
    }).catch(() => {});
    window.addEventListener('hashchange', () => {
      const h = location.hash.slice(1);
      if (!h) return;
      const match = /^(movie|tv)=([1-9]\d*)$/.exec(h);
      if (match && Number.isSafeInteger(Number(match[2]))) go(match[1], { id: Number(match[2]) });
    });

    // Chips de género (delegación única)
    document.addEventListener('click', (e) => {
      const chip = e.target.closest('button[data-genre-id]');
      if (chip) loadGenre(Number(chip.dataset.genreId));
    });

    // Ventana
    $('#btnMin').onclick = () => Platform.minimize();
    $('#btnMax').onclick = () => Platform.maximizeToggle();
    $('#btnClose').onclick = () => Platform.closeWindow();
    Platform.isMaximized().then((m) => $('#btnMax').textContent = m ? '❐' : '▢');

    // Precarga de catálogos externos al arrancar (en silencio)
    if (Store.settings.catalogUrls.length || Store.settings.builtinCatalog !== false) {
      API.loadCatalogs(Store.settings.catalogUrls).then((r) => {
        if (r.errors.length) toast(`Catálogo: ${r.errors[0]}`);
      });
    }

    Player.init();
    if(typeof SourceConnection!=='undefined')SourceConnection.ensure().catch(()=>{});
    finishBootSplash(go('home'));
    if(Platform.availabilityAlerts)Platform.alertsCall('target').then(openAvailabilityTarget).catch(()=>{});
    window.addEventListener('nebulaAvailability',event=>{openAvailabilityTarget(event.availabilityTarget||event.detail?.availabilityTarget);if(Platform.availabilityAlerts)Platform.alertsCall('target').catch(()=>{});});
    if(typeof AppUpdates!=='undefined')AppUpdates.start();
    if(typeof NebulaAccount!=='undefined')NebulaAccount.start();
    EpisodeWatch.start();
  }

  if(!document.readyState||document.readyState==='loading')document.addEventListener('DOMContentLoaded', init);else init();

  return { go, back, toast, toastAction, resumeItem, pickPlaybackSource, pickSelect, showModal, closeModal, showLaunch, hideLaunch, cancelLaunch };
})();

