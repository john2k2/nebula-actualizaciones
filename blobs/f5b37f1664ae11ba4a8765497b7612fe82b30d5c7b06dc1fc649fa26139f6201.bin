'use strict';
/**
 * Capa de datos del clon:
 *  1) TMDB (idéntico al original: los modelos Movie/Series usan id de TMDB,
 *     generos como ids de TMDB y posters de image.tmdb.org/t/p/w500).
 *  2) Catálogos externos en formato MoviePlus:
 *     { movies: [{id,nameFile,generos,othersNames,resolutions,type,urlImage,urls,vote,date}], series: [...] }
 *     type: 1 = película, 2 = serie. Series admiten "episodes":
 *     [{season, episode, name, overview, stillPath, urls:[]}] (EpisodeExtra/Quality del original).
 *
 * Optimizaciones: caché con TTL, deduplicación de peticiones en vuelo y límites de página.
 */
const API = (() => {
  const providerCall=(...args)=>typeof SourceConnection!=='undefined'?SourceConnection.call(...args):Platform.nebulaCall(...args);
  const BASE = 'https://api.themoviedb.org/3';
  const IMG = 'https://image.tmdb.org/t/p';
  const searchSnapshot=typeof MoviePlusSearchIndex==='object'?MoviePlusSearchIndex:{items:[],primaryAliases:{}};
  const backupById=new Map((searchSnapshot.items||[]).map(item=>[String(item.id),item]));
  const nebulaItems = new Map();
  const nebulaByCatalog = new Map();
  const filtroNebula = { lista: [], pasan: [], cursor: 0, corriendo: false };
  function resetFiltroNebula(lista) {
    const firma = lista.map((item) => String(item.id)).join('|');
    if (filtroNebula.firma === firma) return;
    filtroNebula.firma = firma;
    filtroNebula.lista = lista;
    filtroNebula.pasan = [];
    filtroNebula.cursor = 0;
    filtroNebula.corriendo = false;
  }
  async function cargarLoteNebula(tamano) {
    if (filtroNebula.corriendo || filtroNebula.cursor >= filtroNebula.lista.length) return;
    filtroNebula.corriendo = true;
    const laxo = (t) => String(t || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, ' ').trim();
    const anio = (v) => Number(String(v || '').slice(0, 4));
    const lote = filtroNebula.lista.slice(filtroNebula.cursor, filtroNebula.cursor + tamano);
    try {
      const revisados = await Promise.all(lote.map(async (item) => {
        try {
          const local = await cached('nebula-check:' + item.title, TTL.list, () => providerCatalog.search(item.title, ['movieplus']));
          const candidatos = (local && local[0] && local[0].items) || [];
          const existe = candidatos.some((c) => {
            if (laxo(c.title) !== laxo(item.title)) return false;
            const a = anio(c.year), b = anio(item.year);
            return !a || !b || Math.abs(a - b) <= 1;
          });
          return existe ? null : item;
        } catch { return item; }
      }));
      filtroNebula.pasan.push(...revisados.filter(Boolean));
      filtroNebula.cursor += lote.length;
    } catch {}
    filtroNebula.corriendo = false;
    if (filtroNebula.cursor < filtroNebula.lista.length) setTimeout(() => { cargarLoteNebula(16); }, 80);
  }
  async function nebulaRowsProgresivo() {
    if (!Platform.nebulaCall) return [];
    let data = null;
    try {
      data = await cached('nebula:home', TTL.list, async () => {
        const categories = await providerCall('categories', { kind: 'vod' });
        const films = categories.filter((category) => /film|pel[ií]cula/i.test(category.group_title || ''));
        const category = films.find((c) => c.title === String(new Date().getFullYear())) || films.find((c) => /^all$/i.test(c.title)) || films[0];
        if (!category) throw Error('Nebula sin categoria de peliculas');
        return providerCall('catalog', { kind: 'vod', category: category.id, page: 1 });
      });
    } catch {
      return [];
    }
    const lista = ((data && data.items) || []).map(nebulaItem).filter((item) => item.type !== 'tv');
    resetFiltroNebula(lista);
    if (!filtroNebula.pasan.length) await cargarLoteNebula(16);
    else cargarLoteNebula(16);
    return [{ title: 'Nébula · Más películas', items: filtroNebula.pasan.slice() }];
  }
  const jellyfinReferences=new Map();
  const combinedEpisodes=new Map();
  function matchingCatalogs(item){
    const candidates=[...catalogsCache.values()].flatMap(catalog=>item.type==='tv'?catalog.series:catalog.movies);
    let matches=candidates.filter(candidate=>CatalogSources.identity.compare(item,candidate)==='id');
    if(!matches.length){const match=CatalogSources.identity.selectMatch(item,candidates);if(match)matches=[match];}
    if(item.kind==='catalog'&&!matches.includes(item))matches.push(item);
    return matches;
  }
  const providerCatalog=CatalogSources.catalogService.create({identity:CatalogSources.identity,availability:CatalogSources.availability,topQualities:CatalogSources.topQualities,providers:[
    {id:'archive',capabilities:{movies:true},supports:item=>item.kind==='archive',search:archiveSearch,listSources:async item=>({state:'available',sources:(await archiveDetail(item.id)).sources||[]})},
    {id:'jellyfin',capabilities:{movies:true,series:true},supports:item=>item.kind==='jellyfin',search:jellyfinSearch,listSources:async item=>({state:'available',sources:[{name:'HLS · Jellyfin',url:jellyfinPrivateStreamUrl(item.id)}].filter(source=>source.url)})},
    {id:'nebula',capabilities:{movies:true,series:true},supports:item=>!matchingCatalogs(item).length&&item.type!=='tv'&&item.kind!=='archive'&&item.kind!=='jellyfin'&&!CatalogSources.isTestCatalog(item.catalogUrl),search:nebulaSearch,listSources:movieSources},
    {id:'movieplus',capabilities:{movies:true,series:true,episodes:true},search:async query=>(await loadCatalogs(Store.settings.catalogUrls||[])).items.filter(item=>relevance(item,query)<4),supports:item=>item.kind!=='archive'&&item.kind!=='jellyfin',listSources:async item=>{
      const matches=matchingCatalogs(item);
      if(item.type==='tv'){
        if(!item.episode)return {state:'unknown',sources:[]};
        const combined=combinedEpisodes.get(String(item.id));
        const episodes=combined && Date.now()-combined.at<5*60*1000?combined.episodes:matches.flatMap(catalog=>catalog.raw?.episodes||[]);
        const ep=episodes.find(ep=>Number(ep.season)===Number(item.season)&&Number(ep.episode)===Number(item.episode));
        const sources=ep?CatalogSources.parse(ep.urls,ep.resolutions).filter(source=>source.url):[];
        return {state:sources.length?'available':ep?'unavailable':'unknown',sources};
      }
      const sources=matches.flatMap(catalog=>catalog.qualities||[]);
      return {state:sources.length?'available':'unknown',sources};
    }}
  ]});
  async function sourcesFor(item){
    const result=await providerCatalog.listSources(item);
    if(!Platform.registerSources)return result;
    const nebulaVinculado = item && (item.nebulaId || nebulaByCatalog.get(String(item.id)));
  if (nebulaVinculado && !matchingCatalogs(item).length && Platform.nebulaCall && !String(item.id).startsWith('nebula:')) {
    try {
      const idNebula = String(nebulaVinculado).replace(/^nebula:/, '');
      const opciones = await providerCall('playback.options', { kind: 'vod', id: idNebula });
      const extra = (opciones.qualities || []).flatMap((calidad) => (calidad.audio_languages?.length ? calidad.audio_languages : [{ label: 'Original', value: '' }]).map((audio) => ({
        name: calidad.label + ' \u00b7 ' + audio.label,
        size: 'Fuente adicional',
        providerId: 'nebula',
        url: 'nebula://source/' + encodeURIComponent(idNebula) + '?' + new URLSearchParams({ quality: calidad.value, ...(audio.value ? { audio_language: audio.value } : {}) }),
      })));
      if (extra.length) result.allSources = [...(result.allSources || []), ...extra];
    } catch {}
  }
  const allSources=await Platform.registerSources(result.allSources);
    if(item.kind==='jellyfin'&&allSources[0])jellyfinReferences.set(item.id,allSources[0].url);
    return {...result,allSources,sources:CatalogSources.topQualities(allSources),providers:result.providers.map(provider=>({...provider,sources:[]}))};
  }
  async function episodesFor(item){
    if(item.kind==='nebula'&&item.type==='tv'){
      const raw=item.raw||{},seasonMatch=String(item.title||'').match(/(?:T(?:emp\.)?|Season)\s*(\d+)\s*$/i);
      const fallbackSeason=seasonMatch?Number(seasonMatch[1]):1;
      const seasons=raw.seasons?.length?raw.seasons:[{id:raw.id||item.nebulaId,number:fallbackSeason}];
      const episodes=[];
      for(const season of seasons){
        if(!Number.isInteger(Number(season.number))||Number(season.number)<1)continue;
        const detail=String(season.id)===String(raw.id)?raw:await providerCall('details',{kind:'vod',id:String(season.id)});
        for(const ep of detail.episodes||[]){
          if(!ep.id||!Number.isInteger(Number(ep.number))||Number(ep.number)<1)continue;
          let urls=[{name:'Automática',url:'nebula://source/'+encodeURIComponent(ep.id)}];
          if(Platform.registerSources)urls=await Platform.registerSources(urls);
          episodes.push({season:Number(season.number),episode:Number(ep.number),name:ep.title||'',urls});
        }
      }
      return {episodes,warnings:[]};
    }
    const providers=matchingCatalogs(item),warnings=[],merged=new Map();
    for(const provider of providers){
      let episodes=provider.raw?.episodes||[];
      if(provider.catalogUrl==='movieplus:catalog'){
        try{episodes=await catalogEpisodes(provider.id);provider.raw={...provider.raw,episodes};}
        catch(error){warnings.push(CatalogSources.availability.failure('movieplus',error));}
      }
      for(const episode of episodes){
        const season=Number(episode.season),number=Number(episode.episode);
        if(!Number.isInteger(season)||season<0||!Number.isInteger(number)||number<1)continue;
        const key=CatalogSources.identity.episodeKey(item.id,season,number);
        const previous=merged.get(key),urls=[...(previous?.urls||[]),...CatalogSources.parse(episode.urls,episode.resolutions).filter(source=>source.url)];
        const unique=[...new Map(urls.map(source=>[source.url,source])).values()];
        merged.set(key,{...episode,season,episode:number,urls:unique});
      }
    }
    // Add independent episode sources only after title, original year and explicit season agree.
    if(!providers.length && Platform.nebulaCall && !CatalogSources.isTestCatalog(item.catalogUrl)){
      try{
        const extra=await additionalSeriesEpisodes(item);
        for(const episode of extra){
          const key=CatalogSources.identity.episodeKey(item.id,episode.season,episode.episode),previous=merged.get(key);
          merged.set(key,{...episode,...previous,urls:[...(previous?.urls||[]),...episode.urls]});
        }
      }catch(error){warnings.push(CatalogSources.availability.failure('nebula',error));}
    }
    const episodes=[...merged.values()].sort((a,b)=>a.season-b.season||a.episode-b.episode);
    if(Platform.registerSources)for(const episode of episodes)episode.urls=await Platform.registerSources(episode.urls);
    combinedEpisodes.set(String(item.id),{at:Date.now(),episodes});
    return {episodes,warnings};
  }
  async function additionalSeriesEpisodes(item){
    const year=CatalogSources.identity.year(item);if(!year)return [];
    const canonical=raw=>({...nebulaItem(raw),title:String(raw.title||'').replace(/\s+(?:T(?:emp\.)?|Season)\s*\d+\s*$/i,'').replace(new RegExp('\\s+'+year+'$'),'')});
    let match;
    const extraSeriesNames=String(item.othersNames||'').split(/[|,;/]+/).map(s=>s.trim()).filter(Boolean);
    const seriesLookup={...item,originalTitle:item.originalTitle||extraSeriesNames[0]||''};
    for(const query of [...new Set([item.title,item.originalTitle,...extraSeriesNames].filter(Boolean))]){
      const result=await cached('series-provider:'+query,TTL.search,()=>providerCall('search',{kind:'vod',query,page:1}));
      const candidates=(result.items||[]).filter(raw=>CatalogSources.identity.nebulaType(raw)==='tv').map(raw=>({...canonical(raw),raw}));
      // A season-one record identifies the series; never pick an ambiguous edition.
      match=CatalogSources.identity.selectMatch(seriesLookup,candidates.filter(candidate=>/\s(?:T(?:emp\.)?|Season)\s*1\s*$/i.test(candidate.raw.title||'')));
      if(match)break;
    }
    if(!match)return [];
    const first=await providerCall('details',{kind:'vod',id:match.nebulaId});
    if(CatalogSources.identity.compare(seriesLookup,canonical(first))==='different')return [];
    const seasons=first.seasons||[];
    const output=[];
    for(const season of seasons){
      if(!Number.isInteger(season.number)||season.number<1)continue;
      const detail=season.id===first.id?first:await providerCall('details',{kind:'vod',id:season.id});
      for(const ep of detail.episodes||[]){
        if(!ep.id||!Number.isInteger(ep.number)||ep.number<1)continue;
        output.push({season:season.number,episode:ep.number,name:ep.title,urls:[{name:'Automática · Fuente adicional',url:'nebula://source/'+encodeURIComponent(ep.id)}]});
      }
    }
    return output;
  }
  function nebulaItem(raw) {
    const stored=backupById.get(String(raw.id))||{};
    raw={...stored,...raw,aliases:[...new Set([...(stored.aliases||[]),...(raw.aliases||[])])]};
    const identities=[{providerId:'nebula',id:String(raw.id)}];
    const canonical=String(raw.canonicalId||'').match(/^tmdb:(movie|series):(\d+)$/);
    if(canonical)identities.push({providerId:'tmdb',id:canonical[2]});
    const item = {kind:'nebula', id:'nebula:'+raw.id, nebulaId:raw.id, type:CatalogSources.identity.nebulaType(raw), title:raw.title, originalTitle:raw.originalTitle||'', aliases:raw.aliases, identities, poster:raw.poster, backdrop:raw.backdrop, year:raw.year, rating:raw.score, overview:raw.description || '', raw};
    nebulaItems.set(item.id,item);
    return item;
  }
  async function nebulaSearch(query) {
    const stored=(searchSnapshot.items||[]).filter(raw=>relevance({title:raw.title,originalTitle:raw.originalTitle,aliases:raw.aliases},query)<4).map(nebulaItem);
    if(stored.length||!Platform.nebulaCall)return stored;
    const data=await cached('nebula:'+query,TTL.search,()=>providerCall('search',{kind:'vod',query,page:1}));
    return (data.items||[]).map(nebulaItem);
  }
  async function nebulaDetail(id) {
    const previous = nebulaItems.get(id);
    try {
      const raw = await providerCall('details',{kind:'vod',id:id.replace(/^nebula:/,'')});
      return {...nebulaItem(raw),alternative:previous?.alternative};
    } catch(error) {
      if(previous)return {...previous,providerUnavailable:true};
      throw error;
    }
  }
  async function nebulaRows() { return []; }
  const withTimeout=(promise,ms)=>{let timer;return Promise.race([promise,new Promise((_,reject)=>{timer=setTimeout(()=>reject(Error('timeout')),ms);})]).finally(()=>clearTimeout(timer));};
  async function movieSources(detail) {
    const unknown={providerId:'nebula',state:'unknown',sources:[]};
    if(detail.type==='tv' || !Platform.nebulaCall) return unknown;
    const key='nebula:src:'+detail.type+':'+detail.id+':'+String(detail.year||'').slice(0,4);
    return cached(key,TTL.detail,()=>withTimeout(movieSourcesUncached(detail),8000)).then(result=>{if(!result.sources?.length)cache.delete(key);return result;}).catch(()=>{cache.delete(key);return unknown;});
  }
  async function movieSourcesUncached(detail) {
    const unknown={providerId:'nebula',state:'unknown',sources:[]};
    try {
      const extraMovieNames=String(detail.othersNames||'').split(/[|,;/]+/).map(s=>s.trim()).filter(Boolean);
      const movieLookup={...detail,originalTitle:detail.originalTitle||extraMovieNames[0]||''};
      const names=[...new Set([detail.title,detail.originalTitle,...extraMovieNames].filter(Boolean))];
      const year=String(detail.year||'').slice(0,4);
      if(!year)return unknown;
      let match=null;
      const batches=await Promise.allSettled(names.map(name=>nebulaSearch(name)));
      for(const batch of batches){
        if(batch.status!=='fulfilled')continue;
        match=CatalogSources.identity.selectMatch(movieLookup,batch.value);
        if(match)break;
      }
      if(!match){
        const laxo=(t)=>String(t||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,' ').trim();
        const anio=(v)=>Number(String(v||'').slice(0,4));
        for(const batch of batches){
          if(batch.status!=='fulfilled'||!Array.isArray(batch.value))continue;
          match=batch.value.find((candidato)=>laxo(candidato.title)===laxo(detail.title)&&(()=>{const a=anio(candidato.year||candidato.release_date),b=anio(year);return !a||!b||Math.abs(a-b)<=1;})())||null;
          if(match)break;
        }
      }
      if(!match){const failed=batches.find(batch=>batch.status==='rejected');if(failed)throw failed.reason;return unknown;}
      const confirmed=await providerCall('details',{kind:'vod',id:match.nebulaId});
      if(CatalogSources.identity.nebulaType(confirmed)==='tv')return unknown;
      const options=await providerCall('playback.options',{kind:'vod',id:match.nebulaId});
      const sources=(options.qualities||[]).flatMap(quality=>(quality.audio_languages?.length?quality.audio_languages:[{label:'Original',value:''}]).map(audio=>({name:quality.label+' · '+audio.label,size:'Fuente adicional',url:'nebula://source/'+encodeURIComponent(match.nebulaId)+'?'+new URLSearchParams({quality:quality.value,...(audio.value?{audio_language:audio.value}:{})})})));
      if(!sources.length && /enlace directo/i.test(options.notice||''))sources.push({name:'Original · Fuente adicional',url:'nebula://source/'+encodeURIComponent(match.nebulaId)});
      return {providerId:'nebula',state:sources.length?'available':'unknown',sources:sources.map((source)=>({...source,providerId:'nebula'}))};
    } catch(error){
      const code=String(error&&error.code||'').toLowerCase();
      if(['session_required','runtime_missing','runtime_unavailable','storage_unavailable','runtime_config_invalid','runtime_busy'].includes(code)||/^Conecta la fuente adicional.*Ajustes/i.test(String(error?.message||'')))return {providerId:'nebula',state:'not_connected',sources:[]};
      return CatalogSources.availability.failure('nebula',error);
    }
  }

  const TTL = {
    list: 15 * 60 * 1000,      // CONFIG_AUTO_REFRESH_TTL_MS del original: 15 min
    detail: 60 * 60 * 1000,
    search: 5 * 60 * 1000,
  };

  const cache = new Map();
  const inflight = new Map();

  function cacheGet(k, ttl) {
    const hit = cache.get(k);
    if (hit && Date.now() - hit.t < ttl) {cache.delete(k);cache.set(k,hit);return hit.v;}
    if(hit)cache.delete(k);
    return null;
  }
  function cacheSet(key,value){cache.delete(key);cache.set(key,value);while(cache.size>300)cache.delete(cache.keys().next().value);}

  async function cached(key, ttl, producer) {
    const hit = cacheGet(key, ttl);
    if (hit) return hit;
    if (inflight.has(key)) return inflight.get(key);
    const p = producer()
      .then((v) => { cacheSet(key, { t: Date.now(), v }); return v; })
      .finally(() => inflight.delete(key));
    inflight.set(key, p);
    return p;
  }

  function token() {
    return (Store.settings.tmdbToken || '').trim();
  }

  async function tmdb(pathname, params = {}) {
    const t = token();
    const url = new URL(BASE + pathname);
    url.searchParams.set('language', Store.settings.language || 'es-MX');
    for (const [k, v] of Object.entries(params)) {
      if (v !== undefined && v !== null && v !== '') url.searchParams.set(k, v);
    }
    const headers = {};
    const looksV4 = t.startsWith('eyJ');
    if (looksV4) headers.Authorization = `Bearer ${t}`;
    else url.searchParams.set('api_key', t);

    const res = await fetch(url.href, { headers });
    if (res.status === 404) return null;
    if (!res.ok) {
      const body = await res.text().catch(() => '');
      throw new Error(`TMDB HTTP ${res.status} ${body.slice(0, 120)}`);
    }
    return res.json();
  }

  const poster = (p, size = 'w342') => (p ? `${IMG}/${size}${p}` : null);
  const backdrop = (p, size = 'w1280') => (p ? `${IMG}/${size}${p}` : null);

  /* ---------------------- Filas de inicio ---------------------- */
  async function homeRows() {
    const rows = await Promise.allSettled([
      tmdb('/trending/all/week'),
      tmdb('/movie/popular'),
      tmdb('/tv/popular'),
      tmdb('/movie/top_rated'),
      tmdb('/tv/top_rated'),
      tmdb('/movie/now_playing'),
    ]);
    const labels = [
      ['Tendencias', 'trend'],
      ['Películas populares', 'movie'],
      ['Series populares', 'tv'],
      ['Mejor valoradas', 'all'],
      ['Series mejor valoradas', 'tv'],
      ['En cartelera / estrenos', 'movie'],
    ];
    const out = [];
    rows.forEach((r, i) => {
      if (r.status === 'fulfilled' && r.value && Array.isArray(r.value.results)) {
        out.push({ title: labels[i][0], items: r.value.results.map(normalize).filter(Boolean) });
      }
    });
    return out;
  }

  async function genres(type) {
    const d = await cached(`genres:${type}`, 24 * 60 * 60 * 1000, () =>
      tmdb(type === 'tv' ? '/genre/tv/list' : '/genre/movie/list'));
    return (d && d.genres) || [];
  }

  async function byGenre(type, genreId, page = 1) {
    const d = await cached(`disc:${type}:${genreId}:${page}`, TTL.list, () =>
      tmdb(`/discover/${type}`, { with_genres: genreId, page, sort_by: 'popularity.desc' }));
    return (d && d.results ? d.results : []).map(item=>normalize({...item,media_type:type})).filter(Boolean);
  }

  function normalize(r) {
    if (!r) return null;
    const type = r.media_type ? (r.media_type === 'tv' ? 'tv' : 'movie') : (r.first_air_date || r.name && r.release_date === undefined ? 'tv' : 'movie');
    const isTv = type === 'tv';
    const title = r.title || r.name || '';
    if (!title) return null;
    return {
      kind: 'tmdb',
      identities: [{providerId:'tmdb',id:String(r.id)}],
      type,
      id: r.id,
      title,
      originalTitle: r.original_title || r.original_name || '',
      poster: poster(r.poster_path),
      backdrop: backdrop(r.backdrop_path),
      year: (r.release_date || r.first_air_date || '').slice(0, 4),
      rating: r.vote_average ? Math.round(r.vote_average * 10) / 10 : null,
      overview: r.overview || '',
      genreIds: r.genre_ids || [],
    };
  }

  /* ---------------------- Detalle ---------------------- */
  async function movieDetail(id) {
    const d = await cached(`md:${id}`, TTL.detail, () =>
      tmdb(`/movie/${id}`, { append_to_response: 'credits,videos,external_ids', include_video_language: 'es,en,null' }));
    if (!d) return null;
    return {
      ...normalize(d), kind: 'tmdb',
      runtime: d.runtime,
      genres: (d.genres || []).map((g) => g.name),
      cast: (d.credits && d.credits.cast || []).slice(0, 14).map((c) => ({
        name: c.name, role: c.character, img: c.profile_path ? poster(c.profile_path, 'w185') : null,
      })),
      trailer: pickTrailer(d.videos),
    };
  }

  /* Nota puntual por id de TMDB (el catálogo no trae puntaje). */
  async function ratingFor(type, id) {
    if (!token() || !id) return null;
    try {
      const data = await cached(`rate:${type}:${id}`, TTL.detail, () => tmdb(`/${type === 'tv' ? 'tv' : 'movie'}/${id}`));
      const score = data && data.vote_average ? Math.round(data.vote_average * 10) / 10 : null;
      return MoviePlusUI.ratingValue(score);
    } catch {
      return null;
    }
  }

  async function seriesDetail(id) {
    const d = await cached(`sd:${id}`, TTL.detail, () =>
      tmdb(`/tv/${id}`, { append_to_response: 'credits,videos,external_ids', include_video_language: 'es,en,null' }));
    if (!d) return null;
    return {
      kind: 'tmdb', type: 'tv', id: d.id,
      title: d.name || d.original_name,
      originalTitle: d.original_name,
      poster: poster(d.poster_path),
      backdrop: backdrop(d.backdrop_path),
      year: (d.first_air_date || '').slice(0, 4),
      rating: d.vote_average ? Math.round(d.vote_average * 10) / 10 : null,
      overview: d.overview || '',
      genres: (d.genres || []).map((g) => g.name),
      seasons: (d.seasons || []).filter((s) => s.season_number > 0).map((s) => ({
        season: s.season_number, name: s.name, episodeCount: s.episode_count,
      })),
      cast: (d.credits && d.credits.cast || []).slice(0, 14).map((c) => ({
        name: c.name, role: c.character, img: c.profile_path ? poster(c.profile_path, 'w185') : null,
      })),
      trailer: pickTrailer(d.videos),
    };
  }

  function pickTrailer(videos) {
    const vids = (videos && videos.results) || [];
    const es = vids.find((v) => v.site === 'YouTube' && (v.type === 'Trailer') && /es|lat/.test(v.language || ''));
    const any = vids.find((v) => v.site === 'YouTube' && v.type === 'Trailer') || vids.find((v) => v.site === 'YouTube' && v.type === 'Teaser');
    return es || any ? `https://www.youtube.com/watch?v=${(es || any).key}` : null;
  }

  /** Episodios (EpisodeExtra: season, episode, name, overview, stillPath) */
  async function seasonEpisodes(id, season) {
    const d = await cached(`eps:${id}:${season}`, TTL.detail, () =>
      tmdb(`/tv/${id}/season/${season}`));
    if (!d) return [];
    return (d.episodes || []).map((e) => ({
      season,
      episode: e.episode_number,
      name: e.name || `Episodio ${e.episode_number}`,
      overview: e.overview || '',
      still: e.still_path ? `${IMG}/w300${e.still_path}` : null,
      runtime: e.runtime || null,
      air: e.air_date || '',
    }));
  }

  /* ---------------------- Búsqueda (ActivityMain.apiSearch) ---------------------- */
  const SEARCH_DEBOUNCE_MS = 300;   // REALTIME_SEARCH_DEBOUNCE_MS observado
  const SEARCH_MIN_CHARS = 2;       // REALTIME_SEARCH_MIN_CHARS observado

  const searchText = CatalogSources.identity.normalizeTitle;
  const relevance = MoviePlusCore.relevance;
  async function search(query, mode = 'multi', page = 1) {
    const q = (query || '').trim();
    if (q.length < SEARCH_MIN_CHARS) return { results: [], people: [] };
    const pathByMode = {
      multi: '/search/multi',
      title: '/search/multi',
      person: '/search/person',
      tmdbId: null,
    };
    if (mode === 'tmdbId') {
      const id = /^\d+$/.test(q)?Number(q):0;
      if (!Number.isSafeInteger(id)||id<=0) return { results: [], people: [] };
      const results = [];
      const mv = await tmdb(`/movie/${id}`).catch(() => null);
      if (mv) results.push(normalize({ ...mv, media_type: 'movie' }));
      const tv = await tmdb(`/tv/${id}`).catch(() => null);
      if (tv) results.push(normalize({ ...tv, media_type: 'tv' }));
      return { results: results.filter(Boolean), people: [] };
    }
    const d = await cached(`s:${mode}:${q}:${page}`, TTL.search, () =>
      tmdb(pathByMode[mode], { query: q, page, include_adult: false })).catch(() => null);
    const out = { results: [], people: [] };
    (d && d.results || []).forEach((r) => {
      if (mode === 'person' || r.media_type === 'person') {
        if (mode !== 'title') out.people.push({ id: r.id, name: r.name, img: poster(r.profile_path, 'w185'), known: r.known_for_department });
      } else {
        const n = normalize(r);
        if (n) out.results.push(n);
      }
    });
    out.total = (d && d.total_results) || 0;
    if (mode === 'multi' || mode === 'title') {
      const local=await providerCatalog.search(q,['movieplus']);
      const matches=local[0]?.items||[];
      out.results = [...matches, ...out.results.filter(item => !matches.some(candidate=>CatalogSources.identity.compare(item,candidate)==='id') && !CatalogSources.identity.selectMatch(item,matches))];
      out.total = Math.max(out.total, out.results.length);
    }

    // Fusionar fuentes locales del usuario (Archive.org + Jellyfin) solo en modo título/todo
    if (mode === 'multi' || mode === 'title') {
      const batches=await providerCatalog.search(q,['archive','jellyfin','nebula']);
      const [arch,jf,nebula]=batches.map(batch=>batch.error?{status:'rejected',reason:Error(batch.error)}:{status:'fulfilled',value:batch.items});
      const extras = [
        ...(arch.status === 'fulfilled' ? arch.value : []),
        ...(jf.status === 'fulfilled' ? jf.value : []),
      ];
      const tmdbIds = new Set(out.results.map((r) => `${r.type}:${r.id}`));
      extras.forEach((x) => { const id = `${x.type}:${x.id}`; if (!tmdbIds.has(id) && relevance(x, q) < 4) { out.results.push(x); tmdbIds.add(id); } });
      if(nebula.status==='fulfilled'){
        const catalogs=catalogIndexNow(),primary=[...catalogs.movies,...catalogs.series];
        const completed=MoviePlusCore.completeSearch(primary,nebula.value,q);
        for(const item of completed.primary)if(!out.results.some(existing=>CatalogSources.identity.compare(item,existing)==='id'))out.results.unshift(item);
        for(const item of completed.backup){
          const match=CatalogSources.identity.selectMatch(item,out.results);
          if(match&&match.kind!=='catalog'){
            match.additionalSource=true;match.nebulaId=item.nebulaId;match.aliases=[...new Set([...(match.aliases||[]),...(item.aliases||[])])];
            nebulaByCatalog.set(String(match.id),item.nebulaId);
          }else if(!match)out.results.push(item);
        }
      }
      out.notice = batches.filter(batch=>batch.error&&batch.state!=='not_connected').map(batch=>batch.providerId+': '+CatalogSources.availability.message(batch)).join(' · ');
      out.results = out.results.filter(item => relevance(item, q) < 4);
      out.results.sort((a,b)=>Number(b.kind==='catalog')-Number(a.kind==='catalog')||relevance(a,q)-relevance(b,q));
      out.total = out.results.length;
    }
    return out;
  }

  async function personTitles(id) {
    if (!/^[1-9]\d*$/.test(String(id))) throw new Error('Persona inválida');
    const credits = await cached('person:' + id, TTL.detail, () => tmdb('/person/' + id + '/combined_credits'));
    await loadCatalogs(Store.settings.catalogUrls || []);
    const unique = new Map();
    for (const raw of [...(credits?.cast || [])].sort((a, b) => (b.popularity || 0) - (a.popularity || 0))) {
      if (!['movie', 'tv'].includes(raw.media_type)) continue;
      const item = normalize(raw);
      if (!item) continue;
      const key = item.type + ':' + item.id;
      if (!unique.has(key)) unique.set(key, findCatalogItem(item.type, item.id) || item);
    }
    return [...unique.values()];
  }

  /* ---------------------- Catálogos externos (formato MoviePlus) ---------------------- */
  function mapCatalogItem(raw, fallbackType) {
    const type = MoviePlusCore.catalogMediaType(raw.type,fallbackType);
    const resolutions = String(raw.resolutions || '');
    const posterUrl = /^\/[A-Za-z0-9_.-]+$/.test(raw.urlImage || '') ? poster(raw.urlImage) : raw.urlImage || '';
    const sources = CatalogSources.parse(raw.urls, raw.resolutions);
    const available = sources.filter(source => source.url);
    return {
      kind: 'catalog',
      type,
      id: raw.id,
      title: raw.nameFile || `Item ${raw.id}`,
      othersNames: raw.othersNames || '',
      poster: posterUrl,
      backdrop: posterUrl,
      year: String(raw.date || raw.year || '').slice(0,4),
      rating: raw.vote || null,
      genreIds: raw.generos || [],
      resolutions,
      qualities: available,
      unavailableSources: sources.filter(source => !source.url),
      urls: available.map(source => source.url),
      isDes: !!raw.isDes,
      raw,
    };
  }

  function parseResolutions(res) {
    // "720p|1080p|4K" u objeto con tamaños según origen; soporta formato simple
    return String(res || '').split(/[|,;/]+/).map((s) => s.trim()).filter(Boolean)
      .map((n) => ({ name: n, size: '' }));
  }

  let builtinParsed=null;
  async function loadCatalog(url) {
    const res = url === 'movieplus:catalog' ? await Platform.defaultCatalog() : await Platform.catalogFetch(url);
    if (!res.ok) throw new Error(res.error || `HTTP ${res.status} en catálogo`);
    if(url==='movieplus:catalog'&&builtinParsed&&((res.releaseId&&res.releaseId===builtinParsed.releaseId)||(!res.releaseId&&res.text===builtinParsed.text)))return builtinParsed.value;
    const text = res.text;
    let data;
    try { data = JSON.parse(text); }
    catch { throw new Error('El catálogo no es JSON válido'); }
    const list = Array.isArray(data) ? data : null;
    const movieRows = list ? list.filter(row => MoviePlusCore.catalogMediaType(row.type,'movie') === 'movie') : data.movies || data.peliculas;
    const seriesRows = list ? list.filter(row => MoviePlusCore.catalogMediaType(row.type,'movie') === 'tv') : data.series;
    if (!Array.isArray(movieRows) && !Array.isArray(seriesRows)) throw new Error('El JSON no contiene una lista de películas o series');
    const map = (rows, type) => (Array.isArray(rows) ? rows : []).filter(m => m && (m.id || m.nameFile)).map((m,index) => {
      const identities=[{providerId:'catalog:'+url,id:String(m.id)}];
      const tmdbId=url==='movieplus:catalog'?m.id:m.tmdbId||m.tmdb_id;
      if(/^\d+$/.test(String(tmdbId)))identities.push({providerId:'tmdb',id:String(tmdbId)});
      const item={...mapCatalogItem(m,type),...(url==='movieplus:catalog'?{genreIds:MoviePlusCore.moviePlusGenreIds(m.generos)}:{}),catalogType:Number(m.type)||0,catalogOrder:Number.isFinite(Number(m.json_order))?Number(m.json_order):index,catalogUrl:url,identities};
      return {...item,aliases:[...new Set([...(item.aliases||[]),...(url==='movieplus:catalog'?searchSnapshot.primaryAliases?.[type+':'+tmdbId]||[]:[])])],identityKey:CatalogSources.identity.key(item)};
    });
    const value={ url, movies: map(movieRows, 'movie'), series: map(seriesRows, 'series') };
    if(url==='movieplus:catalog')builtinParsed={releaseId:res.releaseId||'',text:res.releaseId?'':res.text,value};
    return value;
  }

  const catalogsCache = new Map();
  /* El catálogo de la fuente no trae puntaje: se completa con el de TMDB ya visto. */
  function applyRatingCache(cat) {
    const cache = (Store.settings && Store.settings.ratingCache) || null;
    if (!cache || typeof cache !== 'object') return cat;
    for (const item of [...cat.movies, ...cat.series]) {
      if (!item) continue;
      const raw = item.rating;
      const numeric = raw === null || raw === undefined || raw === '' ? NaN : Number(String(raw).replace(',', '.'));
      if (Number.isFinite(numeric) && numeric > 0) continue;
      const cached = cache[item.type + ':' + item.id];
      if (cached) item.rating = cached;
    }
    return cat;
  }
  async function loadCatalogs(urls = []) {
    urls = [...new Set([...(Store.settings.builtinCatalog !== false ? ['movieplus:catalog'] : []), ...urls])];
    for(const url of catalogsCache.keys())if(!urls.includes(url)){catalogsCache.delete(url);cache.delete('cat:'+url);}
    const out = { items: [], errors: [], notices: [] };
    const profile=urls.some(CatalogSources.isTestCatalog)?await Platform.runtimeInfo?.().catch(()=>({profile:'user'})):null;
    await Promise.allSettled(urls.map(async (u) => {
      if(CatalogSources.isTestCatalog(u) && profile?.profile!=='qa'){
        catalogsCache.delete(u);
        if(!out.notices.length)out.notices.push('Se omitió un catálogo de pruebas fuera del perfil QA. Puedes revisarlo en Ajustes.');
        return;
      }
      try {
        const cat = applyRatingCache(await cached(`cat:${u}`,u==='movieplus:catalog'?30000:TTL.list,()=>loadCatalog(u)));
        catalogsCache.set(u, cat);
        out.items.push(...cat.movies, ...cat.series);
      } catch (e) {
        catalogsCache.delete(u);
        out.errors.push(`${u}: ${e.message}`);
      }
    }));
    syncCatalogIndex();
    return out;
  }

  let catalogIndex=null,catalogGeneration=0;
  const catalogLookupMemo=new WeakMap();
  let indexSources=new Map();
  function invalidateCatalogIndex(){catalogIndex=null;catalogGeneration++;}
  /* Solo reindexa si el contenido del caché cambió de verdad (por referencia). */
  function syncCatalogIndex(){
    let changed=indexSources.size!==catalogsCache.size;
    if(!changed)for(const [url,cat] of catalogsCache){if(indexSources.get(url)!==cat){changed=true;break;}}
    if(!changed)return;
    indexSources=new Map(catalogsCache);
    invalidateCatalogIndex();
  }
  function catalogIndexNow(){
    if(catalogIndex)return catalogIndex;
    const movies=[],series=[],byIdentity=new Map(),byNameYear=new Map();
    const add=item=>{
      for(const ident of (item.identities||[])){const key=ident.providerId+':'+ident.id;const list=byIdentity.get(key);if(list)list.push(item);else byIdentity.set(key,[item]);}
      const year=CatalogSources.identity.year(item);
      if(year)for(const name of CatalogSources.identity.names(item)){const key=name+'|'+year;const list=byNameYear.get(key);if(list){if(!list.includes(item))list.push(item);}else byNameYear.set(key,[item]);}
    };
    for(const cat of catalogsCache.values()){
      for(const item of cat.movies){movies.push(item);add(item);}
      for(const item of cat.series){series.push(item);add(item);}
    }
    catalogIndex={movies,series,byIdentity,byNameYear};
    return catalogIndex;
  }
  function resolveCatalogItem(type,id,identity){
    const index=catalogIndexNow();
    if(identity){
      for(const ident of (CatalogSources.identity.identities(identity)||[])){
        for(const item of index.byIdentity.get(ident.providerId+':'+ident.id)||[]){
          if(CatalogSources.identity.compare(identity,item)==='id')return item;
        }
      }
      const year=CatalogSources.identity.year(identity);
      if(!year)return null;
      const near=new Set();
      for(const name of CatalogSources.identity.names(identity)){
        for(const item of index.byNameYear.get(name+'|'+year)||[])near.add(item);
      }
      return near.size?CatalogSources.identity.selectMatch(identity,[...near]):null;
    }
    const pool=index.movies.concat(index.series);
    const confirmed=pool.find(item=>item.type===type&&item.identities?.some(ident=>ident.providerId==='tmdb'&&String(ident.id)===String(id)));
    if(confirmed)return confirmed;
    const legacy=pool.filter(item=>item.type===type&&String(item.id)===String(id));
    return legacy.length===1?legacy[0]:null;
  }
  function findCatalogItem(type,id,identity){
    if(identity&&typeof identity==='object'){
      const memo=catalogLookupMemo.get(identity);
      if(memo&&memo.generation===catalogGeneration)return memo.value;
      const value=resolveCatalogItem(type,id,identity);
      catalogLookupMemo.set(identity,{generation:catalogGeneration,value});
      return value;
    }
    return resolveCatalogItem(type,id,identity);
  }
  async function catalogEpisodes(id) {
    const result = await Platform.seriesEpisodes(id);
    if (!result.ok) throw new Error(result.error || 'No se pudieron cargar los capítulos');
    return result.episodes;
  }

  function catalogHomeRows() {
    const rows = [];
    for (const [url, cat] of catalogsCache) {
      if (cat.movies.length) rows.push({ title: `🎬 Catálogo: películas`, items: cat.movies.slice(0, 30), catalogUrl: url });
      if (cat.series.length) rows.push({ title: `🎬 Catálogo: series`, items: cat.series.slice(0, 30), catalogUrl: url });
    }
    return rows;
  }

  /* ==================== Fuentes legales ====================
   * Archive.org (dominio público, MP4 directos + .srt) y Jellyfin
   * (servidor propio del usuario, API oficial). Fetch por IPC sin CORS. */

  async function bridgeJson(url, ttlMs) {
    const key = `nf:${url}`;
    if (ttlMs) {
      const hit = cacheGet(key, ttlMs);
      if (hit) return hit;
    }
    const r = await Platform.netFetch(url);
    let data = null;
    try { data = JSON.parse(r.text); } catch {}
    if (!r.ok) throw new Error(`HTTP ${r.status} ${String(r.text).slice(0, 80)}`);
    if (data === null) throw new Error('Respuesta no JSON');
    if (ttlMs) cacheSet(key, { t: Date.now(), v: data });
    return data;
  }

  /* ---------------- Archive.org (dominio público) ---------------- */
  const ARCHIVE_SEARCH = 'https://archive.org/advancedsearch.php';
  const ARCHIVE_FIELDS = '&fl%5B%5D=identifier&fl%5B%5D=title&fl%5B%5D=year&fl%5B%5D=description&fl%5B%5D=downloads&output=json';

  function archiveNormalize(doc) {
    if (!doc || !doc.identifier) return null;
    return {
      kind: 'archive',
      type: 'movie',
      id: doc.identifier,
      title: Array.isArray(doc.title) ? doc.title[0] : (doc.title || doc.identifier),
      poster: `https://archive.org/services/img/${doc.identifier}`,
      backdrop: `https://archive.org/services/img/${doc.identifier}`,
      year: String(Array.isArray(doc.year) ? doc.year[0] : (doc.year || '')),
      rating: null,
      overview: String((Array.isArray(doc.description) ? doc.description[0] : doc.description) || '')
        .replace(/<[^>]*>/g, ' ').trim().slice(0, 400),
      downloads: doc.downloads || 0,
    };
  }

  async function archiveRows() {
    try {
      const base = 'collection:(feature_films) AND mediatype:(movies) AND format:(MPEG4)';
      const popular = await bridgeJson(
        `${ARCHIVE_SEARCH}?q=${encodeURIComponent(base)}&sort%5B%5D=downloads+desc&rows=40&page=1${ARCHIVE_FIELDS}`,
        TTL.list);
      const scifi = await bridgeJson(
        `${ARCHIVE_SEARCH}?q=${encodeURIComponent(base + ' AND subject:("science fiction")')}&sort%5B%5D=downloads+desc&rows=24&page=1${ARCHIVE_FIELDS}`,
        TTL.list);
      const horror = await bridgeJson(
        `${ARCHIVE_SEARCH}?q=${encodeURIComponent(base + ' AND subject:(horror)')}&sort%5B%5D=downloads+desc&rows=24&page=1${ARCHIVE_FIELDS}`,
        TTL.list);
      const rows = [];
      if (popular?.response?.docs) rows.push({ title: '📽️ Clásicos de dominio público — más vistos', items: popular.response.docs.map(archiveNormalize).filter(Boolean) });
      if (scifi?.response?.docs) rows.push({ title: '🛸 Ciencia ficción clásica', items: scifi.response.docs.map(archiveNormalize).filter(Boolean) });
      if (horror?.response?.docs) rows.push({ title: '👻 Terror clásico', items: horror.response.docs.map(archiveNormalize).filter(Boolean) });
      return rows;
    } catch {
      return [];
    }
  }

  async function archiveSearch(q) {
      const d = await bridgeJson(
        `${ARCHIVE_SEARCH}?q=${encodeURIComponent(`title:("${q.replace(/["\\]/g, ' ')}") AND mediatype:(movies) AND format:(MPEG4)`)}&sort%5B%5D=downloads+desc&rows=24&page=1${ARCHIVE_FIELDS}`,
        TTL.search);
      return (d?.response?.docs || []).map(archiveNormalize).filter(item => item && relevance(item, q) < 4);
  }

  async function archiveDetail(id) {
    const meta = await bridgeJson(`https://archive.org/metadata/${id}`, TTL.detail);
    if (!meta || (!meta.files && !meta.metadata)) throw new Error('Sin datos en Archive.org');
    const files = meta.files || [];
    const videoExts = ['.mp4', '.m4v', '.ogv', '.webm'];
    const videos = files
      .filter((f) => videoExts.some((e) => f.name.toLowerCase().endsWith(e)))
      .sort((a, b) => (parseInt(b.size || '0', 10) || 0) - (parseInt(a.size || '0', 10) || 0));
    const subs = files.filter((f) => f.name.toLowerCase().endsWith('.srt') || f.name.toLowerCase().endsWith('.vtt'));
    const m = meta.metadata || {};
    const fmtSize = (n) => { const v = parseInt(n || '0', 10); return v > 0 ? fmtBytesArchive(v) : ''; };
    // Deduplicar por etiqueta (varios derivados con el mismo nombre) y limitar la lista:
    // preferir MP4 (compatible con Chromium) sobre OGV, y quedarse con el mayor de cada etiqueta.
    const seenLabels = new Set();
    const mp4s = videos.filter((f) => f.name.toLowerCase().endsWith('.mp4') || f.name.toLowerCase().endsWith('.m4v'));
    const others = videos.filter((f) => !mp4s.includes(f));
    const picked = [];
    for (const f of [...mp4s, ...others]) {
      const h = f.height ? `${f.height}p` : '';
      const label = `${(f.name.split('.').pop() || 'mp4').toUpperCase()}${h ? ' ' + h : ''}`;
      if (seenLabels.has(label)) continue;
      seenLabels.add(label);
      picked.push({
        name: label,
        size: fmtSize(f.size),
        url: `https://archive.org/download/${id}/${encodeURIComponent(f.name).replace(/%2F/gi, '/')}`,
      });
      if (picked.length >= 10) break;
    }
    return {
      kind: 'archive', type: 'movie', id,
      title: m.title || id,
      poster: `https://archive.org/services/img/${id}`,
      backdrop: `https://archive.org/services/img/${id}`,
      year: String(m.year || m.date || '').slice(0, 4),
      rating: null,
      overview: String(m.description || '').replace(/<[^>]*>/g, ' ').trim(),
      sources: picked,
      subtitles: subs.map((f) => ({ name: f.name, url: `https://archive.org/download/${id}/${encodeURIComponent(f.name)}` })),
    };
  }

  function fmtBytesArchive(n) {
    const u = ['B', 'KB', 'MB', 'GB'];
    let i = 0;
    while (n >= 1024 && i < u.length - 1) { n /= 1024; i++; }
    return `${n.toFixed(i === 0 ? 0 : 1)} ${u[i]}`;
  }

  /* ---------------- Jellyfin (servidor propio, API oficial) ---------------- */
  function jellyfinBase() {
    const s = Store.settings;
    const base = (s.jellyfinUrl || '').trim().replace(/\/+$/, '');
    const key = (s.jellyfinKey || '').trim();
    return base && key ? { base, key } : null;
  }
  function jellyfinImg(base, key, itemId, type = 'Primary', max = 342) {
    return `${base}/Items/${itemId}/Images/${type}?api_key=${key}&maxWidth=${max}`;
  }
  function jellyfinStream(base, key, itemId) {
    return `${base}/Videos/${itemId}/master.m3u8?api_key=${key}&MediaSourceId=${itemId}&VideoCodec=h264&AudioCodec=aac,mp3`;
  }

  function jellyfinNormalize(base, key, it) {
    if (!it || !it.Id) return null;
    return {
      kind: 'jellyfin',
      type: it.Type === 'Series' || it.Type === 'Episode' ? 'tv' : 'movie',
      id: it.Id,
      seriesId: it.SeriesId || null,
      title: it.SeriesName && it.Type === 'Episode' ? `${it.SeriesName} — ${it.Name}` : (it.Name || 'Sin título'),
      poster: jellyfinImg(base, key, it.Id, 'Primary'),
      backdrop: jellyfinImg(base, key, it.Id, 'Backdrop', 1280),
      year: it.ProductionYear ? String(it.ProductionYear) : '',
      rating: it.CommunityRating ? Math.round(it.CommunityRating * 10) / 10 : null,
      overview: it.Overview || '',
      episode: it.Type === 'Episode' ? { season: it.ParentIndexNumber, number: it.IndexNumber } : null,
    };
  }

  async function jellyfinRows() {
    const jf = jellyfinBase();
    if (!jf) return [];
    try {
      const d = await bridgeJson(
        `${jf.base}/Items?api_key=${jf.key}&Recursive=true&IncludeItemTypes=Movie,Series&SortBy=SortName&Limit=40&Fields=PrimaryImageAspectRatio,Overview,ProductionYear,CommunityRating`,
        TTL.list);
      const recent = await bridgeJson(
        `${jf.base}/Items?api_key=${jf.key}&Recursive=true&IncludeItemTypes=Movie,Series&SortBy=DateCreated&SortOrder=Descending&Limit=40&Fields=PrimaryImageAspectRatio,Overview,ProductionYear,CommunityRating`,
        TTL.list);
      const rows = [];
      if (d?.Items?.length) rows.push({ title: `🏠 Tu Jellyfin — Biblioteca`, items: d.Items.map((x) => jellyfinNormalize(jf.base, jf.key, x)).filter(Boolean) });
      if (recent?.Items?.length) rows.push({ title: `🆕 Tu Jellyfin — Añadido recientemente`, items: recent.Items.map((x) => jellyfinNormalize(jf.base, jf.key, x)).filter(Boolean) });
      return rows;
    } catch (e) {
      return [{ title: `⚠️ Jellyfin (${String(e.message).slice(0, 60)})`, items: [] }];
    }
  }

  async function jellyfinSearch(q) {
    const jf = jellyfinBase();
    if (!jf) return [];
      const d = await bridgeJson(
        `${jf.base}/Items?api_key=${jf.key}&searchTerm=${encodeURIComponent(q)}&Recursive=true&IncludeItemTypes=Movie,Series&Limit=20&Fields=PrimaryImageAspectRatio,Overview,ProductionYear,CommunityRating`,
        TTL.search);
      return (d?.Items || []).map((x) => jellyfinNormalize(jf.base, jf.key, x)).filter(Boolean);
  }

  async function jellyfinDetail(id) {
    const jf = jellyfinBase();
    if (!jf) throw new Error('Jellyfin no configurado');
    const it = await bridgeJson(`${jf.base}/Items/${id}?api_key=${jf.key}`, TTL.detail);
    if (!it || !it.Id) throw new Error('Elemento no encontrado');
    const base = jellyfinNormalize(jf.base, jf.key, it);
    const seasons = [];
    if (base.type === 'tv') {
      const sd = await bridgeJson(`${jf.base}/Shows/${id}/Seasons?api_key=${jf.key}`, TTL.detail);
      (sd?.Items || []).forEach((s) => {
        if (s.IndexNumber > 0 || (s.IndexNumber === undefined)) {
          seasons.push({ season: s.IndexNumber ?? 1, name: s.Name || `Temporada ${s.IndexNumber}`, seasonId: s.Id });
        }
      });
    }
    return { ...base, genres: it.Genres || [], runtime: it.RunTimeTicks ? Math.round(it.RunTimeTicks / 600000000) : null, seasons };
  }

  async function jellyfinEpisodes(seriesId, seasonId) {
    const jf = jellyfinBase();
    if (!jf) throw new Error('Jellyfin no configurado');
    const d = await bridgeJson(
      `${jf.base}/Shows/${seriesId}/Episodes?api_key=${jf.key}&SeasonId=${seasonId}&Fields=Overview,PrimaryImageAspectRatio,ProductionYear`,
      TTL.detail);
    const episodes=(d?.Items || []).map((x) => jellyfinNormalize(jf.base, jf.key, x));
    if(Platform.registerSources)for(const episode of episodes){const sources=await Platform.registerSources([{name:'HLS · Jellyfin',url:jellyfinPrivateStreamUrl(episode.id)}]);jellyfinReferences.set(episode.id,sources[0].url);}
    return episodes;
  }

  function sourceHomeRows() {
    return { archive: archiveRows, jellyfin: jellyfinRows };
  }

  /* ---------------- Dónde verla legalmente (TMDB/JustWatch) ---------------- */
  function regionFromLang() {
    const l = (Store.settings.language || 'es-MX').toLowerCase();
    if (l.includes('es-es')) return 'ES';
    if (l.startsWith('en')) return 'US';
    return 'AR'; // catálogo rioplatense por defecto
  }

  async function watchProviders(type, id) {
    const region = regionFromLang();
    const d = await cached(`wp:${type}:${id}`, TTL.detail, () => tmdb(`/${type}/${id}/watch/providers`));
    const r = d && d.results && d.results[region];
    if (!r) return { region, groups: [], link: null };
    const groups = [
      ['Suscripción', r.flatrate || []],
      ['Renta', r.rent || []],
      ['Compra', r.buy || []],
    ].filter(([, arr]) => arr.length);
    return { region, groups, link: r.link };
  }

  /** URL de reproducción de un elemento de Jellyfin por su ID */
  function jellyfinPrivateStreamUrl(itemId) {
    const jf = jellyfinBase();
    if (!jf) throw new Error('Jellyfin no configurado');
    return jellyfinStream(jf.base, jf.key, itemId);
  }
  function jellyfinStreamUrl(itemId){return Platform.registerSources?jellyfinReferences.get(itemId)||'':jellyfinPrivateStreamUrl(itemId);}

  return {
    homeRows, genres, byGenre, movieDetail, ratingFor, seriesDetail, seasonEpisodes, search, personTitles, nebulaDetail, nebulaRows, movieSources, sourcesFor, episodesFor, sourceCapabilities:providerCatalog.capabilities,
    poster, backdrop, loadCatalogs, findCatalogItem, catalogHomeRows,
    SEARCH_DEBOUNCE_MS, SEARCH_MIN_CHARS,
    parseSources: CatalogSources.parse,
    catalogEpisodes,
    invalidate: () => cache.clear(),
    /* fuentes */
    archiveRows, archiveSearch, archiveDetail,
    jellyfinRows, jellyfinSearch, jellyfinDetail, jellyfinEpisodes, jellyfinBase, jellyfinStreamUrl,
    watchProviders,
  };
})();
