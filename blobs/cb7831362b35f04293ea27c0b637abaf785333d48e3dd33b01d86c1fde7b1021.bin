/* Compact touch layout. Resume cards keep their title and progress beside the image. */
@media (max-width: 600px) {
  body.platform-android:not(.platform-tv) .feature-spotlight { min-height: 0; }
  body.platform-android:not(.platform-tv) .feature-copy { max-width: 100%; width: 100%; padding: 24px 20px; }
  body.platform-android:not(.platform-tv) .feature-copy > p { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  body.platform-android:not(.platform-tv) .resume-row { display: flex; overflow-x: auto; padding: 4px 0 10px; }
  body.platform-android:not(.platform-tv) .resume-card { flex: 0 0 88%; width: 88%; min-width: 0; max-width: 88%; padding: 12px; }
  body.platform-android:not(.platform-tv)[data-flex-gap="unsupported"] .resume-card { margin-right: 12px; }
  body.platform-android:not(.platform-tv) .resume-card-art { flex: 0 0 84px; width: 84px; min-width: 84px; height: 126px; }
  body.platform-android:not(.platform-tv)[data-flex-gap="unsupported"] .resume-card-art { margin-right: 12px; }
  body.platform-android:not(.platform-tv) .resume-card-body { flex: 1; min-width: 0; justify-content: center; }
  body.platform-android:not(.platform-tv) .resume-card-title { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; white-space: normal; font-size: 16px; line-height: 1.3; }
  body.platform-android:not(.platform-tv) .resume-card-meta { margin-top: 8px; font-size: 13px; line-height: 1.4; }
}
