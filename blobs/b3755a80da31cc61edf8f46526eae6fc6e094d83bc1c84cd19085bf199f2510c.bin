'use strict';
document.body.classList.add("platform-android");
const gapProbe=document.createElement("div");gapProbe.style.cssText="display:flex;flex-direction:column;row-gap:1px;position:absolute;visibility:hidden";gapProbe.innerHTML="<div style=height:1px></div><div style=height:1px></div>";document.body.append(gapProbe);document.body.dataset.flexGap=gapProbe.scrollHeight===3?"supported":"unsupported";gapProbe.remove();
(async()=>{try{await AndroidReady;const runtime=await AndroidNative.call("runtime.info");Platform.systemFontScale=runtime.fontScale||1;Platform.offlineDownloads=runtime.offlineDownloads===true;if(window.MoviePlusUiTarget==="tv"||(window.MoviePlusUiTarget!=="phone"&&runtime.tv))document.body.classList.add("platform-tv");for(const source of ['assets/catalog-search-index.js','store.js','core/media-identity.js','core/source-availability.js','core/catalog-service.js','catalog-sources.js','playback-tracks.js','source-connection.js','api.js','android-player.js','visible-ratings.js','app-updates.js','app.js'])await new Promise((resolve,reject)=>{const script=document.createElement('script');script.src=source;script.onload=resolve;script.onerror=reject;document.body.append(script);});const foot=document.querySelector('.sidebar-foot span');if(foot)foot.textContent='Nébula para Android';}catch{document.getElementById('content').textContent='No se pudo abrir el perfil de Android. Se conservaron sus archivos. Cierra MoviePlus e inténtalo nuevamente.';}})();



