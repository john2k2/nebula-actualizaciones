'use strict';
const AppUpdates=(()=>{
 let snapshot={state:'current',nativeVersion:'',supported:false},busy=false,started=false,lastCheck=0,notified=0;
 const call=operation=>Platform.updatesCall(operation);
 function cleanVer(value){return String(value||'').split('+')[0].trim();}
 function nextVer(){return cleanVer(snapshot.version)||cleanVer(snapshot.latestVersion)||cleanVer(snapshot.nativeVersion);}
 function message(){
  if(busy)return snapshot.state==='downloading'?'Descargando…':'Buscando actualizaciones…';
  if(snapshot.state==='ready'||snapshot.state==='native_required')return '';
  return {current:'La aplicación está al día.',recovered:'Se restauró la versión anterior porque la última actualización no terminó de iniciar.',disabled:'Las actualizaciones se comprueban en la aplicación instalada.',error:'No se pudo buscar la actualización. Revisa tu conexión y vuelve a intentar.'}[snapshot.state]||'';
 }
 // Card from the canvas «Ajustes · Actualización lista»: show only the target version without extra details.
 function title(){
  if(busy){const v=cleanVer(snapshot.nativeVersion);return v?'Versión '+v:'';}
  if(snapshot.state==='ready'||snapshot.state==='native_required'){const v=nextVer();return v?'Versión '+v:'Nueva versión';}
  // Sin actualizador (iOS), la versión sale de la etiqueta que escribe el empaquetador («v 1.16.5»).
  const installed=cleanVer(snapshot.nativeVersion)||cleanVer(String(document.getElementById?.('appVersionLabel')?.textContent||'').replace(/^v\s*/,''));
  return installed?'Versión '+installed:'';
 }
 function refresh(){
  const text=document.getElementById('updateStatus'),version=document.getElementById('updateVersion'),check=document.getElementById('updateCheck'),apply=document.getElementById('updateApply'),hint=document.getElementById('updateHint');
  const pending=!busy&&['ready','native_required'].includes(snapshot.state);
  const msg=message();
  document.querySelector?.('.set-card-updates')?.classList?.toggle('update-pending',['ready','native_required'].includes(snapshot.state));
  if(text){text.textContent=msg;text.hidden=!msg;text.classList?.toggle?.('hidden',!msg);}if(version)version.textContent=title();
  if(hint){hint.hidden=pending;hint.classList.toggle('hidden',pending);}
  if(check){check.disabled=busy||!snapshot.supported;(check.querySelector?.('.update-check-label')||check).textContent=busy?'Buscando…':'Buscar actualizaciones';check.hidden=pending;check.classList.toggle('hidden',pending);}
  if(apply){const visible=['ready','native_required'].includes(snapshot.state);apply.hidden=!visible;apply.classList.toggle('hidden',!visible);apply.classList.toggle('primary',snapshot.state!=='native_required');apply.disabled=busy;apply.textContent=snapshot.state==='native_required'?'Actualizar versión completa':'Actualizar ahora';}
 }
 function notify(){
  if(!['ready','native_required'].includes(snapshot.state)||notified===snapshot.sequence||document.hidden)return;
  const player=document.getElementById('playerLayer');if(player&&!player.classList.contains('hidden'))return;
  notified=snapshot.sequence;
  const v=nextVer();
  App.toastAction(v?'Versión '+v:'Nueva versión','Ver',()=>App.go('settings'));
 }
 async function check(manual=false){
  if(busy||typeof Platform.updatesCall!=='function')return;
  busy=true;refresh();
  try{
   snapshot=await call('check');lastCheck=Date.now();
   if(snapshot.state==='available'){snapshot.state='downloading';refresh();snapshot=await call('download');}
   if(manual&&snapshot.state==='current')App.toast('La aplicación está al día.');
  }catch{snapshot={...snapshot,state:'error'};if(manual)App.toast('No se pudo buscar la actualización. Vuelve a intentar.');}
  finally{busy=false;refresh();notify();}
 }
 async function apply(){
  if(busy)return;
  const player=document.getElementById('playerLayer');
  if(document.hidden||(player&&!player.classList.contains('hidden'))){App.toast('Cierra la reproducción antes de aplicar la actualización.');return;}
  busy=true;refresh();
  try{
   if(typeof AndroidNative!=='undefined')await AndroidNative.flush();
   if(snapshot.state==='native_required'){const next=await call('native');if(next&&typeof next==='object'){snapshot={...snapshot,...next};if(next.message)App.toast(next.message);}return;}
   await call('apply');
  }catch(error){const detail=String(error?.message||'').trim();App.toast(detail&&!/^no se pudo completar la operaci[oó]n$/i.test(detail)?detail:'No se pudo aplicar la actualización. Tu versión actual se conserva.');}
  finally{busy=false;refresh();}
 }
 function html(){return '<div class="set-card set-card-updates"><h2><svg class="set-head-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12 M7 10l5 5 5-5 M5 21h14"/></svg>Actualizaciones</h2><div class="update-summary"><span class="update-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3v12 M7 10l5 5 5-5 M5 21h14"/></svg></span><div class="update-copy"><h3 id="updateVersion"></h3><p id="updateStatus" role="status" aria-live="polite">Consultando la versión instalada…</p></div></div><p class="hint" id="updateHint">Las mejoras habituales descargan solo los archivos modificados. Tus favoritos y tu progreso se conservan.</p><div class="m-actions set-actions-start"><button type="button" class="btn" id="updateCheck"><svg class="set-btn-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.34-5.66 M20 4v4h-4"/></svg><span class="update-check-label">Buscar actualizaciones</span></button><button type="button" class="btn primary" id="updateApply" hidden>Actualizar ahora</button></div></div>';}
 function bind(){const checkButton=document.getElementById('updateCheck'),applyButton=document.getElementById('updateApply');if(checkButton)checkButton.onclick=()=>check(true);if(applyButton)applyButton.onclick=apply;refresh();}
 async function start(){
  if(started||typeof Platform.updatesCall!=='function')return;started=true;
  try{snapshot=await call('status');if(snapshot.supported)snapshot=await call('confirm');refresh();}catch{return;}
  if(!snapshot.supported)return;
  setTimeout(()=>check(),3500);
  setInterval(()=>{if(!document.hidden&&Date.now()-lastCheck>6*60*60*1000)check();},30*60*1000);
  document.addEventListener('visibilitychange',()=>{if(!document.hidden){notify();if(Date.now()-lastCheck>6*60*60*1000)check();}});
 }
 return {html,bind,start,check};
})();
