'use strict';
const NebulaAccount = (() => {
  const DEFAULT_API_BASE = 'https://nebula.ortiz-jonathan.workers.dev';
  const STORAGE_KEY = 'nebula_account_v1';
  const REFRESH_TTL_MS = 3 * 60 * 1000;
  const PERIODIC_REFRESH_MS = 30 * 60 * 1000;
  const REQUEST_TIMEOUT_MS = 10000;

  let memoryFallback = null;
  let started = false;
  let refreshPromise = null;
  let cachedAppVersion = '';

  function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, (ch) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    }[ch]));
  }

  function apiBase() {
    const raw = typeof Store !== 'undefined' ? String(Store?.settings?.accountApiUrl || '').trim() : '';
    if (/^(?:https:\/\/|http:\/\/(?:127\.0\.0\.1|localhost)(?::\d+)?(?:\/|$))/i.test(raw)) {
      return raw.replace(/\/+$/, '');
    }
    return DEFAULT_API_BASE;
  }

  function plansUrl() {
    return `${apiBase()}/suscripcion?buy=1`;
  }

  function tvUrl() {
    return `${apiBase()}/tv`;
  }

  function normalizeAccess(raw) {
    if (!raw || typeof raw !== 'object') return null;
    const expiresAt = Number(raw.expiresAt);
    return {
      hasAccess: Boolean(raw.hasAccess),
      state: String(raw.state || 'none'),
      expiresAt: Number.isFinite(expiresAt) && expiresAt > 0 ? expiresAt : null,
      daysRemaining: Math.max(0, Number(raw.daysRemaining) || 0),
      trialUsed: Boolean(raw.trialUsed),
      planId: raw.planId ? String(raw.planId) : null,
    };
  }

  function emptyState() {
    return { token: '', email: '', country: '', access: null, lastCheckedAt: 0 };
  }

  function readState() {
    let raw = null;
    try {
      raw = globalThis.localStorage?.getItem?.(STORAGE_KEY) ?? memoryFallback;
    } catch {
      raw = memoryFallback;
    }
    if (!raw) return emptyState();
    try {
      const parsed = JSON.parse(raw);
      if (!parsed || typeof parsed !== 'object') return emptyState();
      return {
        token: typeof parsed.token === 'string' ? parsed.token : '',
        email: typeof parsed.email === 'string' ? parsed.email : '',
        country: typeof parsed.country === 'string' ? parsed.country : '',
        access: normalizeAccess(parsed.access),
        lastCheckedAt: Number(parsed.lastCheckedAt) || 0,
      };
    } catch {
      return emptyState();
    }
  }

  function writeState(next) {
    const clean = {
      token: typeof next?.token === 'string' ? next.token : '',
      email: typeof next?.email === 'string' ? next.email : '',
      country: typeof next?.country === 'string' ? next.country : '',
      access: normalizeAccess(next?.access),
      lastCheckedAt: Number(next?.lastCheckedAt) || 0,
    };
    const serialized = JSON.stringify(clean);
    memoryFallback = serialized;
    try {
      globalThis.localStorage?.setItem?.(STORAGE_KEY, serialized);
    } catch {}
    return clean;
  }

  function clearState() {
    memoryFallback = null;
    try {
      globalThis.localStorage?.removeItem?.(STORAGE_KEY);
    } catch {}
  }

  function getState() {
    return readState();
  }

  function hasAccess(now = Date.now()) {
    const state = readState();
    if (!state.token || !state.access?.hasAccess) return false;
    if (state.access.expiresAt !== null && state.access.expiresAt <= now) return false;
    return true;
  }

  function daysRemaining(now = Date.now()) {
    const state = readState();
    if (!state.token || !state.access) return 0;
    if (state.access.expiresAt !== null) {
      if (state.access.expiresAt <= now) return 0;
      return Math.max(1, Math.ceil((state.access.expiresAt - now) / 86400000));
    }
    return state.access.hasAccess ? Math.max(0, state.access.daysRemaining || 0) : 0;
  }

  function detectPlatform() {
    const isTvClass = typeof document !== 'undefined' && Boolean(document.body?.classList?.contains?.('platform-tv'));
    if ((typeof Platform !== 'undefined' && Platform.isTizen) || isTvClass) return 'android-tv';
    if (typeof Platform !== 'undefined' && Platform.isAndroid) return 'android-phone';
    if (typeof Platform !== 'undefined' && Platform.isMac) return 'macos';
    if (typeof Platform !== 'undefined' && Platform.isIos) return 'web';
    return 'windows';
  }

  function detectDeviceName() {
    const platform = detectPlatform();
    if (platform === 'android-tv') return 'Android TV';
    if (platform === 'android-phone') return 'Celular Android';
    if (platform === 'macos') return 'Mac';
    if (platform === 'web' && typeof Platform !== 'undefined' && Platform.isIos) return 'iPhone / iPad';
    return 'PC Windows';
  }

  function resolveAppVersion() {
    if (cachedAppVersion) return cachedAppVersion;
    const labelText = typeof document !== 'undefined'
      ? String(document.getElementById?.('appVersionLabel')?.textContent || '').replace(/^v\s*/i, '').trim()
      : '';
    return labelText || 'app';
  }

  function openExternalUrl(url) {
    const href = String(url || '').trim();
    if (!href) return Promise.resolve(false);
    try {
      if (typeof Platform !== 'undefined') {
        if (typeof Platform.openExternal === 'function') return Promise.resolve(Platform.openExternal(href));
        if (typeof Platform.openUrl === 'function') return Promise.resolve(Platform.openUrl(href));
      }
      globalThis.open?.(href, '_blank', 'noopener');
      return Promise.resolve(true);
    } catch {
      return Promise.resolve(false);
    }
  }

  function notify(message) {
    if (typeof App !== 'undefined' && typeof App.toast === 'function') App.toast(message);
  }

  async function requestJson(path, options = {}) {
    if (typeof fetch !== 'function') {
      throw Object.assign(Error('Red no disponible en este entorno.'), { isNetwork: true });
    }
    const { method = 'GET', body = null, token = '' } = options;
    const headers = {};
    if (body !== null) headers['Content-Type'] = 'application/json';
    if (token) headers.Authorization = `Bearer ${token}`;

    const controller = typeof AbortController === 'function' ? new AbortController() : null;
    const timer = controller ? setTimeout(() => controller.abort(), REQUEST_TIMEOUT_MS) : null;
    try {
      const response = await fetch(`${apiBase()}${path}`, {
        method,
        headers,
        body: body !== null ? JSON.stringify(body) : undefined,
        signal: controller?.signal,
      });
      const text = await response.text().catch(() => '');
      let data = {};
      try {
        data = text ? JSON.parse(text) : {};
      } catch {
        data = {};
      }
      return { ok: response.ok, status: response.status, data };
    } catch (error) {
      throw Object.assign(Error(error?.message || 'Sin conexión'), { isNetwork: true, cause: error });
    } finally {
      if (timer !== null) clearTimeout(timer);
    }
  }

  async function requestOtp(email) {
    const cleanEmail = String(email || '').trim().toLowerCase();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(cleanEmail)) {
      return { ok: false, error: 'Ingresá un correo electrónico válido.' };
    }
    try {
      const res = await requestJson('/api/auth/otp', {
        method: 'POST',
        body: { email: cleanEmail },
      });
      if (!res.ok || res.data?.ok === false) {
        return {
          ok: false,
          error: res.data?.error || 'No se pudo enviar el código. Intentá nuevamente.',
        };
      }
      return {
        ok: true,
        email: cleanEmail,
        expiresInSeconds: Number(res.data?.expiresInSeconds) || 600,
      };
    } catch {
      return { ok: false, offline: true, error: 'No pudimos conectarnos. Revisá tu conexión a Internet.' };
    }
  }

  async function verifyOtp(email, code) {
    const cleanEmail = String(email || '').trim().toLowerCase();
    const cleanCode = String(code || '').replace(/\D/g, '');
    if (!/^\d{6}$/.test(cleanCode)) {
      return { ok: false, error: 'Ingresá el código de 6 dígitos que llegó a tu correo.' };
    }
    try {
      const res = await requestJson('/api/auth/verify', {
        method: 'POST',
        body: {
          email: cleanEmail,
          code: cleanCode,
          deviceName: detectDeviceName(),
          platform: detectPlatform(),
          appVersion: resolveAppVersion(),
        },
      });
      if (!res.ok || !res.data?.ok || !res.data?.token) {
        return {
          ok: false,
          error: res.data?.error || 'Código inválido o vencido. Verificá los 6 números.',
        };
      }
      const access = normalizeAccess(res.data.access);
      const next = writeState({
        token: res.data.token,
        email: res.data.user?.email || cleanEmail,
        country: res.data.user?.country || '',
        access,
        lastCheckedAt: Date.now(),
      });
      refreshUi();
      return {
        ok: true,
        user: res.data.user || { email: next.email, country: next.country },
        token: next.token,
        trialGranted: Boolean(res.data.trialGranted),
        access,
        deviceLimitReached: Boolean(res.data.deviceLimitReached),
      };
    } catch {
      return { ok: false, offline: true, error: 'Sin conexión para verificar el código.' };
    }
  }

  async function refresh({ force = false, notify: showToast = false } = {}) {
    const state = readState();
    if (!state.token) {
      refreshUi();
      return { ok: false, authenticated: false, access: null };
    }
    if (!force && Date.now() - (state.lastCheckedAt || 0) < REFRESH_TTL_MS && hasAccess()) {
      return { ok: true, authenticated: true, access: state.access, cached: true };
    }
    if (refreshPromise) return refreshPromise;

    refreshPromise = (async () => {
      try {
        const res = await requestJson('/api/auth/me', { token: state.token });
        if (res.status === 200) {
          if (res.data?.authenticated === false) {
            clearState();
            refreshUi();
            if (showToast) notify('Tu sesión expiró. Volvé a ingresar con tu correo.');
            return { ok: true, authenticated: false, access: null };
          }
          const access = normalizeAccess(res.data?.access);
          const next = writeState({
            token: state.token,
            email: res.data?.user?.email || state.email,
            country: res.data?.user?.country || state.country,
            access,
            lastCheckedAt: Date.now(),
          });
          refreshUi();
          if (showToast) {
            notify(
              hasAccess()
                ? `Cuenta activa · ${daysRemaining()} día(s) restantes`
                : 'Tu prueba o pase finalizó. Podés activarlo desde la web.',
            );
          }
          return { ok: true, authenticated: true, access: next.access };
        }
        if (res.status === 401 || res.status === 403) {
          clearState();
          refreshUi();
          if (showToast) notify('Sesión inválida. Volvé a iniciar sesión.');
          return { ok: false, authenticated: false, access: null };
        }
        // Respuesta 5xx: conserva el estado en caché (tolerancia sin conexión / fallas transitorias).
        refreshUi();
        if (showToast) notify('El servidor no respondió. Se conserva tu estado actual.');
        return { ok: false, offline: true, authenticated: true, access: state.access };
      } catch {
        refreshUi();
        if (showToast) notify('Sin conexión para comprobar tu cuenta.');
        return { ok: false, offline: true, authenticated: true, access: state.access };
      } finally {
        refreshPromise = null;
      }
    })();

    return refreshPromise;
  }

  async function logout() {
    const state = readState();
    if (state.token) {
      await requestJson('/api/auth/logout', { method: 'POST', token: state.token }).catch(() => {});
    }
    clearState();
    refreshUi();
    return true;
  }

  function formatExpiry(expiresAt) {
    if (!expiresAt) return '';
    try {
      return new Date(expiresAt).toLocaleDateString('es-AR', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
      });
    } catch {
      return '';
    }
  }

  function refreshUi() {
    if (typeof document === 'undefined') return;
    const card = document.getElementById?.('accountSettingsCard');
    if (!card) return;

    const state = readState();
    const titleEl = document.getElementById('accStatusTitle');
    const detailEl = document.getElementById('accStatusDetail');
    const badgeEl = document.getElementById('accStatusBadge');
    const primaryBtn = document.getElementById('accPrimaryBtn');
    const portalBtn = document.getElementById('accPortalBtn');
    const refreshBtn = document.getElementById('accRefreshBtn');
    const logoutBtn = document.getElementById('accLogoutBtn');

    const toggleHidden = (el, hide) => {
      if (!el) return;
      el.hidden = hide;
      el.classList?.toggle?.('hidden', hide);
    };

    if (!state.token) {
      if (titleEl) titleEl.textContent = '3 días gratis con tu correo';
      if (detailEl) detailEl.textContent = 'Sin tarjeta ni cobros automáticos. Iniciá sesión con un código de 6 dígitos para reproducir.';
      if (badgeEl) {
        badgeEl.textContent = 'Sin conectar';
        badgeEl.className = 'chip account-badge';
      }
      if (primaryBtn) primaryBtn.textContent = 'Iniciar sesión / 3 días gratis';
      toggleHidden(portalBtn, false);
      if (portalBtn) portalBtn.textContent = 'Ver planes';
      toggleHidden(refreshBtn, true);
      toggleHidden(logoutBtn, true);
      return;
    }

    const active = hasAccess();
    const remaining = daysRemaining();
    const isTrial = state.access?.planId === 'trial' || state.access?.state === 'trial';
    const expiryText = formatExpiry(state.access?.expiresAt);

    if (titleEl) titleEl.textContent = state.email || 'Cuenta conectada';
    if (active) {
      const kindLabel = isTrial ? 'Prueba gratuita activa' : 'Pase activo';
      if (detailEl) {
        detailEl.textContent = `${kindLabel} · ${remaining} día(s) restantes${expiryText ? ` (vence el ${expiryText})` : ''}.`;
      }
      if (badgeEl) {
        badgeEl.textContent = `${remaining} día(s)`;
        badgeEl.className = 'chip account-badge ok';
      }
      if (primaryBtn) primaryBtn.textContent = isTrial ? 'Comprar pase único' : 'Extender pase';
      toggleHidden(portalBtn, true);
    } else {
      if (detailEl) {
        detailEl.textContent = isTrial
          ? 'Tu prueba gratuita finalizó. Elegí un pase de 30, 90 o 365 días en la web (sin débito automático).'
          : 'Tu pase finalizó. Elegí un nuevo pase en la web y tocá Actualizar estado.';
      }
      if (badgeEl) {
        badgeEl.textContent = 'Vencido';
        badgeEl.className = 'chip account-badge warn';
      }
      if (primaryBtn) primaryBtn.textContent = 'Activar pase';
      toggleHidden(portalBtn, false);
      if (portalBtn) portalBtn.textContent = 'Ver planes';
    }
    toggleHidden(refreshBtn, false);
    toggleHidden(logoutBtn, false);
  }

  function html() {
    return `<section class="set-card set-card-account" id="accountSettingsCard">
      <h2><svg class="set-head-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>Cuenta Nébula</h2>
      <div class="account-summary">
        <span class="account-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg></span>
        <div class="account-copy">
          <div class="account-title-row"><h3 id="accStatusTitle">3 días gratis con tu correo</h3><span class="chip account-badge" id="accStatusBadge">Sin conectar</span></div>
          <p id="accStatusDetail">Sin tarjeta ni cobros automáticos. Iniciá sesión con un código de 6 dígitos para reproducir.</p>
        </div>
      </div>
      <div class="m-actions set-actions-start">
        <button type="button" class="btn primary" id="accPrimaryBtn">Iniciar sesión / 3 días gratis</button>
        <button type="button" class="btn" id="accPortalBtn">Ver planes</button>
        <button type="button" class="btn hidden" id="accRefreshBtn">Actualizar estado</button>
        <button type="button" class="btn" id="accTvBtn">Vincular TV</button>
        <button type="button" class="btn danger-ghost hidden" id="accLogoutBtn">Cerrar sesión</button>
      </div>
    </section>`;
  }

  function bind() {
    if (typeof document === 'undefined') return;
    refreshUi();
    const primaryBtn = document.getElementById('accPrimaryBtn');
    const portalBtn = document.getElementById('accPortalBtn');
    const refreshBtn = document.getElementById('accRefreshBtn');
    const tvBtn = document.getElementById('accTvBtn');
    const logoutBtn = document.getElementById('accLogoutBtn');

    if (primaryBtn) {
      primaryBtn.onclick = () => {
        const state = readState();
        if (!state.token) openAccountModal({ reason: 'settings' });
        else if (hasAccess()) openExternalUrl(plansUrl());
        else openAccountModal({ reason: 'settings' });
      };
    }
    if (portalBtn) portalBtn.onclick = () => openExternalUrl(plansUrl());
    if (tvBtn) tvBtn.onclick = () => openExternalUrl(tvUrl());
    if (refreshBtn) {
      refreshBtn.onclick = async () => {
        if (refreshBtn.disabled) return;
        refreshBtn.disabled = true;
        refreshBtn.textContent = 'Consultando…';
        try {
          await refresh({ force: true, notify: true });
        } finally {
          if (refreshBtn.isConnected) {
            refreshBtn.disabled = false;
            refreshBtn.textContent = 'Actualizar estado';
          }
        }
      };
    }
    if (logoutBtn) {
      logoutBtn.onclick = async () => {
        await logout();
        notify('Sesión cerrada');
      };
    }
  }

  function openAccountModal({ reason = 'playback' } = {}) {
    if (typeof App === 'undefined' || typeof App.showModal !== 'function' || typeof document === 'undefined') {
      return Promise.resolve(hasAccess());
    }

    return new Promise((resolve) => {
      let settled = false;
      let unlocked = hasAccess();
      let step = readState().token ? 'expired' : 'email';
      let pendingEmail = readState().email || '';

      const finish = () => {
        if (settled) return;
        settled = true;
        resolve(unlocked || hasAccess());
      };

      const renderModalBody = () => {
        const host = document.getElementById('accModalBody');
        if (!host) return;
        const state = readState();

        if (step === 'email') {
          host.innerHTML = `
            <h2>Probá Nébula 3 días gratis</h2>
            <p class="account-modal-copy">${
              reason === 'playback'
                ? 'Conectá tu correo para empezar a reproducir. Tenés 3 días gratis sin tarjeta y sin cobros automáticos.'
                : 'Ingresá tu correo y te enviamos un código de 6 dígitos. Sin tarjeta y sin cobros automáticos.'
            }</p>
            <div class="account-field">
              <label for="accEmail">Correo electrónico</label>
              <input type="email" id="accEmail" class="account-input" autocomplete="email" placeholder="tu@correo.com" value="${escapeHtml(pendingEmail)}" />
            </div>
            <p class="account-status-msg hidden" id="accMsg" role="status" aria-live="polite"></p>
            <div class="m-actions">
              <button type="button" class="btn" id="accCancel">Ahora no</button>
              <button type="button" class="btn primary" id="accSendOtp">Enviar código</button>
            </div>`;
          const emailInput = document.getElementById('accEmail');
          const msgEl = document.getElementById('accMsg');
          const sendBtn = document.getElementById('accSendOtp');
          document.getElementById('accCancel').onclick = () => App.closeModal();

          const showError = (msg) => {
            if (!msgEl) return;
            msgEl.textContent = msg;
            msgEl.classList.remove('hidden');
          };

          const submitEmail = async () => {
            const emailVal = String(emailInput?.value || '').trim();
            if (!emailVal) {
              showError('Ingresá tu correo para enviarte el código.');
              emailInput?.focus();
              return;
            }
            sendBtn.disabled = true;
            sendBtn.textContent = 'Enviando…';
            msgEl?.classList.add('hidden');
            const res = await requestOtp(emailVal);
            if (!document.getElementById('accModalBody')) return;
            sendBtn.disabled = false;
            sendBtn.textContent = 'Enviar código';
            if (!res.ok) {
              showError(res.error);
              return;
            }
            pendingEmail = res.email;
            step = 'code';
            renderModalBody();
          };

          sendBtn.onclick = submitEmail;
          emailInput?.addEventListener('keydown', (event) => {
            if (event.key === 'Enter') {
              event.preventDefault();
              submitEmail();
            }
          });
          emailInput?.focus();
          return;
        }

        if (step === 'code') {
          host.innerHTML = `
            <h2>Ingresá el código de 6 dígitos</h2>
            <p class="account-modal-copy">Te enviamos un código a <strong>${escapeHtml(pendingEmail)}</strong>. Revisá también correo no deseado.</p>
            <div class="account-field">
              <label for="accCode">Código de verificación</label>
              <input type="text" id="accCode" class="account-input account-otp-input" inputmode="numeric" maxlength="6" autocomplete="one-time-code" placeholder="000000" />
            </div>
            <div class="account-secondary-row">
              <button type="button" class="btn" id="accBackEmail">Cambiar correo</button>
            </div>
            <p class="account-status-msg hidden" id="accMsg" role="status" aria-live="polite"></p>
            <div class="m-actions">
              <button type="button" class="btn" id="accCancel">Cancelar</button>
              <button type="button" class="btn primary" id="accVerifyOtp">Activar 3 días gratis</button>
            </div>`;
          const codeInput = document.getElementById('accCode');
          const msgEl = document.getElementById('accMsg');
          const verifyBtn = document.getElementById('accVerifyOtp');
          document.getElementById('accCancel').onclick = () => App.closeModal();
          document.getElementById('accBackEmail').onclick = () => {
            step = 'email';
            renderModalBody();
          };

          const showError = (msg) => {
            if (!msgEl) return;
            msgEl.textContent = msg;
            msgEl.classList.remove('hidden');
          };

          const submitCode = async () => {
            const rawCode = String(codeInput?.value || '').trim();
            verifyBtn.disabled = true;
            verifyBtn.textContent = 'Verificando…';
            msgEl?.classList.add('hidden');
            const res = await verifyOtp(pendingEmail, rawCode);
            if (!document.getElementById('accModalBody')) return;
            verifyBtn.disabled = false;
            verifyBtn.textContent = 'Activar 3 días gratis';
            if (!res.ok) {
              showError(res.error);
              return;
            }
            if (res.access?.hasAccess) {
              unlocked = true;
              notify(res.trialGranted ? '¡3 días gratis activados!' : 'Sesión iniciada');
              App.closeModal();
              return;
            }
            step = 'expired';
            renderModalBody();
          };

          verifyBtn.onclick = submitCode;
          codeInput?.addEventListener('keydown', (event) => {
            if (event.key === 'Enter') {
              event.preventDefault();
              submitCode();
            }
          });
          codeInput?.focus();
          return;
        }

        const isTrial = state.access?.planId === 'trial' || state.access?.state === 'trial' || state.access?.trialUsed;
        host.innerHTML = `
          <h2>${isTrial ? 'Tu prueba gratuita finalizó' : 'Tu pase de Nébula finalizó'}</h2>
          <p class="account-modal-copy">Cuenta: <strong>${escapeHtml(state.email || pendingEmail)}</strong>.<br>Activá un pase de 30, 90 o 365 días en la web (pago único, sin débito automático) y luego tocá Verificar.</p>
          <div class="account-secondary-row">
            <button type="button" class="btn" id="accCheckAgain">Ya pagué · Verificar ahora</button>
            <button type="button" class="btn" id="accSwitchAccount">Cambiar cuenta</button>
          </div>
          <p class="account-status-msg hidden" id="accMsg" role="status" aria-live="polite"></p>
          <div class="m-actions">
            <button type="button" class="btn" id="accCancel">Ahora no</button>
            <button type="button" class="btn primary" id="accOpenPlans">Elegir pase en la web</button>
          </div>`;

        const msgEl = document.getElementById('accMsg');
        const checkBtn = document.getElementById('accCheckAgain');
        const switchBtn = document.getElementById('accSwitchAccount');
        const openBtn = document.getElementById('accOpenPlans');
        document.getElementById('accCancel').onclick = () => App.closeModal();

        openBtn.onclick = () => openExternalUrl(plansUrl());
        checkBtn.onclick = async () => {
          checkBtn.disabled = true;
          checkBtn.textContent = 'Verificando…';
          msgEl?.classList.add('hidden');
          const res = await refresh({ force: true });
          if (!document.getElementById('accModalBody')) return;
          checkBtn.disabled = false;
          checkBtn.textContent = 'Ya pagué · Verificar ahora';
          if (hasAccess()) {
            unlocked = true;
            notify('¡Pase de Nébula activado!');
            App.closeModal();
            return;
          }
          if (msgEl) {
            msgEl.textContent = res.offline
              ? 'No pudimos conectar con el servidor. Revisá tu conexión y reintentá.'
              : 'Todavía no vemos un pase activo en esta cuenta. Si ya pagaste, esperá unos segundos y volvé a tocar Verificar.';
            msgEl.classList.remove('hidden');
          }
        };
        switchBtn.onclick = async () => {
          await logout();
          pendingEmail = '';
          step = 'email';
          renderModalBody();
        };
        openBtn.focus();
      };

      App.showModal('<div id="accModalBody" class="account-modal-body"></div>', renderModalBody, finish);
    });
  }

  async function ensureAccess() {
    if (hasAccess()) return true;
    const state = readState();
    if (state.token) {
      await refresh({ force: true });
      if (hasAccess()) {
        notify('¡Acceso de Nébula activado!');
        return true;
      }
    }
    return openAccountModal({ reason: 'playback' });
  }

  function start() {
    if (started) return;
    started = true;
    if (typeof Platform !== 'undefined' && typeof Platform.runtimeInfo === 'function') {
      Platform.runtimeInfo().then((info) => {
        if (info?.version) cachedAppVersion = String(info.version);
      }).catch(() => {});
    }
    if (typeof setTimeout === 'function' && readState().token) {
      setTimeout(() => refresh().catch(() => {}), 2000);
    }
    if (typeof setInterval === 'function') {
      setInterval(() => {
        if (!document?.hidden && readState().token && Date.now() - (readState().lastCheckedAt || 0) > PERIODIC_REFRESH_MS) {
          refresh().catch(() => {});
        }
      }, PERIODIC_REFRESH_MS);
    }
    if (typeof document !== 'undefined' && typeof document.addEventListener === 'function') {
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden && readState().token) refresh().catch(() => {});
      });
    }
  }

  return {
    apiBase,
    plansUrl,
    tvUrl,
    getState,
    hasAccess,
    daysRemaining,
    requestOtp,
    verifyOtp,
    refresh,
    logout,
    ensureAccess,
    openAccountModal,
    html,
    bind,
    refreshUi,
    start,
  };
})();

if (typeof module === 'object' && module.exports) {
  module.exports = NebulaAccount;
}
